@page "/admin/p/{projectKey}/group-roles"
@model SystemX.Auth2.Server.Pages.Admin.Assignments.GroupRolesModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = $"Group Roles - {Model.CurrentProject?.Name}";
}

<div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <div class="flex items-center gap-2">
                <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Group Roles</h1>
                <span class="text-xs bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 px-2 py-0.5 rounded font-mono">group_roles</span>
            </div>
            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
                CRUD management for roles assigned to groups in @Model.CurrentProject?.Name.
            </p>
        </div>
        <div class="flex items-center gap-2">
            <a href="/admin/p/@Model.ProjectKey/assignments?tab=group_roles" class="text-xs text-blue-600 dark:text-blue-400 hover:underline">
                View in Matrix &rarr;
            </a>
        </div>
    </div>

    <!-- Assign Role to Group Form Card -->
    <a2-card title="Assign Role to Group">
        <form method="post" asp-page-handler="Add" class="space-y-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Group</label>
                    <select name="groupName" required class="block w-full rounded-[var(--a2-radius,0.375rem)] border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-sm text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-1 focus:ring-blue-500">
                        <option value="">-- Select Group --</option>
                        @foreach (var g in Model.AvailableGroups)
                        {
                            <option value="@g.Name">@g.Name @(string.IsNullOrWhiteSpace(g.DisplayName) ? "" : $"({g.DisplayName})")</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Role</label>
                    <div class="space-y-2">
                        <select name="roleName" class="block w-full rounded-[var(--a2-radius,0.375rem)] border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-sm text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-1 focus:ring-blue-500">
                            <option value="">-- Select from existing roles --</option>
                            @foreach (var r in Model.AvailableRoles)
                            {
                                <option value="@r.Name">@r.Name @(r.ProjectId == null ? "(Global)" : "")</option>
                            }
                        </select>
                        <input type="text" name="roleNameManual" placeholder="Or type role name manually..." class="block w-full rounded-[var(--a2-radius,0.375rem)] border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-xs text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-1 focus:ring-blue-500" />
                    </div>
                </div>
            </div>
            <div class="flex justify-end pt-2">
                <a2-button type="submit" variant="primary">Assign Role to Group</a2-button>
            </div>
        </form>
    </a2-card>

    <!-- Filter & Search -->
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4">
        <form method="get" class="flex flex-wrap items-center gap-2">
            <select name="groupName" class="rounded-[var(--a2-radius,0.375rem)] border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-xs text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-1 focus:ring-blue-500">
                <option value="">All Groups</option>
                @foreach (var g in Model.AvailableGroups)
                {
                    <option value="@g.Name" selected="@(Model.GroupName == g.Name ? "selected" : null)">@g.Name</option>
                }
            </select>
            <select name="role" class="rounded-[var(--a2-radius,0.375rem)] border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-xs text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-1 focus:ring-blue-500">
                <option value="">All Roles</option>
                @foreach (var r in Model.AvailableRoles)
                {
                    <option value="@r.Name" selected="@(Model.Role == r.Name ? "selected" : null)">@r.Name</option>
                }
            </select>
            <input type="text" name="q" value="@Model.Q" placeholder="Search..." class="rounded-[var(--a2-radius,0.375rem)] border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-xs text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-1 focus:ring-blue-500" />
            <a2-button type="submit" variant="secondary">Filter</a2-button>
            @if (!string.IsNullOrEmpty(Model.Q) || !string.IsNullOrEmpty(Model.GroupName) || !string.IsNullOrEmpty(Model.Role))
            {
                <a href="/admin/p/@Model.ProjectKey/group-roles" class="text-xs text-gray-500 dark:text-gray-400 hover:underline">Clear</a>
            }
        </form>
        <span class="text-xs text-gray-500 dark:text-gray-400">Total: <strong>@Model.TotalCount</strong> assignments</span>
    </div>

    <!-- Table -->
    <div class="overflow-x-auto rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 shadow-sm">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700 text-sm">
            <thead class="bg-gray-50 dark:bg-gray-900/60">
                <tr>
                    <th class="px-6 py-3 text-left font-semibold text-gray-700 dark:text-gray-300">Group Name</th>
                    <th class="px-6 py-3 text-left font-semibold text-gray-700 dark:text-gray-300">Assigned Role</th>
                    <th class="px-6 py-3 text-right font-semibold text-gray-700 dark:text-gray-300">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="3" class="px-6 py-8 text-center text-gray-500 dark:text-gray-400">
                            No group roles found. Use the form above to assign roles to groups.
                        </td>
                    </tr>
                }
                @foreach (var item in Model.Items)
                {
                    <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                        <td class="px-6 py-3.5 font-medium text-gray-900 dark:text-gray-100">
                            <a href="/admin/p/@Model.ProjectKey/groups/detail?name=@item.GroupName" class="text-blue-600 dark:text-blue-400 hover:underline">
                                @item.GroupName @(string.IsNullOrWhiteSpace(item.GroupDisplayName) ? "" : $"({item.GroupDisplayName})")
                            </a>
                        </td>
                        <td class="px-6 py-3.5 font-medium text-gray-800 dark:text-gray-200">
                            <a href="/admin/p/@Model.ProjectKey/roles/detail?name=@item.RoleName" class="text-blue-600 dark:text-blue-400 hover:underline">
                                @item.RoleName
                            </a>
                        </td>
                        <td class="px-6 py-3.5 text-right">
                            <form method="post" asp-page-handler="Remove" asp-route-groupName="@item.GroupName" asp-route-roleName="@item.RoleName" data-confirm="Remove role '@item.RoleName' from group '@item.GroupName'?" class="inline">
                                <button type="submit" class="text-xs text-red-600 dark:text-red-400 hover:underline font-medium">Remove</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalCount > 0)
    {
        <a2-pager page="@Model.PageNumber" page-size="@Model.PageSize" total-count="@Model.TotalCount" total-pages="@Model.TotalPages"></a2-pager>
    }
</div>
