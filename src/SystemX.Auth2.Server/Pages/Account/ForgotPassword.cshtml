@page
@model SystemX.Auth2.Server.Pages.Account.ForgotPasswordModel
@{
    Layout = "_LayoutAuth";
    ViewData["Title"] = Loc["forgot_password.title"];
    ViewData["Subtitle"] = Loc["forgot_password.subtitle"];
}

@if (Model.Submitted)
{
    <a2-alert variant="success">@Loc["forgot_password.sent_desc"]</a2-alert>
    <div class="mt-4 text-center">
        <a2-link-button href="/Account/Login?ReturnUrl=@Model.ReturnUrl&ClientId=@Model.ClientId" variant="secondary">@Loc["common.back_to_login"]</a2-link-button>
    </div>
}
else
{
    <form method="post" class="space-y-4">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ReturnUrl" />
        <input type="hidden" asp-for="ClientId" />

        <a2-field label="@Loc["forgot_password.login_field"]" hint="@Loc["forgot_password.subtitle"]" required="true" for="Input_Login">
            <a2-input id="Input_Login" name="Input.Login" value="@Model.Input?.Login" placeholder="you@example.com" autocomplete="username" required="true" />
        </a2-field>

        <div>
            <a2-button type="submit" variant="primary" class="w-full">@Loc["forgot_password.send_link"]</a2-button>
        </div>

        <div class="mt-4 text-center text-sm">
            <a href="/Account/Login?ReturnUrl=@Model.ReturnUrl&ClientId=@Model.ClientId" class="font-medium text-[var(--a2-color-primary,#2563eb)] hover:underline">@Loc["common.back_to_login"]</a>
        </div>
    </form>
}
