@page
@model SystemX.Auth2.Server.Pages.Account.ResetPasswordModel
@{
    var rules = SystemX.Auth2.Server.Pages.Account.AccountFormRules.For(Model);
    var newRule = rules.NewPassword(Loc["reset_password.new_password"].Value);
}
@{
    Layout = "_LayoutAuth";
    ViewData["Title"] = Loc["reset_password.title"];
    ViewData["Subtitle"] = Loc["reset_password.subtitle"];
}

<form method="post" class="space-y-4" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ReturnUrl" />
    <input type="hidden" asp-for="ClientId" />
    <input type="hidden" asp-for="Login" />
    <input type="hidden" asp-for="Token" />

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <a2-alert variant="danger">
            @Model.ErrorMessage
        </a2-alert>
    }

    <a2-field label="@Loc["reset_password.new_password"]" required="true" for="Input_NewPassword">
        <a2-password id="Input_NewPassword" name="Input.NewPassword" placeholder="••••••••••••" required="true" autocomplete="new-password" data-a2-rule="@newRule" />
    </a2-field>

    <div>
        <a2-button type="submit" variant="primary" class="w-full">@Loc["reset_password.update_button"]</a2-button>
    </div>

    <div class="mt-4 text-center text-sm">
        <a href="@Model.GetLoginUrl()" class="font-medium text-[var(--a2-color-primary,#2563eb)] hover:underline">@Loc["common.back_to_login"]</a>
    </div>
</form>
