@page
@model SystemX.Auth2.Server.Pages.Account.JoinProjectModel
@{
    Layout = "_LayoutAuth";
    ViewData["Title"] = "Join Project";
}

<div class="space-y-6">
    <div class="text-center">
        <h2 class="text-xl font-bold text-[var(--a2-color-text,#111827)]">
            Join @(Model.BrandName ?? "Project")
        </h2>
        <p class="mt-1 text-sm text-[var(--a2-color-muted,#6b7280)]">
            Connect your existing account to access this project.
        </p>
    </div>

    @if (!Model.JoinEnabled)
    {
        <a2-alert variant="warning">
            Auto-join is not enabled for this project. Please contact an administrator for an invitation.
        </a2-alert>
        <div class="pt-2 text-center">
            <a href="/" class="text-sm text-[var(--a2-color-primary,#2563eb)] hover:underline">
                Return to Home
            </a>
        </div>
    }
    else if (Model.CodeSent)
    {
        <form method="post" class="space-y-4">
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
            <input type="hidden" name="Input.Login" value="@Model.Input.Login" />

            <a2-alert variant="info">
                A verification code was sent to your email or phone.
            </a2-alert>

            <a2-field label="Verification Code" required="true">
                <a2-input name="Input.Code" type="text" value="@Model.Input.Code" required="true" placeholder="123456" autocomplete="one-time-code" />
            </a2-field>

            @if (Model.AskNewPassword)
            {
                <a2-field label="New Password for this Project" required="true" hint="Create a password for this project.">
                    <a2-password name="Input.NewPassword" required="true" autocomplete="new-password" />
                </a2-field>
            }

            <a2-button type="submit" variant="primary" class="w-full">
                Join Project
            </a2-button>
        </form>
    }
    else
    {
        <form method="post" asp-page-handler="Send" class="space-y-4">
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />

            <a2-field label="Email or Username" required="true">
                <a2-input name="Input.Login" value="@Model.Input.Login" required="true" placeholder="you@example.com" autocomplete="username" />
            </a2-field>

            <a2-button type="submit" variant="primary" class="w-full">
                Send Verification Code
            </a2-button>

            <div class="text-center pt-2">
                <a href="@Url.Page("Login", new { ReturnUrl = Model.ReturnUrl, ClientId = Model.ClientIdForLinks })" class="text-sm text-[var(--a2-color-primary,#2563eb)] hover:underline">
                    Back to Sign In
                </a>
            </div>
        </form>
    }
</div>
