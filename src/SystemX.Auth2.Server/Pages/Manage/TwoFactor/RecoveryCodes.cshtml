@page
@model SystemX.Auth2.Server.Pages.Manage.TwoFactor.RecoveryCodesModel
@{
    Layout = "_LayoutManage";
    ViewData["Title"] = "Recovery Codes";
}

<div class="space-y-6 max-w-xl">
    <div>
        <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100">Two-Factor Recovery Codes</h2>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Regenerate recovery codes if you have used existing ones or suspect they have been compromised.</p>
    </div>

    @if (Model.Codes.Count > 0)
    {
        <a2-alert variant="warning">
            Save these new recovery codes immediately. Your previous codes are no longer valid.
        </a2-alert>

        <a2-card title="New Recovery Codes" subtitle="Store these backup codes safely.">
            <div class="grid grid-cols-2 gap-2 bg-gray-50 dark:bg-gray-900/40 p-4 rounded-[var(--a2-radius,0.375rem)] border border-gray-200 dark:border-gray-700 font-mono text-sm text-gray-800 dark:text-gray-200 mb-4">
                @foreach (var code in Model.Codes)
                {
                    <div class="p-1.5 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded text-center select-all">@code</div>
                }
            </div>

            @{
                var recoveryCodesDownload = $"SystemX Auth2 - Two-Factor Recovery Codes\r\n" +
                    $"Account: {User.Identity?.Name ?? "User"}\r\n" +
                    $"Generated: {DateTime.UtcNow:yyyy-MM-dd HH:mm:ss} UTC\r\n\r\n" +
                    $"Keep these one-time backup recovery codes safe. Each code can only be used once:\r\n\r\n" +
                    string.Join("\r\n", Model.Codes) + "\r\n";
            }
            <div class="flex flex-wrap items-center justify-between gap-3 pt-2">
                <div class="flex items-center space-x-2">
                    <a2-copy-button value="@string.Join(" ", Model.Codes)" label="Copy All Codes" variant="secondary" />
                    <a2-download-button value="@recoveryCodesDownload" filename="auth2-recovery-codes.txt" label="Download Codes" variant="secondary" />
                </div>
                <a2-link-button href="/Manage" variant="primary">
                    Return to Account Overview
                </a2-link-button>
            </div>
        </a2-card>
    }
    else
    {
        <a2-card title="Regenerate Recovery Codes" subtitle="Generate a fresh set of one-time backup recovery codes.">
            <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
                Regenerating recovery codes will invalidate all your old recovery codes.
                Enter a code from your authenticator app to confirm:
            </p>

            <form method="post" class="space-y-4">
                <a2-field label="Authenticator Code" required="true">
                    <a2-input name="Input.Code" value="@Model.Input.Code" required="true" placeholder="123456" inputmode="numeric" pattern="[0-9 ]*" maxlength="10" data-a2-digits="true" autocomplete="one-time-code" />
                </a2-field>

                <div class="pt-2 flex justify-end">
                    <a2-button type="submit" variant="danger">
                        Generate New Codes
                    </a2-button>
                </div>
            </form>
        </a2-card>
    }
</div>
