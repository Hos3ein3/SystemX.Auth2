@page
@model SystemX.Auth2.Server.Pages.Manage.TwoFactor.EnableModel
@{
    Layout = "_LayoutAccount";
    ViewData["Title"] = "Two-Factor Authentication";
}

<div class="space-y-6 max-w-xl">
    <div>
        <h2 class="text-xl font-bold text-gray-900">Two-Factor Authentication (2FA)</h2>
        <p class="mt-1 text-sm text-gray-500">Protect your account with an authenticator app (Google Authenticator, Microsoft Authenticator, etc.).</p>
    </div>

    @if (Model.Enabled)
    {
        <a2-alert variant="success">
            Two-factor authentication has been enabled for your account!
        </a2-alert>

        <a2-card title="Save Your Recovery Codes">
            <p class="text-sm text-gray-600 mb-4">
                These recovery codes can be used to access your account if you lose your authenticator device.
                <strong>Store them in a secure place. They will not be displayed again.</strong>
            </p>

            <div class="grid grid-cols-2 gap-2 bg-gray-50 p-4 rounded border font-mono text-sm text-gray-800">
                @foreach (var code in Model.RecoveryCodes)
                {
                    <div class="p-1 bg-white border border-gray-200 rounded text-center">@code</div>
                }
            </div>

            <div class="mt-4">
                <a2-link-button href="/Manage/Index" variant="primary">
                    Return to Account Overview
                </a2-link-button>
            </div>
        </a2-card>
    }
    else if (Model.AlreadyEnabled)
    {
        <a2-card title="Two-Factor Authentication is Enabled">
            <div class="flex items-center space-x-2 text-green-700 mb-4">
                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
                <span class="text-sm font-medium">Your account is currently protected by two-factor authentication.</span>
            </div>

            <div class="space-y-4 pt-2">
                <a href="/Manage/TwoFactor/RecoveryCodes" class="inline-flex text-sm text-blue-600 hover:underline">
                    Generate new recovery codes
                </a>

                @if (Model.CanDisable)
                {
                    <div class="border-t border-gray-200 pt-4">
                        <h4 class="text-sm font-semibold text-red-700 mb-2">Disable Two-Factor Authentication</h4>
                        <p class="text-xs text-gray-500 mb-3">Disabling 2FA makes your account less secure. You must enter your password to confirm.</p>
                        <form method="post" asp-page-handler="Disable" class="space-y-3">
                            <a2-field label="Current password" required="true">
                                <a2-password name="Input.Password" required="true" autocomplete="current-password" />
                            </a2-field>
                            <a2-button type="submit" variant="danger">
                                Disable 2FA
                            </a2-button>
                        </form>
                    </div>
                }
            </div>
        </a2-card>
    }
    else
    {
        <a2-card title="Step 1: Configure Authenticator App">
            <p class="text-sm text-gray-600 mb-3">
                To enable two-factor authentication, add your account key into your authenticator app:
            </p>

            <div class="mb-4 bg-gray-50 p-4 rounded border text-center">
                <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider block mb-1">Manual Setup Key</span>
                <code class="font-mono text-base font-bold text-gray-900 tracking-widest select-all">@Model.SharedKey</code>
            </div>

            <form method="post" class="space-y-4 border-t border-gray-200 pt-4">
                <h4 class="text-sm font-semibold text-gray-800">Step 2: Verify Setup</h4>
                <p class="text-xs text-gray-500">
                    Enter the 6-digit code shown in your authenticator app to confirm setup:
                </p>

                <a2-field label="Verification Code" required="true">
                    <a2-input name="Input.Code" type="text" value="@Model.Input.Code" required="true" placeholder="123456" autocomplete="one-time-code" />
                </a2-field>

                <a2-button type="submit" variant="primary">
                    Verify and Enable 2FA
                </a2-button>
            </form>
        </a2-card>
    }
</div>
