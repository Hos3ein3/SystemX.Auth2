@model IReadOnlyList<ClientHealthInfo>
@{
    var state = ClientHealthSummary.Of(Model);
}
@if (state is { } worst)
{
    <span title="@ClientHealthSummary.Details(Model)" class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @(worst switch { ClientHealthState.Healthy => "bg-green-100 text-green-800 dark:bg-green-900/40 dark:text-green-300", ClientHealthState.Degraded => "bg-yellow-100 text-yellow-800 dark:bg-yellow-900/40 dark:text-yellow-300", ClientHealthState.Unknown => "bg-gray-100 text-gray-700 dark:bg-gray-700 dark:text-gray-300", _ => "bg-red-100 text-red-800 dark:bg-red-900/40 dark:text-red-300" })">@ClientHealthSummary.Text(Model)</span>
}
else
{
    <span title="No application of this project uses the two-way health check" class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-500 dark:bg-gray-700 dark:text-gray-400">No health check</span>
}
