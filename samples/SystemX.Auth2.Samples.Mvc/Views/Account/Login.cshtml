@model SystemX.Auth2.Samples.Mvc.Models.LoginViewModel
@{ ViewData["Title"] = "Sign in"; }

<div class="max-w-md mx-auto bg-white rounded-xl shadow p-8">
    <h1 class="text-2xl font-bold mb-6">Sign in</h1>
    <form asp-action="Login" method="post" class="space-y-4">
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="text-sm text-red-600"></div>
        <div>
            <label asp-for="Login" class="block text-sm font-medium mb-1"></label>
            <input asp-for="Login" autocomplete="username" class="w-full border border-gray-300 rounded-md px-3 py-2" />
            <span asp-validation-for="Login" class="text-sm text-red-600"></span>
        </div>
        <div>
            <label asp-for="Password" class="block text-sm font-medium mb-1"></label>
            <input asp-for="Password" autocomplete="current-password" class="w-full border border-gray-300 rounded-md px-3 py-2" />
            <span asp-validation-for="Password" class="text-sm text-red-600"></span>
        </div>
        <label class="flex items-center gap-2 text-sm"><input asp-for="RememberMe" type="checkbox" /> @Html.DisplayNameFor(m => m.RememberMe)</label>
        <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-md px-4 py-2">Sign in</button>
    </form>
</div>
