@page
@model SystemX.Auth2.Server.Pages.Manage.ExternalLoginsModel
@{
    Layout = "_LayoutAccount";
    ViewData["Title"] = "External Logins";
}

<div class="space-y-6 max-w-2xl">
    <div>
        <h2 class="text-xl font-bold text-gray-900">External Logins</h2>
        <p class="mt-1 text-sm text-gray-500">Manage external identity providers linked to your account.</p>
    </div>

    @if (Model.Links.Count > 0)
    {
        <a2-card title="Connected Accounts">
            <ul class="divide-y divide-gray-200">
                @foreach (var link in Model.Links)
                {
                    <li class="py-3 flex items-center justify-between">
                        <div>
                            <span class="text-sm font-semibold text-gray-800">@link.Provider</span>
                            <span class="text-xs text-gray-500 block">Identifier: @link.ProviderKey</span>
                        </div>
                        <form method="post" asp-page-handler="Unlink">
                            <input type="hidden" name="Provider" value="@link.Provider" />
                            <input type="hidden" name="ProviderKey" value="@link.ProviderKey" />
                            <button type="submit" class="text-xs text-red-600 hover:text-red-800 font-medium">
                                Disconnect
                            </button>
                        </form>
                    </li>
                }
            </ul>
        </a2-card>
    }

    @if (Model.AvailableProviders.Count > 0)
    {
        <a2-card title="Link Another Account">
            <p class="text-sm text-gray-600 mb-4">Connect additional identity providers to sign in with one click:</p>
            <div class="flex flex-wrap gap-3">
                @foreach (var provider in Model.AvailableProviders)
                {
                    <form method="post" asp-page-handler="Link">
                        <input type="hidden" name="Provider" value="@provider.Name" />
                        <button type="submit" class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                            Connect @provider.DisplayName
                        </button>
                    </form>
                }
            </div>
        </a2-card>
    }
</div>
