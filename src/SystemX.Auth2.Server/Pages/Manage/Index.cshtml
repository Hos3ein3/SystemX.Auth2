@page
@model SystemX.Auth2.Server.Pages.Manage.IndexModel
@{
    Layout = "_LayoutManage";
    ViewData["Title"] = "Account Overview";
}

<div class="space-y-6">
    <div>
        <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100">Account Overview</h2>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Manage your profile, credentials, and active sessions.</p>
    </div>

    <a2-card title="Profile Information" subtitle="Basic personal and contact details associated with your account.">
        <dl class="divide-y divide-gray-100 dark:divide-gray-700/50">
            <a2-desc-item label="Username" value="@(Model.UserName ?? "Not set")" />
            <a2-desc-item label="Email address">
                <span class="text-gray-900 dark:text-gray-100 font-medium">@Model.Email</span>
                @if (Model.EmailConfirmed)
                {
                    <a2-badge variant="success">Verified</a2-badge>
                }
                else
                {
                    <span class="inline-flex items-center space-x-2">
                        <a2-badge variant="warning">Unverified</a2-badge>
                        <a href="/Account/ConfirmEmail" class="text-xs text-blue-600 dark:text-blue-400 hover:underline">Verify</a>
                    </span>
                }
            </a2-desc-item>
            <a2-desc-item label="Phone number">
                <span class="text-gray-900 dark:text-gray-100 font-medium">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "Not set" : Model.PhoneNumber)</span>
                @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                {
                    @if (Model.PhoneConfirmed)
                    {
                        <a2-badge variant="success">Verified</a2-badge>
                    }
                    else
                    {
                        <span class="inline-flex items-center space-x-2">
                            <a2-badge variant="warning">Unverified</a2-badge>
                            <a href="/Account/ConfirmPhone" class="text-xs text-blue-600 dark:text-blue-400 hover:underline">Verify</a>
                        </span>
                    }
                }
            </a2-desc-item>
        </dl>
    </a2-card>

    <a2-card title="Security Status" subtitle="Credentials and security methods protecting your sign-in.">
        <dl class="divide-y divide-gray-100 dark:divide-gray-700/50">
            <a2-desc-item label="Password">
                <span class="text-gray-900 dark:text-gray-100 tracking-wider">&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;</span>
                <a href="/Manage/ChangePassword" class="text-xs text-blue-600 dark:text-blue-400 font-medium hover:underline">Change Password</a>
            </a2-desc-item>
            @if (Model.ShowTwoFactor)
            {
                <a2-desc-item label="Two-Factor Authentication">
                    <div class="flex items-center space-x-3">
                        @if (Model.TwoFactorEnabled)
                        {
                            <a2-badge variant="success">Enabled</a2-badge>
                            <a href="/Manage/TwoFactor/RecoveryCodes" class="text-xs text-gray-600 dark:text-gray-400 hover:underline">Recovery Codes</a>
                        }
                        else
                        {
                            <a2-badge variant="neutral">Disabled</a2-badge>
                        }
                    </div>
                    <a href="/Manage/TwoFactor/Enable" class="text-xs text-blue-600 dark:text-blue-400 font-medium hover:underline">
                        @(Model.TwoFactorEnabled ? "Manage 2FA" : "Set up 2FA")
                    </a>
                </a2-desc-item>
            }
        </dl>
    </a2-card>
</div>
