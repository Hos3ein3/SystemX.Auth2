@page
@model SystemX.Auth2.Server.Pages.Account.JoinProjectModel
@{
    var rules = SystemX.Auth2.Server.Pages.Account.AccountFormRules.For(Model);
    var idField = SystemX.Auth2.Server.Pages.Account.AccountFormRules.FieldFor(rules.LookupKinds());
    var idRule = rules.Identifier(idField, Loc["forgot_password.login_field"].Value);
    var codeRule = rules.RequiredOnly(Loc["two_factor.code"].Value);
    var newRule = rules.NewPassword(Loc["reset_password.new_password"].Value);
}
@{
    Layout = "_LayoutAuth";
    ViewData["Title"] = Loc["join_project.title"];
}

<div class="space-y-6">
    <div class="text-center">
        <h2 class="text-xl font-bold text-[var(--a2-color-text,#111827)] dark:text-gray-100">
            @Loc["join_project.title"]
        </h2>
        <p class="mt-1 text-sm text-[var(--a2-color-muted,#6b7280)] dark:text-gray-400">
            Join @(Model.Project?.Name ?? "Project") using your existing account.
        </p>
    </div>

        @* the error is shown once, at the top of the card, by _LayoutAuth *@
    @if (Model.CodeSent)
    {
        <form method="post" class="space-y-4" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />
            <input type="hidden" asp-for="ClientId" />
            <input type="hidden" asp-for="Input.Login" />

            <a2-alert variant="info">
                A verification code was sent to your registered contact for <span class="font-mono font-medium">@Model.Input.Login</span>.
            </a2-alert>

            <a2-field label="@Loc["two_factor.code"]" required="true" for="Input_Code">
                <a2-input id="Input_Code" name="Input.Code" value="@Model.Input.Code" required="true" placeholder="123456" autocomplete="one-time-code" data-a2-rule="@codeRule" class="text-center tracking-widest text-lg font-mono" />
            </a2-field>

            @if (Model.AskNewPassword)
            {
                <a2-field label="@Loc["reset_password.new_password"]" required="true" for="Input_NewPassword" hint="Set a password for this project.">
                    <a2-password id="Input_NewPassword" name="Input.NewPassword" required="true" autocomplete="new-password" placeholder="••••••••••••" data-a2-rule="@newRule" />
                </a2-field>
            }

            <div class="pt-2">
                <a2-button type="submit" variant="primary" class="w-full">
                    @Loc["join_project.confirm"]
                </a2-button>
            </div>
        </form>

        <form method="post" asp-page-handler="Send" class="text-center pt-2">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />
            <input type="hidden" asp-for="ClientId" />
            <input type="hidden" asp-for="Input.Login" />
            <button type="submit" class="text-sm text-[var(--a2-color-primary,#2563eb)] hover:underline focus:outline-none bg-transparent border-0 cursor-pointer">
                Resend Code
            </button>
        </form>
    }
    else
    {
        <form method="post" asp-page-handler="Send" class="space-y-4" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />
            <input type="hidden" asp-for="ClientId" />

            <a2-field label="@Loc["forgot_password.login_field"]" required="true" for="Input_Login">
                <a2-input id="Input_Login" name="Input.Login" type="@idField.Type" inputmode="@idField.InputMode" value="@Model.Input.Login" required="true" placeholder="@idField.Placeholder" autocomplete="@idField.Autocomplete" data-a2-rule="@idRule" />
            </a2-field>

            <div class="pt-2">
                <a2-button type="submit" variant="primary" class="w-full">
                    @Loc["common.continue"]
                </a2-button>
            </div>
        </form>

        <div class="text-center">
            <a href="@Model.GetLoginUrl()" class="text-sm text-[var(--a2-color-primary,#2563eb)] hover:underline">
                @Loc["common.back_to_login"]
            </a>
        </div>
    }
</div>
