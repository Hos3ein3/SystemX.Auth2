@page "/admin/p/{projectKey}/permissions/detail"
@model SystemX.Auth2.Server.Pages.Admin.Permissions.DetailModel
@{
    Layout = "_LayoutAdmin";
    var p = Model.Permission;
    ViewData["Title"] = $"Permission: {p?.Key}";
}

<div class="max-w-4xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <div class="flex items-center space-x-2 text-sm text-gray-500">
            <a href="/admin/p/@Model.ProjectKey/permissions" class="hover:underline">Permissions</a>
            <span>/</span>
            <span class="text-gray-900 font-medium">@p?.Key</span>
        </div>
        <div class="flex items-center space-x-2">
            <form method="post" asp-page-handler="ToggleObsolete">
                <a2-button type="submit" variant="secondary">
                    @(p?.IsObsolete == true ? "Mark as Active" : "Mark as Obsolete")
                </a2-button>
            </form>
            <form method="post" asp-page-handler="Delete" onsubmit="return confirm('Are you sure you want to delete this permission?');">
                <a2-button type="submit" variant="danger">Delete Permission</a2-button>
            </form>
        </div>
    </div>

    <!-- Permission Header Card -->
    <div class="bg-white rounded-lg border border-gray-200 p-6 shadow-sm">
        <div class="flex items-center justify-between mb-2">
            <div>
                <span class="font-mono text-sm text-gray-500 block mb-1">Key</span>
                <h1 class="text-2xl font-bold font-mono text-gray-900">@p?.Key</h1>
            </div>
            <div>
                @if (p?.IsObsolete == true)
                {
                    <a2-badge variant="warning">Obsolete</a2-badge>
                }
                else
                {
                    <a2-badge variant="success">Active</a2-badge>
                }
            </div>
        </div>
        <div class="grid grid-cols-2 gap-4 mt-4 pt-4 border-t border-gray-100 text-sm">
            <div>
                <span class="block text-gray-500 font-medium">Display Name</span>
                <span class="text-gray-900">@(p?.DisplayName ?? "-")</span>
            </div>
            <div>
                <span class="block text-gray-500 font-medium">Category</span>
                <span class="text-gray-900 font-mono text-xs">@(p?.Group ?? "general")</span>
            </div>
            <div class="col-span-2">
                <span class="block text-gray-500 font-medium">Description</span>
                <span class="text-gray-900">@(p?.Description ?? "No description provided.")</span>
            </div>
        </div>
    </div>
</div>
