@{
    ViewData["Title"] = "Orders Management";
    bool canWrite = ViewBag.CanWrite ?? false;
}

<div class="space-y-6 max-w-4xl mx-auto">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
        <div class="flex items-center justify-between border-b pb-4 mb-4">
            <div>
                <h1 class="text-2xl font-bold text-gray-900">Orders Management</h1>
                <p class="text-sm text-gray-500">
                    Protected by <code class="font-mono bg-emerald-50 text-emerald-700 px-1.5 py-0.5 rounded text-xs">[Auth2Permission("orders.read")]</code>
                </p>
            </div>
            @if (canWrite)
            {
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800">
                    Write Permission Granted
                </span>
            }
            else
            {
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-gray-100 text-gray-600">
                    Read-Only
                </span>
            }
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-sm">
                <thead>
                    <tr class="bg-gray-50 border-b border-gray-200 text-gray-600">
                        <th class="py-3 px-4 font-semibold">Order #</th>
                        <th class="py-3 px-4 font-semibold">Item</th>
                        <th class="py-3 px-4 font-semibold">Amount</th>
                        <th class="py-3 px-4 font-semibold">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 text-gray-800">
                    <tr class="hover:bg-gray-50">
                        <td class="py-3 px-4 font-mono font-medium">ORD-1001</td>
                        <td class="py-3 px-4">Widget A</td>
                        <td class="py-3 px-4 font-medium">$19.99</td>
                        <td class="py-3 px-4"><span class="bg-blue-100 text-blue-800 text-xs px-2 py-0.5 rounded">Shipped</span></td>
                    </tr>
                    <tr class="hover:bg-gray-50">
                        <td class="py-3 px-4 font-mono font-medium">ORD-1002</td>
                        <td class="py-3 px-4">Gadget B</td>
                        <td class="py-3 px-4 font-medium">$49.50</td>
                        <td class="py-3 px-4"><span class="bg-yellow-100 text-yellow-800 text-xs px-2 py-0.5 rounded">Processing</span></td>
                    </tr>
                    <tr class="hover:bg-gray-50">
                        <td class="py-3 px-4 font-mono font-medium">ORD-1003</td>
                        <td class="py-3 px-4">Component C</td>
                        <td class="py-3 px-4 font-medium">$120.00</td>
                        <td class="py-3 px-4"><span class="bg-green-100 text-green-800 text-xs px-2 py-0.5 rounded">Delivered</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
