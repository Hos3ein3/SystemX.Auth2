@page "/admin/p/{projectKey}/roles/detail"
@model SystemX.Auth2.Server.Pages.Admin.Roles.DetailModel
@{
    Layout = "_LayoutAdmin";
    var r = Model.Role;
    ViewData["Title"] = $"Role: {r?.Name}";
}

<div class="max-w-4xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <div class="flex items-center space-x-2 text-sm text-gray-500">
            <a href="/admin/p/@Model.ProjectKey/roles" class="hover:underline">Roles</a>
            <span>/</span>
            <span class="text-gray-900 font-medium">@r?.Name</span>
        </div>
        @if (r?.IsSystem == false)
        {
            <form method="post" asp-page-handler="Delete" data-confirm="Are you sure you want to delete this role?">
                <a2-button type="submit" variant="danger">Delete Role</a2-button>
            </form>
        }
    </div>

    <!-- Role Header -->
    <div class="bg-white rounded-lg border border-gray-200 p-6 shadow-sm">
        <div class="flex items-center justify-between mb-2">
            <h1 class="text-2xl font-bold text-gray-900">@r?.Name</h1>
            <div>
                @if (r?.IsSystem == true)
                {
                    <a2-badge variant="neutral">System Role (Immutable)</a2-badge>
                }
                else if (r?.IsGlobal == true)
                {
                    <a2-badge variant="info">Global Role</a2-badge>
                }
                else
                {
                    <a2-badge variant="success">Project Role</a2-badge>
                }
            </div>
        </div>
        <p class="text-sm text-gray-600">@(r?.Description ?? "No description provided.")</p>
    </div>

    <!-- Permissions in Role -->
    <a2-card title="Assigned Permissions (@r?.Permissions.Count)">
        @if (r?.Permissions.Count > 0)
        {
            <div class="flex flex-wrap gap-2">
                @foreach (var perm in r.Permissions)
                {
                    <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-mono font-medium bg-blue-50 text-blue-800 border border-blue-200">
                        @perm
                    </span>
                }
            </div>
        }
        else
        {
            <p class="text-sm text-gray-500 py-3">No permissions currently assigned to this role.</p>
        }
    </a2-card>
</div>
