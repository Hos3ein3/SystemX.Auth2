@{
    var pageModel = Model as SystemX.Auth2.Server.Pages.Auth2PageModel;
}
<!DOCTYPE html>
<html lang="en" class="h-full bg-[var(--a2-color-background,#f9fafb)]">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <partial name="_Branding" model="Model" />
    <link rel="stylesheet" href="/css/site.css" />
    <script src="/js/a2.js" defer></script>
</head>
<body class="h-full font-[var(--a2-font-family,system-ui)] text-[var(--a2-color-text,#111827)] antialiased">
    <div class="min-h-full flex flex-col justify-center py-12 sm:px-6 lg:px-8">
        <div class="sm:mx-auto sm:w-full sm:max-w-md text-center">
            <h1 class="text-3xl font-extrabold tracking-tight text-[var(--a2-color-primary,#2563eb)]">
                @(pageModel?.BrandName ?? "SystemX Auth2")
            </h1>
            @if (ViewData["Subtitle"] is string subtitle)
            {
                <p class="mt-2 text-sm text-[var(--a2-color-muted,#6b7280)]">@subtitle</p>
            }
        </div>

        <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
            <div class="bg-[var(--a2-color-surface,#ffffff)] py-8 px-4 shadow-sm sm:rounded-[var(--a2-radius,0.375rem)] sm:px-10 border border-gray-200">
                @if (TempData["Success"] is string success)
                {
                    <a2-alert variant="success">@success</a2-alert>
                }
                @if (TempData["Error"] is string error)
                {
                    <a2-alert variant="error">@error</a2-alert>
                }
                @if (pageModel != null && !string.IsNullOrEmpty(pageModel.ErrorMessage))
                {
                    <a2-alert variant="error">@pageModel.ErrorMessage</a2-alert>
                }
                @RenderBody()
            </div>
            
            <footer class="mt-6 text-center text-xs text-[var(--a2-color-muted,#6b7280)] space-x-4">
                <span>&copy; @DateTime.UtcNow.Year SystemX</span>
                <a href="#" class="hover:underline">Privacy</a>
                <a href="#" class="hover:underline">Terms</a>
            </footer>
        </div>
    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
