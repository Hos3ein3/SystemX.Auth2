@page "/admin/p/{projectKey}/audit"
@model SystemX.Auth2.Server.Pages.Admin.Audit.IndexModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = $"Audit Log - {Model.CurrentProject?.Name}";
}

<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Audit Events</h1>
            <p class="mt-1 text-sm text-gray-500">Immutable record of security and administrative actions in @Model.CurrentProject?.Name.</p>
        </div>
    </div>

    <!-- Filter Form -->
    <form method="get" class="flex flex-wrap items-center gap-3">
        <a2-search name="q" value="@Model.Q" placeholder="Search actor / target..." />
        <a2-input name="actionFilter" value="@Model.ActionFilter" placeholder="Action (e.g. user.created)" class="max-w-[200px]" />
        <a2-input name="targetType" value="@Model.TargetType" placeholder="Target Type (e.g. user)" class="max-w-[160px]" />
        <a2-page-size value="@Model.PageSize" />
        <a2-button type="submit" variant="secondary">Filter</a2-button>
    </form>

    <div class="overflow-x-auto rounded-lg border border-gray-200 bg-white shadow-sm">
        <table class="min-w-full divide-y divide-gray-200 text-sm">
            <thead class="bg-gray-50">
                <tr>
                    <th scope="col" class="px-6 py-3 text-left font-semibold text-gray-700">Timestamp (UTC)</th>
                    <th scope="col" class="px-6 py-3 text-left font-semibold text-gray-700">Action</th>
                    <th scope="col" class="px-6 py-3 text-left font-semibold text-gray-700">Actor</th>
                    <th scope="col" class="px-6 py-3 text-left font-semibold text-gray-700">Target</th>
                    <th scope="col" class="px-6 py-3 text-left font-semibold text-gray-700">IP Address</th>
                    <th scope="col" class="px-6 py-3 text-left font-semibold text-gray-700">Data</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
                @if (Model.Events.Items.Count > 0)
                {
                    @foreach (var e in Model.Events.Items)
                    {
                        <tr class="hover:bg-gray-50">
                            <td class="px-6 py-4 text-xs text-gray-500 font-mono">@e.OccurredAtUtc.ToString("u")</td>
                            <td class="px-6 py-4 font-mono text-xs font-semibold text-gray-900">@e.Action</td>
                            <td class="px-6 py-4 text-xs font-mono text-gray-600">
                                @(e.ActorUserId?.ToString()[..Math.Min(8, e.ActorUserId.Value.ToString().Length)] ?? e.ActorClientId ?? "system")
                            </td>
                            <td class="px-6 py-4 text-xs text-gray-700">
                                <span class="text-gray-400">[@(e.TargetType ?? "-")]</span> @(e.TargetId ?? "-")
                            </td>
                            <td class="px-6 py-4 text-xs font-mono text-gray-500">@(e.IpAddress ?? "-")</td>
                            <td class="px-6 py-4 text-xs font-mono text-gray-500 max-w-xs truncate" title="@e.DataJson">
                                @(e.DataJson ?? "-")
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="px-6 py-12 text-center text-gray-500">
                            No audit events found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <a2-pager page="@Model.Events.Page" pageSize="@Model.Events.PageSize" totalCount="@Model.Events.TotalCount" totalPages="@Model.Events.TotalPages" />
</div>
