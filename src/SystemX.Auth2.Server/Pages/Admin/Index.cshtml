@page "/admin"
@model SystemX.Auth2.Server.Pages.Admin.IndexModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Select Project";
}

<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Projects</h1>
            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Select a project to manage its users, applications, and settings.</p>
        </div>
        <div>
            <a2-link-button href="/admin/projects/create" variant="primary">
                + Create Project
            </a2-link-button>
        </div>
    </div>

    @if (Model.Projects?.Items.Count > 0)
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var p in Model.Projects.Items)
            {
                <div class="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 shadow-sm p-6 hover:shadow-md transition-shadow flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-xs font-mono bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-200 px-2 py-0.5 rounded">@p.ProjectKey</span>
                            <div class="flex items-center gap-1.5">
                                <partial name="_ClientHealthBadge" model="Model.ClientHealth.GetValueOrDefault(p.Id) ?? []" />
                                @if (p.IsEnabled)
                                {
                                    <a2-badge variant="success">Active</a2-badge>
                                }
                                else
                                {
                                    <a2-badge variant="danger">Disabled</a2-badge>
                                }
                            </div>
                        </div>
                        <h3 class="text-lg font-bold text-gray-900 dark:text-gray-100 mb-1">@p.Name</h3>
                        <p class="text-sm text-gray-500 dark:text-gray-400 line-clamp-2">@(p.Description ?? "No description")</p>
                    </div>

                    <div class="mt-6 pt-4 border-t border-gray-100 dark:border-gray-700 flex items-center justify-between">
                        <span class="text-xs text-gray-400 dark:text-gray-500">Created @p.CreatedAtUtc.ToString("d")</span>
                        <a href="/admin/p/@p.ProjectKey" class="text-sm font-semibold text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300">
                            Open Console &rarr;
                        </a>
                    </div>
                </div>
            }
        </div>

        <a2-pager page="@Model.Projects.Page" pageSize="@Model.Projects.PageSize" totalCount="@Model.Projects.TotalCount" totalPages="@Model.Projects.TotalPages" />
    }
    else
    {
        <a2-empty-state title="No projects found" message="No projects have been configured yet.">
            <a2-link-button href="/admin/projects/create" variant="primary">
                Create First Project
            </a2-link-button>
        </a2-empty-state>
    }
</div>
