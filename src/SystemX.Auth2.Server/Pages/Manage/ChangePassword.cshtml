@page
@model SystemX.Auth2.Server.Pages.Manage.ChangePasswordModel
@{
    // The rules saved in the project settings, given to the browser: the messages show while the person types.
    var rules = SystemX.Auth2.Server.Pages.Account.AccountFormRules.For(Model);
    var currentRule = rules.RequiredOnly("Current password");
    var newRule = rules.NewPassword("New password");
    Layout = "_LayoutManage";
    ViewData["Title"] = "Change Password";
}

<div class="space-y-6 max-w-xl">
    <div>
        <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100">Change Password</h2>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Ensure your account uses a strong, unique password.</p>
    </div>

    @if (Model.Changed)
    {
        <a2-alert variant="success">
            Your password has been changed successfully.
        </a2-alert>
    }

    <a2-card title="Update Password" subtitle="Enter your current password and choose a new secure password.">
        <form method="post" class="space-y-4" novalidate>
            <a2-field label="Current password" required="true">
                <a2-password id="Input_CurrentPassword" name="Input.CurrentPassword" required="true" autocomplete="current-password" data-a2-rule="@currentRule" />
            </a2-field>

            <a2-field label="New password" required="true">
                <a2-password id="Input_NewPassword" name="Input.NewPassword" required="true" autocomplete="new-password" data-a2-rule="@newRule" />
            </a2-field>

            <div class="pt-2 flex justify-end">
                <a2-button type="submit" variant="primary">
                    Update Password
                </a2-button>
            </div>
        </form>
    </a2-card>
</div>
