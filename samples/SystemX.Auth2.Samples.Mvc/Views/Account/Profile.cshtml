@model UserProfileViewModel
@{
    ViewData["Title"] = "User Profile";
}

<div class="max-w-4xl mx-auto space-y-6">
    <div class="bg-white shadow rounded-lg p-6 border border-gray-100">
        <div class="flex items-center justify-between border-b pb-4 mb-6">
            <div>
                <h1 class="text-2xl font-bold text-gray-900">User Profile</h1>
                <p class="text-sm text-gray-500">Information provided by <code class="font-mono bg-gray-100 px-1 py-0.5 rounded">ICurrentUser</code> and <code class="font-mono bg-gray-100 px-1 py-0.5 rounded">ICurrentClient</code></p>
            </div>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-800">
                Authenticated
            </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3">Identity Details</h3>
                <dl class="space-y-2 text-sm">
                    <div class="flex justify-between py-1 border-b border-gray-50">
                        <dt class="text-gray-500">User ID (sub):</dt>
                        <dd class="font-mono font-medium text-gray-800">@(Model.UserId?.ToString() ?? "—")</dd>
                    </div>
                    <div class="flex justify-between py-1 border-b border-gray-50">
                        <dt class="text-gray-500">Username:</dt>
                        <dd class="font-medium text-gray-800">@(Model.UserName ?? "—")</dd>
                    </div>
                    <div class="flex justify-between py-1 border-b border-gray-50">
                        <dt class="text-gray-500">Full Name:</dt>
                        <dd class="font-medium text-gray-800">@(Model.FullName ?? "—")</dd>
                    </div>
                    <div class="flex justify-between py-1 border-b border-gray-50">
                        <dt class="text-gray-500">Email:</dt>
                        <dd class="font-medium text-gray-800">@(Model.Email ?? "—")</dd>
                    </div>
                    <div class="flex justify-between py-1 border-b border-gray-50">
                        <dt class="text-gray-500">Phone Number:</dt>
                        <dd class="font-medium text-gray-800">@(Model.PhoneNumber ?? "—")</dd>
                    </div>
                    <div class="flex justify-between py-1 border-b border-gray-50">
                        <dt class="text-gray-500">Identity Provider (idp):</dt>
                        <dd class="font-medium text-gray-800">@(Model.IdentityProvider ?? "Local / SystemX")</dd>
                    </div>
                    <div class="flex justify-between py-1 border-b border-gray-50">
                        <dt class="text-gray-500">Auth Methods (amr):</dt>
                        <dd class="font-mono text-gray-800">@(Model.Amr.Count > 0 ? string.Join(", ", Model.Amr) : "—")</dd>
                    </div>
                </dl>
            </div>

            <div>
                <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3">Client &amp; Context</h3>
                <dl class="space-y-2 text-sm">
                    <div class="flex justify-between py-1 border-b border-gray-50">
                        <dt class="text-gray-500">OAuth Client ID:</dt>
                        <dd class="font-mono text-gray-800">@(Model.ClientId ?? "—")</dd>
                    </div>
                    <div class="flex justify-between py-1 border-b border-gray-50">
                        <dt class="text-gray-500">Project Key:</dt>
                        <dd class="font-mono text-gray-800">@(Model.ProjectKey ?? "—")</dd>
                    </div>
                    <div class="flex justify-between py-1 border-b border-gray-50">
                        <dt class="text-gray-500">Session ID (sid):</dt>
                        <dd class="font-mono text-gray-800">@(Model.SessionId ?? "—")</dd>
                    </div>
                    <div class="flex justify-between py-1 border-b border-gray-50">
                        <dt class="text-gray-500">Is Machine Token:</dt>
                        <dd class="font-medium text-gray-800">@(Model.IsMachine ? "Yes" : "No")</dd>
                    </div>
                    <div class="py-1">
                        <dt class="text-gray-500 mb-1">Scopes:</dt>
                        <dd class="flex flex-wrap gap-1">
                            @if (Model.Scopes.Count > 0)
                            {
                                @foreach (var s in Model.Scopes)
                                {
                                    <span class="inline-block bg-blue-100 text-blue-800 px-2 py-0.5 rounded text-xs font-mono">@s</span>
                                }
                            }
                            else
                            {
                                <span class="text-gray-400">—</span>
                            }
                        </dd>
                    </div>
                </dl>
            </div>
        </div>

        <div class="mt-8 pt-6 border-t border-gray-100 grid grid-cols-1 md:grid-cols-3 gap-6">
            <div>
                <h4 class="text-sm font-semibold text-gray-700 mb-2">Roles</h4>
                @if (Model.Roles.Count > 0)
                {
                    <ul class="space-y-1">
                        @foreach (var r in Model.Roles)
                        {
                            <li class="inline-block mr-1 mb-1 bg-purple-100 text-purple-800 px-2.5 py-1 rounded-md text-xs font-semibold">@r</li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-sm text-gray-400 italic">No roles assigned.</p>
                }
            </div>

            <div>
                <h4 class="text-sm font-semibold text-gray-700 mb-2">Permissions</h4>
                @if (Model.Permissions.Count > 0)
                {
                    <ul class="space-y-1">
                        @foreach (var p in Model.Permissions)
                        {
                            <li class="inline-block mr-1 mb-1 bg-emerald-100 text-emerald-800 px-2.5 py-1 rounded-md text-xs font-mono">@p</li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-sm text-gray-400 italic">No permissions assigned.</p>
                }
            </div>

            <div>
                <h4 class="text-sm font-semibold text-gray-700 mb-2">Groups</h4>
                @if (Model.Groups.Count > 0)
                {
                    <ul class="space-y-1">
                        @foreach (var g in Model.Groups)
                        {
                            <li class="inline-block mr-1 mb-1 bg-amber-100 text-amber-800 px-2.5 py-1 rounded-md text-xs font-medium">@g</li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-sm text-gray-400 italic">No groups assigned.</p>
                }
            </div>
        </div>
    </div>
</div>
