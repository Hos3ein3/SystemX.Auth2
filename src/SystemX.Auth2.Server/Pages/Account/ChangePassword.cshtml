@page
@model SystemX.Auth2.Server.Pages.Account.ChangePasswordModel
@{
    var rules = SystemX.Auth2.Server.Pages.Account.AccountFormRules.For(Model);
    var currentRule = rules.RequiredOnly(Loc["change_password.current_password"].Value);
    var newRule = rules.NewPassword(Loc["change_password.new_password"].Value);
}
@{
    Layout = "_LayoutAuth";
    ViewData["Title"] = Loc["change_password.title"];
    ViewData["Subtitle"] = Loc["change_password.subtitle"];
}

@if (Model.Changed)
{
    <div class="text-center space-y-4">
        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-emerald-100 dark:bg-emerald-900/50">
            <svg class="h-6 w-6 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
        </div>
        <h2 class="text-xl font-bold text-[var(--a2-color-text,#111827)] dark:text-gray-100">@Loc["change_password.title"]</h2>
        <p class="text-sm text-gray-600 dark:text-gray-300">
            @Loc["change_password.success"]
        </p>
        <div class="pt-4">
            <a2-link-button href="@(Model.SafeReturnUrl() ?? "/")" variant="primary" class="w-full">
                @Loc["common.continue"]
            </a2-link-button>
        </div>
    </div>
}
else
{
    <form method="post" class="space-y-4" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ReturnUrl" />
        <input type="hidden" asp-for="ClientId" />

        @* the error is shown once, at the top of the card, by _LayoutAuth *@
        @if (Model.PasswordRequired)
        {
            <a2-field label="@Loc["change_password.current_password"]" required="true" for="Input_CurrentPassword">
                <a2-password id="Input_CurrentPassword" name="Input.CurrentPassword" required="true" autocomplete="current-password" placeholder="••••••••••••" data-a2-rule="@currentRule" />
            </a2-field>
        }

        <a2-field label="@Loc["change_password.new_password"]" required="true" for="Input_NewPassword" hint="Choose a strong, unique password.">
            <a2-password id="Input_NewPassword" name="Input.NewPassword" required="true" autocomplete="new-password" placeholder="••••••••••••" data-a2-rule="@newRule" />
        </a2-field>

        <div class="pt-2">
            <a2-button type="submit" variant="primary" class="w-full">
                @Loc["change_password.save_button"]
            </a2-button>
        </div>

        <div class="mt-4 text-center text-sm">
            <a href="@(Model.SafeReturnUrl() ?? "/")" class="font-medium text-[var(--a2-color-primary,#2563eb)] hover:underline">
                @Loc["common.back"]
            </a>
        </div>
    </form>
}
