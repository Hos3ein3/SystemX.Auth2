@page
@model SystemX.Auth2.Server.Pages.Account.ConsentModel
@{
    Layout = "_LayoutAuth";
    ViewData["Title"] = Loc["consent.title"];
}

<div class="space-y-6">
    <div class="text-center">
        <h2 class="text-lg font-bold text-[var(--a2-color-text,#111827)] dark:text-gray-100">
            @(Model.ApplicationName ?? "Application") @Loc["consent.title"]
        </h2>
        <p class="mt-1 text-sm text-[var(--a2-color-muted,#6b7280)] dark:text-gray-400">
            @Loc["consent.subtitle"]:
        </p>
    </div>

    @if (Model.Scopes.Count > 0)
    {
        <div class="rounded-md border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 p-4 divide-y divide-gray-200 dark:divide-gray-700">
            @foreach (var scope in Model.Scopes)
            {
                <div class="py-2.5 flex items-start space-x-3 first:pt-0 last:pb-0">
                    <svg class="h-5 w-5 text-emerald-500 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <div>
                        <span class="text-sm font-semibold text-gray-800 dark:text-gray-200">@scope</span>
                        <p class="text-xs text-gray-500 dark:text-gray-400">Access to @scope resources on your behalf</p>
                    </div>
                </div>
            }
        </div>
    }

    <form method="post" class="space-y-3">
        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
        <a2-button type="submit" asp-page-handler="Accept" class="w-full">
            @Loc["consent.allow"]
        </a2-button>
        <button type="submit" asp-page-handler="Deny" class="w-full inline-flex justify-center rounded-[var(--a2-radius,0.375rem)] border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 px-4 py-2 text-sm font-medium text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-400">
            @Loc["consent.deny"]
        </button>
    </form>
</div>
