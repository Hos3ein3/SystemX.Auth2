@{
    var pageModel = Model as SystemX.Auth2.Server.Pages.Auth2PageModel;
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLowerInvariant();
    var isRtl = currentCulture == "fa";
    var dir = isRtl ? "rtl" : "ltr";
}
<!DOCTYPE html>
<html lang="@currentCulture" dir="@dir" class="h-full bg-[var(--a2-color-background,#f9fafb)]">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @(pageModel?.BrandName ?? "SystemX Auth2")</title>
    <partial name="_Branding" model="Model" />
    <link rel="stylesheet" href="/css/site.css" />
    <script src="/js/a2.js" asp-append-version="true" defer></script>
</head>
<body class="h-full font-[var(--a2-font-family,system-ui)] text-[var(--a2-color-text,#111827)] dark:text-gray-100 bg-gray-50 dark:bg-gray-900 antialiased">
    <div class="min-h-full flex flex-col justify-center py-12 sm:px-6 lg:px-8">
        @{
            // Pages with long text (privacy, terms) ask for a wide card: ViewData["Wide"] = true
            var wide = ViewData["Wide"] is true;
            var width = wide ? "sm:max-w-3xl" : "sm:max-w-md";
            var linkClient = pageModel?.ClientIdForLinks;
            var clientQuery = string.IsNullOrEmpty(linkClient) ? "" : "?ClientId=" + Uri.EscapeDataString(linkClient);
        }
        <div class="sm:mx-auto sm:w-full @width text-center">
            <h1 class="text-3xl font-extrabold tracking-tight text-[var(--a2-color-primary,#2563eb)]">
                @(pageModel?.BrandName ?? "SystemX Auth2")
            </h1>
            @if (ViewData["Subtitle"] is string subtitle)
            {
                <p class="mt-2 text-sm text-[var(--a2-color-muted,#6b7280)]">@subtitle</p>
            }
        </div>

        <div class="mt-8 sm:mx-auto sm:w-full @width">
            <div class="bg-[var(--a2-color-surface,#ffffff)] dark:bg-gray-800 py-8 px-4 shadow-sm sm:rounded-[var(--a2-radius,0.375rem)] sm:px-10 border border-gray-200 dark:border-gray-700">
                <!-- Language Selector & Dark Mode Toggle inside card box (matching screenshot) -->
                <div class="flex justify-end items-center gap-3 mb-6 pb-3 border-b border-gray-100 dark:border-gray-700/60">
                    <div class="inline-flex items-center gap-2">
                        <!-- 文A Translate Icon -->
                        <svg class="w-5 h-5 text-gray-500 dark:text-gray-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 5h7" />
                            <path d="M9 3v2c0 4.418-2.239 8-5 8" />
                            <path d="M5 9c0 2.144 2.952 3.908 6.7 4" />
                            <path d="M12 20l4-9 4 9" />
                            <path d="M13.5 17h5" />
                        </svg>

                        <!-- Culture Selector Dropdown Pill with Chevron -->
                        <div class="relative inline-flex items-center">
                            <select aria-label="Select culture / language" data-culture-select class="appearance-none text-xs font-semibold rounded-2xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-800 dark:text-gray-100 pl-3.5 pr-8 py-1.5 focus:ring-2 focus:ring-blue-500 focus:outline-none transition-colors shadow-xs cursor-pointer">
                                <!option value="en" @(currentCulture == "en" ? "selected" : "")>English (EN)</!option>
                                <!option value="fa" @(currentCulture == "fa" ? "selected" : "")>فارسی (FA)</!option>
                                <!option value="nl" @(currentCulture == "nl" ? "selected" : "")>Nederlands (NL)</!option>
                                <!option value="it" @(currentCulture == "it" ? "selected" : "")>Italiano (IT)</!option>
                                <!option value="de" @(currentCulture == "de" ? "selected" : "")>Deutsch (DE)</!option>
                                <!option value="es" @(currentCulture == "es" ? "selected" : "")>Español (ES)</!option>
                                <!option value="fr" @(currentCulture == "fr" ? "selected" : "")>Français (FR)</!option>
                            </select>
                            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-2.5 text-gray-600 dark:text-gray-400">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                </svg>
                            </div>
                        </div>
                    </div>

                    <!-- Dark Mode Toggle Button -->
                    <button type="button" data-toggle-theme aria-label="Toggle dark mode" class="p-1 text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-200 rounded-full focus:outline-none focus:ring-2 focus:ring-blue-500 transition-colors cursor-pointer">
                        <svg class="hidden dark:block w-5 h-5 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" clip-rule="evenodd" />
                        </svg>
                        <svg class="block dark:hidden w-5 h-5 text-slate-700" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z" />
                        </svg>
                    </button>
                </div>

                @if (TempData["Success"] is string success)
                {
                    <a2-alert variant="success">@success</a2-alert>
                }
                @if (TempData["Error"] is string error)
                {
                    <a2-alert variant="error">@error</a2-alert>
                }
                @if (pageModel != null && !string.IsNullOrEmpty(pageModel.ErrorMessage) && pageModel.ProjectFound && !(ViewContext.ActionDescriptor.DisplayName?.Contains("Logout", StringComparison.OrdinalIgnoreCase) ?? false))
                {
                    <a2-alert variant="error">@pageModel.ErrorMessage</a2-alert>
                }
                @RenderBody()
            </div>

            <footer class="mt-6 text-center text-xs text-[var(--a2-color-muted,#6b7280)] space-x-4">
                <span>&copy; @DateTime.UtcNow.Year SystemX</span>
                <a href="/privacy@(clientQuery)" class="hover:underline">Privacy</a>
                <a href="/terms@(clientQuery)" class="hover:underline">Terms</a>
            </footer>
        </div>
    </div>

    <!-- Global Page Loader Modal Overlay with Cancel Button -->
    <div id="a2GlobalLoader" class="fixed inset-0 z-50 hidden bg-gray-900/60 backdrop-blur-xs flex items-center justify-center p-4 transition-opacity duration-200" role="status" aria-live="polite">
        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-2xl border border-gray-200 dark:border-gray-700 p-6 max-w-xs w-full text-center space-y-4">
            <div class="flex justify-center">
                <svg class="animate-spin h-9 w-9 text-[var(--a2-color-primary,#2563eb)]" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
            </div>
            <div>
                <h3 class="text-sm font-bold text-gray-900 dark:text-gray-100" id="a2GlobalLoaderTitle">Loading...</h3>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5" id="a2GlobalLoaderMessage">Please wait while processing.</p>
            </div>
            <div>
                <button type="button" id="a2GlobalLoaderCancel" class="w-full inline-flex items-center justify-center px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg text-xs font-semibold text-gray-700 dark:text-gray-200 bg-white dark:bg-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600 focus:outline-none focus:ring-2 focus:ring-offset-1 focus:ring-gray-400 transition-colors shadow-xs cursor-pointer">
                    <svg class="w-3.5 h-3.5 mr-1 text-gray-500 dark:text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                    Cancel
                </button>
            </div>
        </div>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
