@page "/admin/p/{projectKey}/groups"
@model SystemX.Auth2.Server.Pages.Admin.Groups.IndexModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = $"Groups - {Model.CurrentProject?.Name}";
}

<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">User Groups</h1>
            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Organize users and assign bulk roles and permissions in @Model.CurrentProject?.Name.</p>
        </div>
        <a2-link-button href="/admin/p/@Model.ProjectKey/groups/create" variant="primary">
            + New Group
        </a2-link-button>
    </div>

    <!-- Filter Form -->
    <form method="get" class="flex items-center gap-3">
        <a2-search name="q" value="@Model.Q" placeholder="Search groups..."></a2-search>
        <a2-button type="submit" variant="secondary">Search</a2-button>
    </form>

    <div class="overflow-x-auto rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 shadow-sm">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700 text-sm">
            <thead class="bg-gray-50 dark:bg-gray-900/60">
                <tr>
                    <th scope="col" class="px-6 py-3 text-left font-semibold text-gray-700 dark:text-gray-300">Group Name</th>
                    <th scope="col" class="px-6 py-3 text-left font-semibold text-gray-700 dark:text-gray-300">Display Name</th>
                    <th scope="col" class="px-6 py-3 text-left font-semibold text-gray-700 dark:text-gray-300">Description</th>
                    <th scope="col" class="px-6 py-3 text-left font-semibold text-gray-700 dark:text-gray-300">Roles</th>
                    <th scope="col" class="px-6 py-3 text-left font-semibold text-gray-700 dark:text-gray-300">Permissions</th>
                    <th scope="col" class="px-6 py-3 text-right font-semibold text-gray-700 dark:text-gray-300">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                @if (Model.Groups.Count > 0)
                {
                    @foreach (var g in Model.Groups)
                    {
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                            <td class="px-6 py-4 font-semibold text-gray-900 dark:text-gray-100">
                                <a href="/admin/p/@Model.ProjectKey/groups/detail?name=@g.Name" class="text-blue-600 dark:text-blue-400 hover:underline">
                                    @g.Name
                                </a>
                            </td>
                            <td class="px-6 py-4 text-gray-800 dark:text-gray-200">@(g.DisplayName ?? "-")</td>
                            <td class="px-6 py-4 text-gray-500 dark:text-gray-400">@(g.Description ?? "-")</td>
                            <td class="px-6 py-4">
                                <span class="font-mono text-xs bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-200 px-2 py-0.5 rounded">
                                    @g.Roles.Count roles
                                </span>
                            </td>
                            <td class="px-6 py-4">
                                <span class="font-mono text-xs bg-blue-50 dark:bg-blue-900/40 text-blue-800 dark:text-blue-300 px-2 py-0.5 rounded">
                                    @g.Permissions.Count permissions
                                </span>
                            </td>
                            <td class="px-6 py-4 text-right space-x-2">
                                <a href="/admin/p/@Model.ProjectKey/groups/detail?name=@g.Name" class="text-blue-600 dark:text-blue-400 hover:underline text-xs font-semibold">View</a>
                                <span class="text-gray-300 dark:text-gray-600">|</span>
                                <form method="post" asp-page-handler="Delete" asp-route-name="@g.Name" class="inline" data-confirm="Delete group @g.Name?">
                                    <button type="submit" class="text-xs text-red-600 dark:text-red-400 hover:underline">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="px-6 py-12 text-center text-gray-500 dark:text-gray-400">
                            No groups found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
