@inject IWebHostEnvironment _environment
@{
    var projectKey = ViewContext.RouteData.Values["projectKey"]?.ToString() ?? (Model as SystemX.Auth2.Server.Pages.Admin.AdminPageModel)?.ProjectKey ?? "_global";
    var isGlobalAdmin = User.IsInRole("GlobalAdmin") || User.IsInRole("Developer") || User.HasClaim("scope", "auth2.admin.global");
    var currentPath = ViewContext.HttpContext.Request.Path.Value ?? "";
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLowerInvariant();

    bool IsActive(string href, bool exact = false)
    {
        if (string.IsNullOrEmpty(href)) return false;
        var trimmedPath = currentPath.TrimEnd('/');
        var trimmedHref = href.TrimEnd('/');
        if (exact || string.IsNullOrEmpty(trimmedHref))
            return string.Equals(trimmedPath, trimmedHref, StringComparison.OrdinalIgnoreCase);
        return trimmedPath.Equals(trimmedHref, StringComparison.OrdinalIgnoreCase) ||
               trimmedPath.StartsWith(trimmedHref + "/", StringComparison.OrdinalIgnoreCase);
    }

    string NavClass(string href, bool exact = false)
    {
        return IsActive(href, exact)
            ? "group flex items-center px-3 py-2 text-sm font-semibold rounded-md bg-blue-50 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 border-l-4 border-blue-600 dark:border-blue-500 shadow-sm transition-colors"
            : "group flex items-center px-3 py-2 text-sm font-medium rounded-md text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700/60 transition-colors";
    }

    string NavIconClass(string href, bool exact = false)
    {
        return IsActive(href, exact)
            ? "mr-3 h-5 w-5 text-blue-600 dark:text-blue-400"
            : "mr-3 h-5 w-5 text-gray-400 dark:text-gray-500 group-hover:text-gray-600 dark:group-hover:text-gray-300";
    }

    string SubNavClass(string href)
    {
        return IsActive(href, true)
            ? "group flex items-center px-3 py-1.5 text-sm font-semibold rounded-md bg-blue-50 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 border-l-2 border-blue-600 dark:border-blue-500"
            : "group flex items-center px-3 py-1.5 text-sm font-medium rounded-md text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700/60";
    }

    string GlobalNavClass(string href)
    {
        return IsActive(href, false)
            ? "group flex items-center px-3 py-2 text-sm font-semibold rounded-md bg-purple-50 dark:bg-purple-900/40 text-purple-900 dark:text-purple-200 border-l-4 border-purple-600 dark:border-purple-500"
            : "group flex items-center px-3 py-2 text-sm font-medium rounded-md text-purple-900 dark:text-purple-300 hover:bg-purple-50 dark:hover:bg-purple-900/20";
    }
}
