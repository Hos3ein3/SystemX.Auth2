@page
@model SystemX.Auth2.Server.Pages.Account.VerifyTotpModel
@{
    Layout = "_LayoutAuth";
    ViewData["Title"] = Loc["verify_totp.title"];
    ViewData["Subtitle"] = Loc["verify_totp.subtitle"];
    var rules = SystemX.Auth2.Server.Pages.Account.AccountFormRules.For(Model);
    var codeRule = rules.TotpCode(Loc["verify_totp.code"].Value);
    var back = Model.BackUrl();
}

@if (Model.Verified)
{
    <div class="text-center space-y-4">
        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-emerald-100 dark:bg-emerald-900/50">
            <svg class="h-6 w-6 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
        </div>
        <h2 class="text-xl font-bold text-[var(--a2-color-text,#111827)] dark:text-gray-100">@Loc["verify_totp.title"]</h2>
        <p class="text-sm text-gray-600 dark:text-gray-300">@Loc["verify_totp.success"]</p>
        <div class="pt-4">
            <a2-button href="@back" variant="primary" class="w-full">@Loc["common.continue"]</a2-button>
        </div>
    </div>
}
else if (Model.ProjectFound && (!Model.TotpAllowed || !Model.TwoFactorEnabled) && Model.CurrentUser is not null)
{
    <div class="space-y-4 text-center">
        <a2-alert variant="warning">@Loc["verify_totp.not_enabled"]</a2-alert>
        @if (Model.TotpAllowed)
        {
            <a2-button href="/Manage/TwoFactor/Enable?ClientId=@Uri.EscapeDataString(Model.ClientId ?? "")" variant="primary" class="w-full">@Loc["verify_totp.enable_link"]</a2-button>
        }
        <a href="@back" class="block text-sm font-medium text-[var(--a2-color-primary,#2563eb)] hover:underline">@Loc["common.back"]</a>
    </div>
}
else
{
    <form method="post" class="space-y-4" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ReturnUrl" />
        <input type="hidden" asp-for="ClientId" />

        @* the error of a wrong code is shown once, at the top of the card, by _LayoutAuth *@
        <a2-field label="@Loc["verify_totp.code"]" required="true" for="Input_Code" hint="@Loc["verify_totp.hint"]">
            <a2-input id="Input_Code" name="Input.Code" inputmode="numeric" pattern="[0-9 ]*" maxlength="10" autocomplete="one-time-code" required="true" placeholder="123456" data-a2-digits="true"
                      class="text-center tracking-widest text-lg font-mono" data-a2-rule="@codeRule" />
        </a2-field>

        <div class="pt-2">
            <a2-button type="submit" variant="primary" class="w-full">@Loc["verify_totp.button"]</a2-button>
        </div>

        <div class="mt-4 text-center text-sm">
            <a href="@back" class="font-medium text-[var(--a2-color-primary,#2563eb)] hover:underline">@Loc["common.back"]</a>
        </div>
    </form>
}
