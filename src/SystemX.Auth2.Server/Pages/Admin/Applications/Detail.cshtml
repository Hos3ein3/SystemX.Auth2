@page "/admin/p/{projectKey}/applications/detail"
@model SystemX.Auth2.Server.Pages.Admin.Applications.DetailModel
@{
    Layout = "_LayoutAdmin";
    var app = Model.App;
    ViewData["Title"] = $"Application: {app?.Name}";
    var isGlobal = Model.IsGlobalAdmin;
}

<div class="max-w-4xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <div class="flex items-center space-x-2 text-sm text-gray-500 dark:text-gray-400">
            <a href="/admin/p/@Model.ProjectKey/applications" class="hover:underline">Applications</a>
            <span>/</span>
            <span class="text-gray-900 dark:text-gray-100 font-medium">@app?.Name</span>
        </div>
        <div class="flex items-center space-x-2">
            <a2-link-button href="/admin/p/@Model.ProjectKey/applications/messaging?id=@app?.Id" variant="secondary">
                Email & SMS Delivery
            </a2-link-button>
            <a2-link-button href="/admin/p/@Model.ProjectKey/applications/setup?id=@app?.Id" variant="secondary">
                View Setup Snippets
            </a2-link-button>
            <form method="post" asp-page-handler="Delete" data-confirm="Delete this application permanently? All tokens and authorizations will be revoked.">
                <a2-button type="submit" variant="danger">Delete</a2-button>
            </form>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.RotatedSecret))
    {
        <a2-card title="New Secret Generated">
            <a2-secret-once secret="@Model.RotatedSecret" />
        </a2-card>
    }

    <!-- App Header -->
    <div class="bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 p-6 shadow-sm">
        <div class="flex items-center justify-between mb-2">
            <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">@app?.Name</h1>
            <div>
                @if (app?.IsEnabled == true)
                {
                    <a2-badge variant="success">Enabled</a2-badge>
                }
                else
                {
                    <a2-badge variant="neutral">Disabled</a2-badge>
                }
            </div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-4 pt-4 border-t border-gray-100 dark:border-gray-700 text-sm">
            <div>
                <span class="block text-gray-500 dark:text-gray-400 font-medium">Client ID</span>
                <span class="font-mono text-gray-900 dark:text-gray-100 select-all">@app?.ClientId</span>
            </div>
            <div>
                <span class="block text-gray-500 dark:text-gray-400 font-medium">Created</span>
                <span class="text-gray-900 dark:text-gray-100">@app?.CreatedAtUtc.ToString("g")</span>
            </div>
        </div>
    </div>

    <!-- Edit Application Settings -->
    <a2-card title="Configuration & Security">
        <form method="post" asp-page-handler="Update" asp-route-projectKey="@Model.ProjectKey" asp-route-id="@Model.Id" class="space-y-6">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="@Model.Id" />
            <div class="space-y-4">
                <a2-field label="Application Name" required="true">
                    <a2-input name="Input.Name" value="@Model.Input.Name" required="true" />
                </a2-field>

                @if (Model.IsGlobalAdmin)
                {
                    <a2-field label="Application type" hint="Web, Api, Service or Other. A client may set it from Program.cs when the project allows it.">
                        <a2-select name="Input.ApplicationType" class="block w-full rounded-md border-gray-300 text-sm">
                            @foreach (var t in Enum.GetValues<SystemX.Auth2.Contracts.Enums.ApplicationType>())
                            {
                                <option value="@t" selected="@(t == Model.Input.ApplicationType)">@t</option>
                            }
                        </a2-select>
                    </a2-field>
                    <a2-field label="Web server address" hint="Where the Server reaches this application. Used for health checks. Empty clears it.">
                        <a2-input name="Input.WebServerUrl" value="@Model.Input.WebServerUrl" placeholder="https://shop.example.com" />
                    </a2-field>
                    <a2-checkbox name="Input.AllowClientToSetWebServerUrl" checked="@Model.Input.AllowClientToSetWebServerUrl" label="Client may set the web server address and type" description="On: the application's Program.cs can announce them in its handshake and they replace the stored ones. Off: only a global admin changes them." />
                }
                else
                {
                    <p class="text-sm text-gray-600">Type: <b>@Model.Input.ApplicationType</b> · Web server address: <b>@(Model.Input.WebServerUrl ?? "not set")</b> · Client may set them: <b>@(Model.Input.AllowClientToSetWebServerUrl ? "yes" : "no")</b></p>
                }

                <a2-checkbox name="Input.IsEnabled" checked="@Model.Input.IsEnabled" label="Application is enabled" description="When disabled, client credentials and tokens for this application are revoked." />

                <a2-field label="Redirect URIs" hint="One per line. Allowed callback URIs for this client.">
                    <a2-textarea name="Input.RedirectUris" value="@Model.Input.RedirectUris" rows="3" />
                </a2-field>

                <a2-field label="Post-Logout Redirect URIs" hint="One per line. Allowed targets after signing out.">
                    <a2-textarea name="Input.PostLogoutUris" value="@Model.Input.PostLogoutUris" rows="2" />
                </a2-field>

                <a2-field label="Allowed Scopes" hint="Scopes this client may request. Click &times; to delete a tag, or type and press Enter to add.">
                    <div class="a2-tags-field" data-tags-input="Input_AllowedScopes">
                        <input type="hidden" id="Input_AllowedScopes" name="Input.AllowedScopes" value="@Model.Input.AllowedScopes" />
                        <div class="flex flex-wrap items-center gap-2 p-2 rounded-[var(--a2-radius,0.375rem)] border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 min-h-[44px] focus-within:ring-2 focus-within:ring-blue-500 focus-within:border-blue-500">
                            <div class="a2-tags-list flex flex-wrap gap-1.5">
                                @{
                                    var scopes = (Model.Input.AllowedScopes ?? "").Split([' ', ',', '\r', '\n'], StringSplitOptions.RemoveEmptyEntries);
                                    foreach (var sc in scopes)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-medium bg-blue-50 text-blue-700 dark:bg-blue-900/50 dark:text-blue-200 border border-blue-200 dark:border-blue-700" data-tag="@sc">
                                            <span>@sc</span>
                                            <button type="button" class="text-blue-400 hover:text-blue-600 dark:hover:text-blue-100 font-bold ml-0.5 cursor-pointer" data-remove-tag aria-label="Remove @sc">&times;</button>
                                        </span>
                                    }
                                }
                            </div>
                            <input type="text" class="a2-tags-add-input flex-1 min-w-[140px] bg-transparent text-sm text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 border-none outline-none focus:ring-0 p-1" placeholder="Type scope and press Enter..." />
                        </div>
                    </div>
                </a2-field>
            </div>

            <!-- Client Application Settings Overrides -->
            <div class="pt-4 border-t border-gray-200 dark:border-gray-700 space-y-4">
                <h4 class="text-sm font-semibold text-gray-800 dark:text-gray-200">Application Overrides (Domain.Settings)</h4>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <a2-field label="UI Mode" hint="Leave as Default to inherit project settings.">
                        <select name="Input.UiMode" class="block w-full rounded-[var(--a2-radius,0.375rem)] border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-sm text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-1 focus:ring-blue-500">
                            <option value="" selected="@(Model.Input.UiMode == null ? "selected" : null)">Default (Inherit from Project)</option>
                            <option value="Hosted" selected="@(Model.Input.UiMode == SystemX.Auth2.Contracts.Enums.UiMode.Hosted ? "selected" : null)">Hosted (Auth2 handles UI)</option>
                            <option value="Self" selected="@(Model.Input.UiMode == SystemX.Auth2.Contracts.Enums.UiMode.Self ? "selected" : null)">Self (Application renders custom UI)</option>
                            <option value="None" selected="@(Model.Input.UiMode == SystemX.Auth2.Contracts.Enums.UiMode.None ? "selected" : null)">None (API / Machine)</option>
                        </select>
                    </a2-field>

                    <div class="pt-6">
                        <a2-checkbox name="Input.AllowSelfUiLogin" checked="@Model.Input.AllowSelfUiLogin" label="Allow Self-UI Direct Login" description="Enables password grant and two-factor direct grant for Self UI." />
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
                    <a2-field label="Access Token (Minutes)" hint="Null = Project default">
                        <a2-input name="Input.AccessTokenMinutes" type="number" value="@Model.Input.AccessTokenMinutes?.ToString()" />
                    </a2-field>

                    <a2-field label="Refresh Token (Days)" hint="Null = Project default">
                        <a2-input name="Input.RefreshTokenDays" type="number" value="@Model.Input.RefreshTokenDays?.ToString()" />
                    </a2-field>

                    <a2-field label="Identity Token (Minutes)" hint="Null = Project default">
                        <a2-input name="Input.IdentityTokenMinutes" type="number" value="@Model.Input.IdentityTokenMinutes?.ToString()" />
                    </a2-field>

                    <a2-field label="Cookie Lifetime (Minutes)" hint="Null = Project default">
                        <a2-input name="Input.CookieLifetimeMinutes" type="number" value="@Model.Input.CookieLifetimeMinutes?.ToString()" />
                    </a2-field>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
                    <a2-field label="Allowed CORS Origins" hint="One per line. Absolute http(s) origins allowed to make browser requests.">
                        <a2-textarea name="Input.AllowedCorsOrigins" value="@Model.Input.AllowedCorsOrigins" rows="2" placeholder="http://localhost:5101" />
                    </a2-field>

                    <a2-field label="Consent Mode">
                        <select name="Input.ConsentMode" class="block w-full rounded-[var(--a2-radius,0.375rem)] border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-sm text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-1 focus:ring-blue-500 disabled:bg-gray-100 dark:disabled:bg-gray-900 disabled:opacity-60">
                            <option value="" selected="@(Model.Input.ConsentMode == null ? "selected" : null)">Default (Inherit from Project)</option>
                            <option value="Implicit" selected="@(Model.Input.ConsentMode == SystemX.Auth2.Contracts.Enums.ConsentMode.Implicit ? "selected" : null)">Implicit (Auto-grant)</option>
                            <option value="Explicit" selected="@(Model.Input.ConsentMode == SystemX.Auth2.Contracts.Enums.ConsentMode.Explicit ? "selected" : null)">Explicit (User consent prompt)</option>
                        </select>
                    </a2-field>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
                    <a2-field label="Send Confirmation Email" hint="Override project registration rule for this app.">
                        <select name="Input.SendConfirmationEmail" class="block w-full rounded-[var(--a2-radius,0.375rem)] border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-sm text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-1 focus:ring-blue-500">
                            <option value="" selected="@(Model.Input.SendConfirmationEmail == null ? "selected" : null)">Default (Inherit from Project)</option>
                            <option value="true" selected="@(Model.Input.SendConfirmationEmail == true ? "selected" : null)">Always Send Email Confirmation</option>
                            <option value="false" selected="@(Model.Input.SendConfirmationEmail == false ? "selected" : null)">Do Not Send Email Confirmation</option>
                        </select>
                    </a2-field>

                    <a2-field label="Send Confirmation SMS" hint="Override project registration rule for this app.">
                        <select name="Input.SendConfirmationSMS" class="block w-full rounded-[var(--a2-radius,0.375rem)] border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-sm text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-1 focus:ring-blue-500">
                            <option value="" selected="@(Model.Input.SendConfirmationSMS == null ? "selected" : null)">Default (Inherit from Project)</option>
                            <option value="true" selected="@(Model.Input.SendConfirmationSMS == true ? "selected" : null)">Always Send SMS Confirmation</option>
                            <option value="false" selected="@(Model.Input.SendConfirmationSMS == false ? "selected" : null)">Do Not Send SMS Confirmation</option>
                        </select>
                    </a2-field>
                </div>

                <div class="pt-2">
                    <a2-field label="Allowed External Identity Providers" hint="Comma-separated list of provider keys (e.g. google, github). Leave empty to show all enabled project providers.">
                        <a2-input name="Input.ExternalProviders" value="@Model.Input.ExternalProviders" placeholder="google, github, microsoft" />
                    </a2-field>
                    @if (Model.AvailableProviders.Count > 0)
                    {
                        <div class="mt-1 text-xs text-gray-500 dark:text-gray-400">
                            Configured project providers:
                            <span class="font-mono text-gray-700 dark:text-gray-300">
                                @string.Join(", ", Model.AvailableProviders.Select(p => p.Name))
                            </span>
                        </div>
                    }
                </div>
            </div>

            <div class="pt-4 border-t border-gray-200 dark:border-gray-700 flex justify-end">
                <a2-button type="submit" variant="primary">
                    Save Changes
                </a2-button>
            </div>
        </form>
    </a2-card>

    <!-- Credentials & Secret Rotation -->
    <a2-card title="Credentials & Secrets">
        <div class="flex items-center justify-between">
            <div>
                <h4 class="text-sm font-semibold text-gray-800 dark:text-gray-200">Rotate Client Secret</h4>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">
                    Generating a new secret invalidates the existing client secret immediately.
                </p>
            </div>
            <form method="post" asp-page-handler="RotateSecret" asp-route-projectKey="@Model.ProjectKey" asp-route-id="@Model.Id" data-confirm="Rotate client secret now? Any existing application relying on the old secret will need to be updated.">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" value="@Model.Id" />
                <a2-button type="submit" variant="secondary">
                    Rotate Secret Now
                </a2-button>
            </form>
        </div>
    </a2-card>
</div>
