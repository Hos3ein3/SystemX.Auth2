                            <span data-btn-text>Click to Toggle Loading State</span>
                        </button>
                    </div>
                </div>
            </a2-card>

            <!-- 2. Spinners & Progress Loaders -->
            <a2-card title="Spinners (<a2-spinner>) & Progress">
                <div class="space-y-4">
                    <p class="text-xs text-gray-500 dark:text-gray-400">Reusable spinner TagHelper in various dimensions and colors.</p>
