@page "/admin/p/{projectKey}/assignments"
@model SystemX.Auth2.Server.Pages.Admin.Assignments.IndexModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = $"Access Assignments - {Model.CurrentProject?.Name}";
    var activeTab = Model.Tab?.ToLowerInvariant() switch
    {
        "role_permissions" => "role_permissions",
        "user_groups" => "user_groups",
        "group_roles" => "group_roles",
        "group_permissions" => "group_permissions",
        _ => "user_permissions"
    };

    string TabClass(string tab) => tab == activeTab
        ? "border-[var(--a2-color-primary,#2563eb)] text-[var(--a2-color-primary,#2563eb)] dark:border-blue-400 dark:text-blue-400 font-semibold"
        : "border-transparent text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200 hover:border-gray-300 dark:hover:border-gray-600";
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Access Assignments & Matrix</h1>
            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
                Manage direct relations between users, roles, groups, and permissions in @Model.CurrentProject?.Name.
            </p>
        </div>
        <div>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-blue-50 text-blue-800 dark:bg-blue-900/40 dark:text-blue-300 border border-blue-200 dark:border-blue-700">
                Project ID: @Model.CurrentProject?.Id
            </span>
        </div>
    </div>

    <!-- Tab Navigation -->
    <div class="border-b border-gray-200 dark:border-gray-700">
        <nav class="-mb-px flex space-x-6 overflow-x-auto text-sm" aria-label="Tabs">
            <a href="/admin/p/@Model.ProjectKey/assignments?tab=user_permissions" class="whitespace-nowrap py-3 px-1 border-b-2 @TabClass("user_permissions")">
                User Permissions (@Model.UserPermissions.Count)
            </a>
            <a href="/admin/p/@Model.ProjectKey/assignments?tab=role_permissions" class="whitespace-nowrap py-3 px-1 border-b-2 @TabClass("role_permissions")">
                Role Permissions (@Model.RolePermissions.Count)
            </a>
            <a href="/admin/p/@Model.ProjectKey/assignments?tab=user_groups" class="whitespace-nowrap py-3 px-1 border-b-2 @TabClass("user_groups")">
                User Groups (@Model.UserGroups.Count)
            </a>
            <a href="/admin/p/@Model.ProjectKey/assignments?tab=group_roles" class="whitespace-nowrap py-3 px-1 border-b-2 @TabClass("group_roles")">
                Group Roles (@Model.GroupRoles.Count)
            </a>
            <a href="/admin/p/@Model.ProjectKey/assignments?tab=group_permissions" class="whitespace-nowrap py-3 px-1 border-b-2 @TabClass("group_permissions")">
                Group Permissions (@Model.GroupPermissions.Count)
            </a>
        </nav>
    </div>

    <!-- Search Bar -->
    <div class="flex items-center justify-between">
        <form method="get" class="flex items-center gap-2 max-w-sm w-full">
            <input type="hidden" name="tab" value="@activeTab" />
            <input type="text" name="search" value="@Model.Search" placeholder="Filter current tab..." class="block w-full rounded-[var(--a2-radius,0.375rem)] border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-sm text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-1 focus:ring-blue-500" />
            <a2-button type="submit" variant="secondary">Filter</a2-button>
            @if (!string.IsNullOrEmpty(Model.Search))
            {
                <a href="/admin/p/@Model.ProjectKey/assignments?tab=@activeTab" class="text-xs text-gray-500 dark:text-gray-400 hover:underline">Clear</a>
            }
        </form>
    </div>

    @* ==========================================
       TAB 1: User Permissions (user_permissions)
       ========================================== *@
    @if (activeTab == "user_permissions")
    {
        <a2-card title="Assign Permission to User">
            <form method="post" asp-page-handler="GrantUserPermission" class="space-y-4">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">User</label>
                        <div class="space-y-2">
                            <select name="userIdentifier" class="block w-full rounded-[var(--a2-radius,0.375rem)] border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-sm text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-1 focus:ring-blue-500">
                                <option value="">-- Select User --</option>
                                @foreach (var u in Model.AvailableUsers)
                                {
                                    <option value="@u.Id">@u.UserName @(string.IsNullOrWhiteSpace(u.DisplayName) ? "" : $"({u.DisplayName})")</option>
                                }
                            </select>
                            <input type="text" name="userIdentifierManual" placeholder="Or type username, email, or user GUID..." class="block w-full rounded-[var(--a2-radius,0.375rem)] border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-xs text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-1 focus:ring-blue-500" />
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Permission</label>
                        <div class="space-y-2">
                            <select name="permissionKey" class="block w-full rounded-[var(--a2-radius,0.375rem)] border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-sm text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-1 focus:ring-blue-500">
                                <option value="">-- Select Permission --</option>
                                @foreach (var p in Model.AvailablePermissions)
                                {
                                    <option value="@p.Key">@p.Key @(p.ProjectId != Model.CurrentProject?.Id ? "(Global)" : "")</option>
                                }
                            </select>
                            <input type="text" name="permissionKeyManual" placeholder="Or type permission key (e.g. orders.read)..." class="block w-full rounded-[var(--a2-radius,0.375rem)] border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-xs text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-1 focus:ring-blue-500" />
                        </div>
                    </div>
                </div>
                <div class="flex justify-end pt-2">
                    <a2-button type="submit" variant="primary">Grant Permission</a2-button>
                </div>
            </form>
        </a2-card>

        <div class="overflow-x-auto rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 shadow-sm">
            <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700 text-sm">
                <thead class="bg-gray-50 dark:bg-gray-900/60">
                    <tr>
                        <th class="px-6 py-3 text-left font-semibold text-gray-700 dark:text-gray-300">User</th>
                        <th class="px-6 py-3 text-left font-semibold text-gray-700 dark:text-gray-300">Permission Key</th>
                        <th class="px-6 py-3 text-left font-semibold text-gray-700 dark:text-gray-300">Granted At</th>
                        <th class="px-6 py-3 text-right font-semibold text-gray-700 dark:text-gray-300">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                    @if (Model.UserPermissions.Count == 0)
                    {
                        <tr>
                            <td colspan="4" class="px-6 py-8 text-center text-gray-500 dark:text-gray-400">No user permissions assigned.</td>
                        </tr>
                    }
                    @foreach (var up in Model.UserPermissions)
                    {
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                            <td class="px-6 py-3.5 text-gray-900 dark:text-gray-100 font-medium">
                                <a href="/admin/p/@Model.ProjectKey/users/detail?id=@up.UserId" class="text-blue-600 dark:text-blue-400 hover:underline">
                                    @up.UserName @(string.IsNullOrWhiteSpace(up.DisplayName) ? "" : $"({up.DisplayName})")
                                </a>
                            </td>
                            <td class="px-6 py-3.5 font-mono text-xs text-blue-700 dark:text-blue-400">@up.PermissionKey</td>
                            <td class="px-6 py-3.5 text-gray-500 dark:text-gray-400 text-xs">@up.GrantedAtUtc.ToString("g")</td>
                            <td class="px-6 py-3.5 text-right">
                                <form method="post" asp-page-handler="RevokeUserPermission" asp-route-userId="@up.UserId" asp-route-permissionKey="@up.PermissionKey" class="inline">
                                    <button type="button" data-assignment-remove-trigger data-title="Revoke Permission" data-message="Revoke permission '@up.PermissionKey' from @up.UserName?" class="text-xs text-red-600 dark:text-red-400 hover:underline font-medium">Revoke</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @* ==========================================
       TAB 2: Role Permissions (role_permissions)
       ========================================== *@
    @if (activeTab == "role_permissions")
    {
        <a2-card title="Assign Permission to Role">
            <form method="post" asp-page-handler="AddRolePermission" class="space-y-4">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Role</label>
                        <div class="space-y-2">
                            <select name="roleName" class="block w-full rounded-[var(--a2-radius,0.375rem)] border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-sm text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-1 focus:ring-blue-500">
                                <option value="">-- Select Role --</option>
                                @foreach (var r in Model.AvailableRoles)
                                {
                                    <option value="@r.Name">@r.Name @(r.ProjectId == null ? "(Global)" : "")</option>
                                }
                            </select>
                            <input type="text" name="roleNameManual" placeholder="Or type role name manually..." class="block w-full rounded-[var(--a2-radius,0.375rem)] border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-xs text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-1 focus:ring-blue-500" />
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Permission</label>
                        <div class="space-y-2">
                            <select name="permissionKey" class="block w-full rounded-[var(--a2-radius,0.375rem)] border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-sm text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-1 focus:ring-blue-500">
                                <option value="">-- Select Permission --</option>
                                @foreach (var p in Model.AvailablePermissions)
                                {
                                    <option value="@p.Key">@p.Key @(p.ProjectId != Model.CurrentProject?.Id ? "(Global)" : "")</option>
                                }
                            </select>
                            <input type="text" name="permissionKeyManual" placeholder="Or type permission key (e.g. orders.read)..." class="block w-full rounded-[var(--a2-radius,0.375rem)] border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-xs text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-1 focus:ring-blue-500" />
                        </div>
                    </div>
                </div>
                <div class="flex justify-end pt-2">
                    <a2-button type="submit" variant="primary">Assign to Role</a2-button>
                </div>
            </form>
        </a2-card>

        <div class="overflow-x-auto rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 shadow-sm">
            <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700 text-sm">
                <thead class="bg-gray-50 dark:bg-gray-900/60">
                    <tr>
                        <th class="px-6 py-3 text-left font-semibold text-gray-700 dark:text-gray-300">Role</th>
                        <th class="px-6 py-3 text-left font-semibold text-gray-700 dark:text-gray-300">Permission Key</th>
                        <th class="px-6 py-3 text-right font-semibold text-gray-700 dark:text-gray-300">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                    @if (Model.RolePermissions.Count == 0)
                    {
                        <tr>
                            <td colspan="3" class="px-6 py-8 text-center text-gray-500 dark:text-gray-400">No role permissions assigned.</td>
                        </tr>
                    }
                    @foreach (var rp in Model.RolePermissions)
                    {
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                            <td class="px-6 py-3.5 text-gray-900 dark:text-gray-100 font-medium">
                                <a href="/admin/p/@Model.ProjectKey/roles/detail?name=@rp.RoleName" class="text-blue-600 dark:text-blue-400 hover:underline">
                                    @rp.RoleName
                                </a>
                            </td>
                            <td class="px-6 py-3.5 font-mono text-xs text-blue-700 dark:text-blue-400">@rp.PermissionKey</td>
                            <td class="px-6 py-3.5 text-right">
                                <form method="post" asp-page-handler="RemoveRolePermission" asp-route-roleName="@rp.RoleName" asp-route-permissionKey="@rp.PermissionKey" class="inline">
                                    <button type="button" data-assignment-remove-trigger data-title="Remove Permission from Role" data-message="Remove permission '@rp.PermissionKey' from role '@rp.RoleName'?" class="text-xs text-red-600 dark:text-red-400 hover:underline font-medium">Remove</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @* ==========================================
       TAB 3: User Groups (user_groups)
       ========================================== *@
    @if (activeTab == "user_groups")
    {
        <a2-card title="Add User to Group">
            <form method="post" asp-page-handler="AddUserGroup" class="space-y-4">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">User</label>
                        <div class="space-y-2">
                            <select name="userIdentifier" class="block w-full rounded-[var(--a2-radius,0.375rem)] border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-sm text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-1 focus:ring-blue-500">
                                <option value="">-- Select User --</option>
                                @foreach (var u in Model.AvailableUsers)
                                {
                                    <option value="@u.Id">@u.UserName @(string.IsNullOrWhiteSpace(u.DisplayName) ? "" : $"({u.DisplayName})")</option>
                                }
                            </select>
                            <input type="text" name="userIdentifierManual" placeholder="Or type username, email, or user ID..." class="block w-full rounded-[var(--a2-radius,0.375rem)] border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-xs text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-1 focus:ring-blue-500" />
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Target Group</label>
                        <select name="groupName" required class="block w-full rounded-[var(--a2-radius,0.375rem)] border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-sm text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-1 focus:ring-blue-500">
                            <option value="">-- Select Group --</option>
                            @foreach (var g in Model.AvailableGroups)
                            {
                                <option value="@g.Name">@g.Name @(string.IsNullOrWhiteSpace(g.DisplayName) ? "" : $"({g.DisplayName})")</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="flex justify-end pt-2">
                    <a2-button type="submit" variant="primary">Add to Group</a2-button>
                </div>
            </form>
        </a2-card>

        <div class="overflow-x-auto rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 shadow-sm">
            <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700 text-sm">
                <thead class="bg-gray-50 dark:bg-gray-900/60">
                    <tr>
                        <th class="px-6 py-3 text-left font-semibold text-gray-700 dark:text-gray-300">User</th>
                        <th class="px-6 py-3 text-left font-semibold text-gray-700 dark:text-gray-300">Group Name</th>
                        <th class="px-6 py-3 text-right font-semibold text-gray-700 dark:text-gray-300">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                    @if (Model.UserGroups.Count == 0)
                    {
                        <tr>
                            <td colspan="3" class="px-6 py-8 text-center text-gray-500 dark:text-gray-400">No user group memberships assigned.</td>
                        </tr>
                    }
                    @foreach (var ug in Model.UserGroups)
                    {
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                            <td class="px-6 py-3.5 text-gray-900 dark:text-gray-100 font-medium">
                                <a href="/admin/p/@Model.ProjectKey/users/detail?id=@ug.UserId" class="text-blue-600 dark:text-blue-400 hover:underline">
                                    @ug.UserName @(string.IsNullOrWhiteSpace(ug.DisplayName) ? "" : $"({ug.DisplayName})")
                                </a>
                            </td>
                            <td class="px-6 py-3.5 font-medium text-gray-800 dark:text-gray-200">
                                <a href="/admin/p/@Model.ProjectKey/groups/detail?name=@ug.GroupName" class="text-blue-600 dark:text-blue-400 hover:underline">
                                    @ug.GroupName @(string.IsNullOrWhiteSpace(ug.GroupDisplayName) ? "" : $"({ug.GroupDisplayName})")
                                </a>
                            </td>
                            <td class="px-6 py-3.5 text-right">
                                <form method="post" asp-page-handler="RemoveUserGroup" asp-route-userId="@ug.UserId" asp-route-groupName="@ug.GroupName" class="inline">
                                    <button type="button" data-assignment-remove-trigger data-title="Remove User from Group" data-message="Remove user '@ug.UserName' from group '@ug.GroupName'?" class="text-xs text-red-600 dark:text-red-400 hover:underline font-medium">Remove Member</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @* ==========================================
       TAB 4: Group Roles (group_roles)
       ========================================== *@
    @if (activeTab == "group_roles")
    {
        <a2-card title="Assign Role to Group">
            <form method="post" asp-page-handler="AddGroupRole" class="space-y-4">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Group</label>
                        <select name="groupName" required class="block w-full rounded-[var(--a2-radius,0.375rem)] border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-sm text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-1 focus:ring-blue-500">
                            <option value="">-- Select Group --</option>
                            @foreach (var g in Model.AvailableGroups)
                            {
                                <option value="@g.Name">@g.Name @(string.IsNullOrWhiteSpace(g.DisplayName) ? "" : $"({g.DisplayName})")</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Role</label>
                        <div class="space-y-2">
                            <select name="roleName" class="block w-full rounded-[var(--a2-radius,0.375rem)] border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-sm text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-1 focus:ring-blue-500">
                                <option value="">-- Select Role --</option>
                                @foreach (var r in Model.AvailableRoles)
                                {
                                    <option value="@r.Name">@r.Name @(r.ProjectId == null ? "(Global)" : "")</option>
                                }
                            </select>
                            <input type="text" name="roleNameManual" placeholder="Or type role name manually..." class="block w-full rounded-[var(--a2-radius,0.375rem)] border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-xs text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-1 focus:ring-blue-500" />
                        </div>
                    </div>
                </div>
                <div class="flex justify-end pt-2">
                    <a2-button type="submit" variant="primary">Assign Role to Group</a2-button>
                </div>
            </form>
        </a2-card>

        <div class="overflow-x-auto rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 shadow-sm">
            <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700 text-sm">
                <thead class="bg-gray-50 dark:bg-gray-900/60">
                    <tr>
                        <th class="px-6 py-3 text-left font-semibold text-gray-700 dark:text-gray-300">Group Name</th>
                        <th class="px-6 py-3 text-left font-semibold text-gray-700 dark:text-gray-300">Assigned Role</th>
                        <th class="px-6 py-3 text-right font-semibold text-gray-700 dark:text-gray-300">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                    @if (Model.GroupRoles.Count == 0)
                    {
                        <tr>
                            <td colspan="3" class="px-6 py-8 text-center text-gray-500 dark:text-gray-400">No group roles assigned.</td>
                        </tr>
                    }
                    @foreach (var gr in Model.GroupRoles)
                    {
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                            <td class="px-6 py-3.5 text-gray-900 dark:text-gray-100 font-medium">
                                <a href="/admin/p/@Model.ProjectKey/groups/detail?name=@gr.GroupName" class="text-blue-600 dark:text-blue-400 hover:underline">
                                    @gr.GroupName @(string.IsNullOrWhiteSpace(gr.GroupDisplayName) ? "" : $"({gr.GroupDisplayName})")
                                </a>
                            </td>
                            <td class="px-6 py-3.5 font-medium text-gray-800 dark:text-gray-200">
                                <a href="/admin/p/@Model.ProjectKey/roles/detail?name=@gr.RoleName" class="text-blue-600 dark:text-blue-400 hover:underline">
                                    @gr.RoleName
                                </a>
                            </td>
                            <td class="px-6 py-3.5 text-right">
                                <form method="post" asp-page-handler="RemoveGroupRole" asp-route-groupName="@gr.GroupName" asp-route-roleName="@gr.RoleName" class="inline">
                                    <button type="button" data-assignment-remove-trigger data-title="Remove Role from Group" data-message="Remove role '@gr.RoleName' from group '@gr.GroupName'?" class="text-xs text-red-600 dark:text-red-400 hover:underline font-medium">Remove</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @* ==========================================
       TAB 5: Group Permissions (group_permissions)
       ========================================== *@
    @if (activeTab == "group_permissions")
    {
        <a2-card title="Assign Permission to Group">
            <form method="post" asp-page-handler="AddGroupPermission" class="space-y-4">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Group</label>
                        <select name="groupName" required class="block w-full rounded-[var(--a2-radius,0.375rem)] border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-sm text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-1 focus:ring-blue-500">
                            <option value="">-- Select Group --</option>
                            @foreach (var g in Model.AvailableGroups)
                            {
                                <option value="@g.Name">@g.Name @(string.IsNullOrWhiteSpace(g.DisplayName) ? "" : $"({g.DisplayName})")</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Permission</label>
                        <div class="space-y-2">
                            <select name="permissionKey" class="block w-full rounded-[var(--a2-radius,0.375rem)] border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-sm text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-1 focus:ring-blue-500">
                                <option value="">-- Select Permission --</option>
                                @foreach (var p in Model.AvailablePermissions)
                                {
                                    <option value="@p.Key">@p.Key @(p.ProjectId != Model.CurrentProject?.Id ? "(Global)" : "")</option>
                                }
                            </select>
                            <input type="text" name="permissionKeyManual" placeholder="Or type permission key (e.g. orders.read)..." class="block w-full rounded-[var(--a2-radius,0.375rem)] border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-xs text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-1 focus:ring-blue-500" />
                        </div>
                    </div>
                </div>
                <div class="flex justify-end pt-2">
                    <a2-button type="submit" variant="primary">Assign to Group</a2-button>
                </div>
            </form>
        </a2-card>

        <div class="overflow-x-auto rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 shadow-sm">
            <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700 text-sm">
                <thead class="bg-gray-50 dark:bg-gray-900/60">
                    <tr>
                        <th class="px-6 py-3 text-left font-semibold text-gray-700 dark:text-gray-300">Group Name</th>
                        <th class="px-6 py-3 text-left font-semibold text-gray-700 dark:text-gray-300">Permission Key</th>
                        <th class="px-6 py-3 text-right font-semibold text-gray-700 dark:text-gray-300">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                    @if (Model.GroupPermissions.Count == 0)
                    {
                        <tr>
                            <td colspan="3" class="px-6 py-8 text-center text-gray-500 dark:text-gray-400">No group permissions assigned.</td>
                        </tr>
                    }
                    @foreach (var gp in Model.GroupPermissions)
                    {
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                            <td class="px-6 py-3.5 text-gray-900 dark:text-gray-100 font-medium">
                                <a href="/admin/p/@Model.ProjectKey/groups/detail?name=@gp.GroupName" class="text-blue-600 dark:text-blue-400 hover:underline">
                                    @gp.GroupName @(string.IsNullOrWhiteSpace(gp.GroupDisplayName) ? "" : $"({gp.GroupDisplayName})")
                                </a>
                            </td>
                            <td class="px-6 py-3.5 font-mono text-xs text-blue-700 dark:text-blue-400">@gp.PermissionKey</td>
                            <td class="px-6 py-3.5 text-right">
                                <form method="post" asp-page-handler="RemoveGroupPermission" asp-route-groupName="@gp.GroupName" asp-route-permissionKey="@gp.PermissionKey" class="inline">
                                    <button type="button" data-assignment-remove-trigger data-title="Remove Permission from Group" data-message="Remove permission '@gp.PermissionKey' from group '@gp.GroupName'?" class="text-xs text-red-600 dark:text-red-400 hover:underline font-medium">Remove</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <!-- Remove Confirmation Modal -->
    <div id="assignmentRemoveModal" class="hidden fixed inset-0 z-50 overflow-y-auto" aria-labelledby="removeModalTitle" role="dialog" aria-modal="true">
        <div class="fixed inset-0 bg-gray-500/75 dark:bg-gray-900/80 transition-opacity"></div>
        <div class="flex min-h-full items-center justify-center p-4 text-center sm:p-0">
            <div class="relative transform overflow-hidden rounded-lg bg-white dark:bg-gray-800 text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-lg border border-gray-200 dark:border-gray-700">
                <div class="p-6">
                    <div class="flex items-center space-x-3 mb-4">
                        <div class="flex-shrink-0 flex items-center justify-center h-10 w-10 rounded-full bg-red-100 dark:bg-red-900/30 text-red-600 dark:text-red-400">
                            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                            </svg>
                        </div>
                        <div>
                            <h3 id="removeModalTitle" class="text-lg font-bold text-gray-900 dark:text-gray-100">Confirm Revocation</h3>
                            <p class="text-xs text-gray-500 dark:text-gray-400">This action will immediately remove the assignment.</p>
                        </div>
                    </div>
                    <p id="removeModalMessage" class="text-sm text-gray-600 dark:text-gray-300 mb-6">Are you sure you want to remove this assignment?</p>
                    <div class="flex justify-end gap-3">
                        <button type="button" data-assignment-modal-close class="px-4 py-2 text-sm font-medium text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-md hover:bg-gray-50 dark:hover:bg-gray-600">Cancel</button>
                        <button type="button" id="assignmentModalConfirmBtn" class="px-4 py-2 text-sm font-medium text-white bg-red-600 hover:bg-red-700 rounded-md">Remove Assignment</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
