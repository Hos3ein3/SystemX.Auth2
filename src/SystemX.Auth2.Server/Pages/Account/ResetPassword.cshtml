@page
@model SystemX.Auth2.Server.Pages.Account.ResetPasswordModel
@{
    Layout = "_LayoutAuth";
    ViewData["Title"] = "Reset Password";
    ViewData["Subtitle"] = "Choose a new secure password";
}

<form method="post" class="space-y-4">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ReturnUrl" />
    <input type="hidden" asp-for="ClientId" />
    <input type="hidden" asp-for="Login" />
    <input type="hidden" asp-for="Token" />

    <a2-field label="New Password" hint="At least 12 characters recommended" required="true" for="Input_NewPassword">
        <a2-password id="Input_NewPassword" name="Input.NewPassword" placeholder="••••••••••••" required="true" autocomplete="new-password" />
    </a2-field>

    <div>
        <a2-button type="submit" variant="primary" class="w-full">Update Password</a2-button>
    </div>

    <div class="mt-4 text-center text-sm">
        <a href="/Account/Login?ReturnUrl=@Model.ReturnUrl&ClientId=@Model.ClientId" class="font-medium text-[var(--a2-color-primary,#2563eb)] hover:underline">Back to Sign In</a>
    </div>
</form>
