@{
    ViewData["Title"] = "Transfer";
}

<div class="space-y-6 max-w-xl mx-auto">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
        <h1 class="text-2xl font-bold text-gray-900">Transfer</h1>
        <p class="text-sm text-gray-500 mt-1">
            The button posts to an action with <code class="font-mono bg-gray-100 px-1.5 py-0.5 rounded text-xs">[Auth2Totp]</code>. The first time, your browser goes to the Auth2 server, which asks for the
            code of your authenticator app, and comes back to this page. Press the button again: the proof is now in your session.
            You need two-factor turned on (<code class="font-mono bg-gray-100 px-1.5 py-0.5 rounded text-xs">/Manage/TwoFactor/Enable</code> on the Auth2 server); without it the server page tells you how.
        </p>

        <form asp-action="Transfer" method="post" class="mt-4 space-y-3">
            <label class="block text-sm font-medium text-gray-700" for="amount">Amount</label>
            <input id="amount" name="amount" type="number" step="0.01" min="0.01" value="25" required
                   class="block w-full rounded-md border border-gray-300 px-3 py-2 text-sm" />
            <button type="submit" class="inline-flex items-center px-4 py-2 rounded-md bg-indigo-600 text-white text-sm font-medium hover:bg-indigo-700">Send the transfer</button>
        </form>
        <p class="mt-4 text-sm"><a asp-action="Showcase" class="text-indigo-600 hover:underline">&larr; All the demo rules</a></p>
    </div>
</div>
