@page "/admin/p/{projectKey}/components"
@model SystemX.Auth2.Server.Pages.Admin.Components.IndexModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "UI Components Showcase";
}

<div class="space-y-10 pb-16">
    <!-- Page Header -->
    <div class="border-b border-gray-200 dark:border-gray-700 pb-5">
        <h1 class="text-3xl font-extrabold text-gray-900 dark:text-gray-100 tracking-tight">UI Components Showcase</h1>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
            A live catalog of design system components, forms, validation states, tables, navigation, and charts for Auth2 Admin.
        </p>
    </div>

    <!-- 1. Buttons Section -->
    <section class="space-y-4">
        <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100 border-b border-gray-200 dark:border-gray-700 pb-2">Buttons</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <a2-card title="Button Variants">
                <div class="flex flex-wrap gap-3 items-center">
                    <a2-button type="button" variant="primary">Primary Button</a2-button>
                    <a2-button type="button" variant="secondary">Secondary Button</a2-button>
                    <a2-button type="button" variant="danger">Danger Button</a2-button>
                    <button type="button" class="inline-flex items-center px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md text-sm font-medium text-gray-700 dark:text-gray-200 bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-500">
                        Outline Button
                    </button>
                    <button type="button" class="inline-flex items-center px-4 py-2 rounded-md text-sm font-medium text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none">
                        Ghost Button
                    </button>
                    <button type="button" disabled class="inline-flex items-center px-4 py-2 border border-transparent rounded-md text-sm font-medium text-gray-400 dark:text-gray-500 bg-gray-200 dark:bg-gray-700 cursor-not-allowed">
                        Disabled Button
                    </button>
                </div>
            </a2-card>

            <a2-card title="Button Sizes & With Icons">
                <div class="flex flex-wrap gap-3 items-center">
                    <button type="button" class="inline-flex items-center px-2.5 py-1.5 border border-transparent text-xs font-medium rounded text-white bg-blue-600 hover:bg-blue-700 focus:outline-none">
                        Small Button
                    </button>
                    <button type="button" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none">
                        Regular Button
                    </button>
                    <button type="button" class="inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none">
                        Large Button
                    </button>
                    <button type="button" class="inline-flex items-center gap-2 px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                        <span>With Icon</span>
                    </button>
                    <button type="button" class="inline-flex items-center gap-2 px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 opacity-80 cursor-wait">
                        <svg class="animate-spin h-4 w-4 text-white" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                        <span>Loading...</span>
                    </button>
                </div>
            </a2-card>
        </div>
    </section>

    <!-- 2. Inputs & Validation Section -->
    <section class="space-y-4">
        <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100 border-b border-gray-200 dark:border-gray-700 pb-2">Inputs & Validation States</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <a2-card title="Text & Password Inputs">
                <div class="space-y-3">
                    <a2-field label="Standard Text Input" for="demo_text">
                        <a2-input id="demo_text" name="demo_text" placeholder="Enter text here..." />
                    </a2-field>
                    <a2-field label="Password Input with Toggle" for="demo_password">
                        <a2-password id="demo_password" name="demo_password" placeholder="••••••••••••" />
                    </a2-field>
                    <a2-field label="Disabled Input" for="demo_disabled">
                        <input id="demo_disabled" type="text" disabled value="Readonly / Disabled value" class="block w-full rounded-[var(--a2-radius,0.375rem)] border border-gray-300 dark:border-gray-600 bg-gray-100 dark:bg-gray-800/50 px-3 py-2 text-sm text-gray-400 dark:text-gray-500 cursor-not-allowed" />
                    </a2-field>
                </div>
            </a2-card>

            <a2-card title="Validation States">
                <div class="space-y-3">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                            Valid State <span class="text-emerald-500 font-semibold">(Passed)</span>
                        </label>
                        <div class="relative">
                            <input type="text" value="john.doe@example.com" class="block w-full rounded-[var(--a2-radius,0.375rem)] border border-emerald-500 dark:border-emerald-500 bg-white dark:bg-gray-800 px-3 py-2 text-sm text-gray-900 dark:text-gray-100 pr-10 focus:outline-none focus:ring-1 focus:ring-emerald-500" />
                            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3 text-emerald-500">
                                <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                            </div>
                        </div>
                        <p class="mt-1 text-xs text-emerald-600 dark:text-emerald-400">Username is available and valid.</p>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                            Invalid State <span class="text-red-500 font-semibold">(Error)</span>
                        </label>
                        <div class="relative">
                            <input type="text" value="invalid-email@@" class="block w-full rounded-[var(--a2-radius,0.375rem)] border border-red-500 dark:border-red-500 bg-white dark:bg-gray-800 px-3 py-2 text-sm text-red-900 dark:text-red-100 pr-10 focus:outline-none focus:ring-1 focus:ring-red-500" />
                            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3 text-red-500">
                                <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" /></svg>
                            </div>
                        </div>
                        <p class="mt-1 text-xs text-red-600 dark:text-red-400">Please enter a valid email address.</p>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                            Required Field <span class="text-red-500 font-bold">*</span>
                        </label>
                        <input type="text" required placeholder="Required field cannot be empty" class="block w-full rounded-[var(--a2-radius,0.375rem)] border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-sm text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-1 focus:ring-blue-500" />
                    </div>
                </div>
            </a2-card>

            <a2-card title="Textarea & Labels">
                <div class="space-y-3">
                    <div>
                        <div class="flex justify-between items-center mb-1">
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Description</label>
                            <span class="text-xs text-gray-400">Optional</span>
                        </div>
                        <textarea rows="3" placeholder="Enter multi-line notes or description..." class="block w-full rounded-[var(--a2-radius,0.375rem)] border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-sm text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-1 focus:ring-blue-500"></textarea>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                            Label with Helper Badge
                            <span class="ml-1 inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-blue-100 text-blue-800 dark:bg-blue-900/50 dark:text-blue-300">New</span>
                        </label>
                        <input type="text" placeholder="Input with badge label" class="block w-full rounded-[var(--a2-radius,0.375rem)] border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-sm text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-1 focus:ring-blue-500" />
                    </div>
                </div>
            </a2-card>
        </div>
    </section>

    <!-- 3. Checkboxes, Radios & Selects -->
    <section class="space-y-4">
        <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100 border-b border-gray-200 dark:border-gray-700 pb-2">Custom Selects, Checkboxes & Radios</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <a2-card title="Custom Checkboxes & Radios">
                <div class="space-y-4">
                    <!-- Custom Checkboxes via TagHelper -->
                    <div>
                        <span class="block text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-2">Custom Checkboxes (&lt;a2-checkbox&gt;)</span>
                        <div class="space-y-2">
                            <a2-checkbox id="chk_tag_1" name="demo_chk1" checked="true" label="Checked Custom Box" description="Accessible custom checkmark box with SVG tick" />
                            <a2-checkbox id="chk_tag_2" name="demo_chk2" label="Unchecked Custom Box" description="Click to check with custom SVG tick" />
                            <a2-checkbox id="chk_tag_3" name="demo_chk3" disabled="true" label="Disabled State" description="Non-interactive disabled checkbox" />
                        </div>
                    </div>

                    <!-- Custom Standalone Radios via TagHelper -->
                    <div class="pt-3 border-t border-gray-200 dark:border-gray-700">
                        <span class="block text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-2">Custom Radio Buttons (&lt;a2-radio&gt;)</span>
                        <div class="space-y-2">
                            <a2-radio id="rad_tag_1" name="custom_radio_tag" value="primary" checked="true" label="Primary Option (Selected)" />
                            <a2-radio id="rad_tag_2" name="custom_radio_tag" value="secondary" label="Secondary Option" />
                            <a2-radio id="rad_tag_3" name="custom_radio_tag" value="disabled" disabled="true" label="Disabled Option" />
                        </div>
                    </div>

                    <!-- Toggle Switch via TagHelper -->
                    <div class="pt-3 border-t border-gray-200 dark:border-gray-700">
                        <span class="block text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-2">Toggle Switch (&lt;a2-toggle&gt;)</span>
                        <a2-toggle id="sw_demo_1" name="sw_demo" checked="true" label="Toggle Switch" description="Smooth animated state switch" />
                    </div>
                </div>
            </a2-card>

            <a2-card title="Searchable Combobox (&lt;a2-combobox&gt;)">
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Select Role with Search</label>
                        <a2-combobox id="demoRoleSelect" name="role" value="administrator" placeholder="Choose a role..." search-placeholder="Search roles or permissions...">
                            <option value="administrator" selected>Administrator (Global Access)</option>
                            <option value="developer">Developer (Full APIs)</option>
                            <option value="auditor">Compliance Auditor</option>
                            <option value="support">Customer Support Lead</option>
                            <option value="operator">Operations Specialist</option>
                        </a2-combobox>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Select Environment</label>
                        <a2-combobox id="demoEnvSelect" name="environment" value="production" placeholder="Choose environment..." search-placeholder="Filter environments...">
                            <option value="development">Development (Local)</option>
                            <option value="staging">Staging (Pre-Release)</option>
                            <option value="production" selected>Production (Live Cloud)</option>
                            <option value="sandbox">Sandbox / Isolation</option>
                        </a2-combobox>
                    </div>
                    <p class="text-xs text-gray-500 dark:text-gray-400 pt-1">
                        Accessible single-select dropdown with real-time text filter and keyboard focus management.
                    </p>
                </div>
            </a2-card>

            <a2-card title="Searchable Multi-Select (&lt;a2-multiselect&gt;)">
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Select Groups (Multi-Select Tags)</label>
                        <a2-multiselect id="demoGroupsInput" name="groups" values="Alpha Engineering Group,Beta Support Operations" placeholder="Search or add group...">
                            <option value="Alpha Engineering Group">Alpha Engineering Group</option>
                            <option value="Beta Support Operations">Beta Support Operations</option>
                            <option value="Gamma Security Audit">Gamma Security Audit</option>
                            <option value="Delta Financial Analysts">Delta Financial Analysts</option>
                            <option value="Epsilon QA Team">Epsilon QA Team</option>
                        </a2-multiselect>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Assign Permissions</label>
                        <a2-multiselect id="demoPermsInput" name="permissions" values="users.read,roles.manage" placeholder="Search permissions...">
                            <option value="users.read">users.read</option>
                            <option value="users.write">users.write</option>
                            <option value="roles.manage">roles.manage</option>
                            <option value="audit.export">audit.export</option>
                            <option value="keys.rotate">keys.rotate</option>
                        </a2-multiselect>
                    </div>
                    <p class="text-xs text-gray-500 dark:text-gray-400 pt-1">
                        Interactive multi-tag input with inline removal, option selection, and comma-separated value sync.
                    </p>
                </div>
            </a2-card>
        </div>
    </section>

    <!-- 4. Date Picker & Clock Picker -->
    <section class="space-y-4">
        <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100 border-b border-gray-200 dark:border-gray-700 pb-2">Custom Date Picker & Clock Picker</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <a2-card title="Calendar Date Picker (&lt;a2-datepicker&gt;)">
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Pre-selected Date</label>
                        <a2-datepicker id="demo_date_1" name="event_date" value="2026-11-25" placeholder="Pick a date..." />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Empty Date Picker (Interactive)</label>
                        <a2-datepicker id="demo_date_2" name="audit_date" placeholder="Choose inspection date..." />
                    </div>
                    <p class="text-xs text-gray-500 dark:text-gray-400 pt-1">
                        Interactive popup calendar with month/year navigation, quick 'Today' selection, and clear button.
                    </p>
                </div>
            </a2-card>

            <a2-card title="Clock / Time Picker 12h (&lt;a2-timepicker&gt;)">
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Select Expiry Time (12h)</label>
                        <a2-timepicker id="demo_time_1" name="expiry_time" value="02:30 PM" placeholder="Select time..." />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Empty Time Picker</label>
                        <a2-timepicker id="demo_time_2" name="meeting_time" placeholder="HH:MM AM/PM" />
                    </div>
                    <p class="text-xs text-gray-500 dark:text-gray-400 pt-1">
                        Interactive clock picker with hour and minute selectors, AM/PM toggle, and current time shortcut.
                    </p>
                </div>
            </a2-card>

            <a2-card title="Clock / Time Picker 24h & Combined">
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Maintenance Window (24h)</label>
                        <a2-timepicker id="demo_time_24h" name="maint_time" value="18:45" use-24-hours="true" placeholder="HH:MM (24h)" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Audit Start Time (24h)</label>
                        <a2-timepicker id="demo_time_audit" name="audit_time" value="09:00" use-24-hours="true" placeholder="HH:MM (24h)" />
                    </div>
                    <p class="text-xs text-gray-500 dark:text-gray-400 pt-1">
                        Full 24-hour military format selector with quick application and clear buttons.
                    </p>
                </div>
            </a2-card>
        </div>
    </section>

    <!-- 5. Alerts & Toast Notifications -->
    <section class="space-y-4">
        <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100 border-b border-gray-200 dark:border-gray-700 pb-2">Alerts & Toast Notifications</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <a2-card title="Alert Banner Variants (<a2-alert>)">
                <div class="space-y-3">
                    <a2-alert variant="success">Operation completed successfully. Your settings have been applied.</a2-alert>
                    <a2-alert variant="error">Authentication failed. Invalid client secret or token signature.</a2-alert>
                    <a2-alert variant="warning">Two-factor authentication is strongly recommended for administrators.</a2-alert>
                    <a2-alert variant="info">New tenant project configuration is ready for review.</a2-alert>
                </div>
            </a2-card>

            <a2-card title="Toast Notifications (<a2-toast>)">
                <div class="space-y-3">
                    <a2-toast variant="success" title="Success Notification">
                        <span>Project keys rotated and synchronized across nodes.</span>
                    </a2-toast>
                    <a2-toast variant="error" title="Validation Alert">
                        <span>Missing required client redirect URI for PKCE flow.</span>
                    </a2-toast>
                    <a2-toast variant="info" title="System Notice">
                        <span>Automatic database maintenance scheduled for 02:00 UTC.</span>
                    </a2-toast>
                </div>
            </a2-card>
        </div>
    </section>

    <!-- 5. Table with Sorting, Filtering & Pagination -->
    <section class="space-y-4">
        <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100 border-b border-gray-200 dark:border-gray-700 pb-2">Data Table with Search & Pagination</h2>
        <a2-card>
            <div class="space-y-4">
                <!-- Search and Filters Bar -->
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                    <div class="relative max-w-xs w-full">
                        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                            <svg class="h-4 w-4 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
                            </svg>
                        </div>
                        <input type="text" data-table-search="showcaseTable" placeholder="Search table rows..." class="block w-full rounded-[var(--a2-radius,0.375rem)] border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 py-1.5 pl-9 pr-3 text-xs text-gray-900 dark:text-gray-100 placeholder-gray-400 focus:outline-none focus:ring-1 focus:ring-blue-500" />
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-xs text-gray-500 dark:text-gray-400">Status:</span>
                        <select class="rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-xs px-2 py-1 text-gray-700 dark:text-gray-200">
                            <option value="">All Statuses</option>
                            <option value="active">Active</option>
                            <option value="suspended">Suspended</option>
                        </select>
                    </div>
                </div>

                <!-- Table -->
                <div class="overflow-x-auto rounded-lg border border-gray-200 dark:border-gray-700">
                    <table id="showcaseTable" class="min-w-full divide-y divide-gray-200 dark:divide-gray-700 text-sm">
                        <thead class="bg-gray-50 dark:bg-gray-900/60">
                            <tr>
                                <th class="px-6 py-3 text-left font-semibold text-gray-700 dark:text-gray-300 cursor-pointer">
                                    <div class="flex items-center gap-1">
                                        <span>User</span>
                                        <svg class="h-3.5 w-3.5 text-gray-400" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 3a1 1 0 01.707.293l3 3a1 1 0 01-1.414 1.414L10 5.414 7.707 7.707a1 1 0 01-1.414-1.414l3-3A1 1 0 0110 3zm-3.707 9.293a1 1 0 011.414 0L10 14.586l2.293-2.293a1 1 0 011.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
                                    </div>
                                </th>
                                <th class="px-6 py-3 text-left font-semibold text-gray-700 dark:text-gray-300">Email</th>
                                <th class="px-6 py-3 text-left font-semibold text-gray-700 dark:text-gray-300">Role</th>
                                <th class="px-6 py-3 text-left font-semibold text-gray-700 dark:text-gray-300">Status</th>
                                <th class="px-6 py-3 text-right font-semibold text-gray-700 dark:text-gray-300">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                                <td class="px-6 py-3.5 font-medium text-gray-900 dark:text-gray-100">admin</td>
                                <td class="px-6 py-3.5 text-gray-500 dark:text-gray-400">admin@systemx.internal</td>
                                <td class="px-6 py-3.5"><a2-badge variant="info">GlobalAdmin</a2-badge></td>
                                <td class="px-6 py-3.5"><a2-badge variant="success">Active</a2-badge></td>
                                <td class="px-6 py-3.5 text-right"><button type="button" class="text-xs text-blue-600 dark:text-blue-400 hover:underline">Edit</button></td>
                            </tr>
                            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                                <td class="px-6 py-3.5 font-medium text-gray-900 dark:text-gray-100">developer1</td>
                                <td class="px-6 py-3.5 text-gray-500 dark:text-gray-400">dev1@systemx.internal</td>
                                <td class="px-6 py-3.5"><a2-badge variant="neutral">Developer</a2-badge></td>
                                <td class="px-6 py-3.5"><a2-badge variant="success">Active</a2-badge></td>
                                <td class="px-6 py-3.5 text-right"><button type="button" class="text-xs text-blue-600 dark:text-blue-400 hover:underline">Edit</button></td>
                            </tr>
                            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                                <td class="px-6 py-3.5 font-medium text-gray-900 dark:text-gray-100">operator_beta</td>
