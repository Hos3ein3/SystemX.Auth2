@page "/admin/p/{projectKey}/groups/detail"
@model SystemX.Auth2.Server.Pages.Admin.Groups.DetailModel
@{
    Layout = "_LayoutAdmin";
    var g = Model.Group;
    ViewData["Title"] = $"Group: {g?.Name}";
}

<div class="max-w-4xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <div class="flex items-center space-x-2 text-sm text-gray-500">
            <a href="/admin/p/@Model.ProjectKey/groups" class="hover:underline">Groups</a>
            <span>/</span>
            <span class="text-gray-900 font-medium">@g?.Name</span>
        </div>
        <form method="post" asp-page-handler="Delete" onsubmit="return confirm('Are you sure you want to delete this group?');">
            <a2-button type="submit" variant="danger">Delete Group</a2-button>
        </form>
    </div>

    <!-- Group Header Card -->
    <div class="bg-white rounded-lg border border-gray-200 p-6 shadow-sm">
        <div class="flex items-center justify-between mb-2">
            <div>
                <span class="font-mono text-sm text-gray-500 block mb-1">Group Key</span>
                <h1 class="text-2xl font-bold font-mono text-gray-900">@g?.Name</h1>
            </div>
            @if (!string.IsNullOrEmpty(g?.DisplayName))
            {
                <span class="text-lg font-medium text-gray-700">@g.DisplayName</span>
            }
        </div>
        <p class="text-sm text-gray-600 mt-2">@(g?.Description ?? "No description provided.")</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Roles assigned to group -->
        <a2-card title="Group Roles (@g?.Roles.Count)">
            @if (g?.Roles.Count > 0)
            {
                <ul class="divide-y divide-gray-200">
                    @foreach (var role in g.Roles)
                    {
                        <li class="py-2.5 flex items-center justify-between">
                            <span class="text-sm font-semibold text-gray-800">@role</span>
                            <form method="post" asp-page-handler="RemoveRole" asp-route-roleName="@role">
                                <button type="submit" class="text-xs text-red-600 hover:underline">Remove</button>
                            </form>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-sm text-gray-500 py-3">No roles assigned to this group.</p>
            }
        </a2-card>

        <!-- Permissions assigned to group -->
        <a2-card title="Group Permissions (@g?.Permissions.Count)">
            @if (g?.Permissions.Count > 0)
            {
                <div class="flex flex-wrap gap-2">
                    @foreach (var perm in g.Permissions)
                    {
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-mono font-medium bg-blue-50 text-blue-800 border border-blue-200">
                            @perm
                        </span>
                    }
                </div>
            }
            else
            {
                <p class="text-sm text-gray-500 py-3">No direct permissions assigned to this group.</p>
            }
        </a2-card>
    </div>
</div>
