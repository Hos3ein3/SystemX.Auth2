@page "/NotAllowed"
@model SystemX.Auth2.Server.Pages.NotAllowedModel
@{
    Layout = "_LayoutAuth";
    ViewData["Title"] = "Access Not Allowed";
}

<div class="text-center space-y-5">
    <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-red-100 dark:bg-red-900/40 text-red-600 dark:text-red-400">
        <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
    </div>

    <div>
        <span class="text-xs font-semibold text-red-600 dark:text-red-400 uppercase tracking-widest">Error 403</span>
        <h2 class="mt-1 text-2xl font-bold text-gray-900 dark:text-gray-100">Access Not Allowed</h2>
        <p class="mt-2 text-sm text-gray-500 dark:text-gray-400 leading-relaxed">
            You do not have permission to view or access this resource. Please contact your organization administrator if you believe this is in error.
        </p>
    </div>

    <div class="pt-4 flex flex-col sm:flex-row gap-3 justify-center">
        @if (Model.ProjectFound)
        {
            <a2-link-button href="@Model.GetLoginUrl()" variant="primary">
                Back to Sign In
            </a2-link-button>
        }
        <a2-link-button href="/" variant="secondary">
            Return to Home
        </a2-link-button>
    </div>
</div>
