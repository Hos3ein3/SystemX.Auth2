@page "/admin/p/{projectKey}/permissions"
@model SystemX.Auth2.Server.Pages.Admin.Permissions.IndexModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = $"Permissions - {Model.CurrentProject?.Name}";
}

<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Permissions</h1>
            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Catalog of permissions defined for @Model.CurrentProject?.Name.</p>
        </div>
        <a2-link-button href="/admin/p/@Model.ProjectKey/permissions/create" variant="primary">
            + New Permission
        </a2-link-button>
    </div>

    <!-- Filter Form -->
    <form method="get" class="flex flex-wrap items-center gap-3">
        <a2-search name="q" value="@Model.Q" placeholder="Search permissions..."></a2-search>
        <a2-button type="submit" variant="secondary">Search</a2-button>
    </form>

    <div class="overflow-x-auto rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 shadow-sm">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700 text-sm">
            <thead class="bg-gray-50 dark:bg-gray-900/60">
                <tr>
                    <th scope="col" class="px-6 py-3 text-left font-semibold text-gray-700 dark:text-gray-300">Key</th>
                    <th scope="col" class="px-6 py-3 text-left font-semibold text-gray-700 dark:text-gray-300">Display Name</th>
                    <th scope="col" class="px-6 py-3 text-left font-semibold text-gray-700 dark:text-gray-300">Category</th>
                    <th scope="col" class="px-6 py-3 text-left font-semibold text-gray-700 dark:text-gray-300">Status</th>
                    <th scope="col" class="px-6 py-3 text-right font-semibold text-gray-700 dark:text-gray-300">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                @if (Model.Permissions.Count > 0)
                {
                    @foreach (var p in Model.Permissions)
                    {
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                            <td class="px-6 py-4 font-mono text-xs font-semibold text-gray-900 dark:text-gray-100">
                                <a href="/admin/p/@Model.ProjectKey/permissions/detail?key=@p.Key" class="text-blue-600 dark:text-blue-400 hover:underline">
                                    @p.Key
                                </a>
                            </td>
                            <td class="px-6 py-4 text-gray-800 dark:text-gray-200 font-medium">@(p.DisplayName ?? "-")</td>
                            <td class="px-6 py-4 text-gray-500 dark:text-gray-400">@(p.Group ?? "general")</td>
                            <td class="px-6 py-4">
                                @if (p.IsObsolete)
                                {
                                    <a2-badge variant="warning">Obsolete</a2-badge>
                                }
                                else
                                {
                                    <a2-badge variant="success">Active</a2-badge>
                                }
                            </td>
                            <td class="px-6 py-4 text-right space-x-2">
                                <form method="post" asp-page-handler="ToggleObsolete" asp-route-key="@p.Key" asp-route-obsolete="@p.IsObsolete" class="inline">
                                    <button type="submit" class="text-xs text-amber-600 dark:text-amber-400 hover:underline">
                                        @(p.IsObsolete ? "Restore" : "Mark Obsolete")
                                    </button>
                                </form>
                                <span class="text-gray-300 dark:text-gray-600">|</span>
                                <form method="post" asp-page-handler="Delete" asp-route-key="@p.Key" class="inline" data-confirm="Delete permission @p.Key?">
                                    <button type="submit" class="text-xs text-red-600 dark:text-red-400 hover:underline">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="px-6 py-12 text-center text-gray-500 dark:text-gray-400">
                            No permissions found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <a2-pager page="@Model.PageNumber" page-size="@Model.PageSize" total-count="@Model.TotalCount" total-pages="@Model.TotalPages"></a2-pager>
    }
</div>
