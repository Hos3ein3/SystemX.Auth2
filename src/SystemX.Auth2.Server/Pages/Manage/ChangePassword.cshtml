@page
@model SystemX.Auth2.Server.Pages.Manage.ChangePasswordModel
@{
    Layout = "_LayoutAccount";
    ViewData["Title"] = "Change Password";
}

<div class="space-y-6 max-w-xl">
    <div>
        <h2 class="text-xl font-bold text-gray-900">Change Password</h2>
        <p class="mt-1 text-sm text-gray-500">Ensure your account uses a strong, unique password.</p>
    </div>

    @if (Model.Changed)
    {
        <a2-alert variant="success">
            Your password has been changed successfully.
        </a2-alert>
    }

    <a2-card>
        <form method="post" class="space-y-4">
            <a2-field label="Current password" required="true">
                <a2-password name="Input.CurrentPassword" required="true" autocomplete="current-password" />
            </a2-field>

            <a2-field label="New password" required="true" hint="Must meet project password complexity rules.">
                <a2-password name="Input.NewPassword" required="true" autocomplete="new-password" />
            </a2-field>

            <div class="pt-2">
                <a2-button type="submit" variant="primary">
                    Update Password
                </a2-button>
            </div>
        </form>
    </a2-card>
</div>
