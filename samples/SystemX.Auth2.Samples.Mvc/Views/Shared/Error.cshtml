@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="bg-red-50 border border-red-200 text-red-800 rounded-lg p-6 max-w-xl mx-auto shadow-sm">
    <h1 class="text-2xl font-bold mb-2">An error occurred</h1>
    <p class="text-gray-700 mb-4">An error occurred while processing your request.</p>

    @if (Model.ShowRequestId)
    {
        <p class="text-sm text-gray-500 font-mono">
            <strong>Request ID:</strong> <code>@Model.RequestId</code>
        </p>
    }
</div>
