@page "/admin/p/{projectKey}/authorizations"
@model SystemX.Auth2.Server.Pages.Admin.Authorizations.IndexModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = $"Authorizations - {Model.CurrentProject?.Name}";
}

<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">OAuth Authorizations</h1>
            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Granted consent tokens and application authorizations for @Model.CurrentProject?.Name.</p>
        </div>
    </div>

    <!-- Filter Form -->
    <form method="get" class="flex flex-wrap items-center gap-3">
        <a2-search name="q" value="@Model.Q" placeholder="Search by subject ID..."></a2-search>
        <select name="status" data-autosubmit class="rounded-[var(--a2-radius,0.375rem)] border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-sm text-gray-700 dark:text-gray-200 focus:outline-none focus:ring-1 focus:ring-blue-500">
            <option value="">All Statuses</option>
            <option value="valid" selected="@(Model.Status == "valid" ? "selected" : null)">Valid</option>
            <option value="revoked" selected="@(Model.Status == "revoked" ? "selected" : null)">Revoked</option>
        </select>
        <a2-page-size value="@Model.PageSize"></a2-page-size>
        <a2-button type="submit" variant="secondary">Filter</a2-button>
    </form>

    <div class="overflow-x-auto rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 shadow-sm">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700 text-sm">
            <thead class="bg-gray-50 dark:bg-gray-900/60">
                <tr>
                    <th scope="col" class="px-6 py-3 text-left font-semibold text-gray-700 dark:text-gray-300">Authorization ID</th>
                    <th scope="col" class="px-6 py-3 text-left font-semibold text-gray-700 dark:text-gray-300">User</th>
                    <th scope="col" class="px-6 py-3 text-left font-semibold text-gray-700 dark:text-gray-300">Status</th>
                    <th scope="col" class="px-6 py-3 text-left font-semibold text-gray-700 dark:text-gray-300">Granted Scopes</th>
                    <th scope="col" class="px-6 py-3 text-left font-semibold text-gray-700 dark:text-gray-300">Created</th>
                    <th scope="col" class="px-6 py-3 text-right font-semibold text-gray-700 dark:text-gray-300">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                @if (Model.Authorizations.Items.Count > 0)
                {
                    @foreach (var a in Model.Authorizations.Items)
                    {
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                            <td class="px-6 py-4 font-mono text-xs text-gray-700 dark:text-gray-300">@a.Id[..Math.Min(12, a.Id.Length)]...</td>
                            <td class="px-6 py-4 text-xs font-medium text-blue-600 dark:text-blue-400">
                                @if (!string.IsNullOrEmpty(a.Subject))
                                {
                                    var display = Model.Usernames.TryGetValue(a.Subject, out var uName) ? uName : a.Subject;
                                    <a href="/admin/p/@Model.ProjectKey/users/detail?id=@a.Subject" class="hover:underline">
                                        @display
                                    </a>
                                }
                                else
                                {
                                    <span class="text-gray-400">-</span>
                                }
                            </td>
                            <td class="px-6 py-4">
                                @if (a.Status == "valid")
                                {
                                    <a2-badge variant="success">Valid</a2-badge>
                                }
                                else
                                {
                                    <a2-badge variant="neutral">@a.Status</a2-badge>
                                }
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex flex-wrap gap-1">
                                    @foreach (var s in a.Scopes)
                                    {
                                        <span class="text-xs font-mono bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-200 px-1.5 py-0.5 rounded">@s</span>
                                    }
                                </div>
                            </td>
                            <td class="px-6 py-4 text-xs text-gray-500 dark:text-gray-400">@(a.CreatedAtUtc?.ToString("g") ?? "-")</td>
                            <td class="px-6 py-4 text-right">
                                @if (a.Status == "valid")
                                {
                                    <form method="post" asp-page-handler="Revoke" asp-route-id="@a.Id" class="inline" data-confirm="Revoke this authorization and all associated tokens?">
                                        <button type="submit" class="text-xs text-red-600 dark:text-red-400 hover:underline font-medium">Revoke</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="px-6 py-12 text-center text-gray-500 dark:text-gray-400">
                            No authorizations found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <a2-pager page="@Model.Authorizations.Page" pageSize="@Model.Authorizations.PageSize" totalCount="@Model.Authorizations.TotalCount" totalPages="@Model.Authorizations.TotalPages" />
</div>
