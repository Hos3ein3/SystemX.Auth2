@page "/admin/p/{projectKey}/settings"
@model SystemX.Auth2.Server.Pages.Admin.Settings.IndexModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = $"Settings - {Model.CurrentProject?.Name}";
}

<div class="max-w-4xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Project Configuration</h1>
            <p class="mt-1 text-sm text-gray-500">Configure registration, security policies, and defaults for @Model.CurrentProject?.Name.</p>
        </div>
        <span class="text-xs text-gray-500 font-mono">Settings Version: @Model.SettingsVersion</span>
    </div>

    <form method="post" class="space-y-6">
        <input type="hidden" name="FormVersion" value="@Model.FormVersion" />

        <!-- Localization & Branding Basic -->
        <a2-card title="General & Support">
            <div class="space-y-4">
                <a2-field label="Brand Display Name" hint="Shown on login header and consent pages.">
                    <a2-input name="InputSettings.Localization.BrandName" value="@Model.InputSettings.Localization.BrandName" placeholder="@Model.CurrentProject?.Name" />
                </a2-field>

                <div class="grid grid-cols-2 gap-4">
                    <a2-field label="Default Culture">
                        <a2-input name="InputSettings.Localization.DefaultCulture" value="@Model.InputSettings.Localization.DefaultCulture" placeholder="en" />
                    </a2-field>

                    <a2-field label="Support Contact Email">
                        <a2-input name="InputSettings.Localization.SupportEmail" type="email" value="@Model.InputSettings.Localization.SupportEmail" placeholder="support@example.com" />
                    </a2-field>
                </div>
            </div>
        </a2-card>

        <!-- Registration & Join Mode -->
        <a2-card title="Registration & Membership">
            <div class="space-y-4">
                <a2-checkbox name="InputSettings.Registration.RegistrationEnabled" checked="@Model.InputSettings.Registration.RegistrationEnabled" label="Enable self-service registration" description="Allows users to register for an account from the login page." />

                <a2-field label="Join Mode" hint="Controls how existing accounts can access this project.">
                    <select name="InputSettings.Registration.JoinMode" class="block w-full rounded-[var(--a2-radius,0.375rem)] border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 focus:outline-none focus:ring-1 focus:ring-blue-500">
                        <option value="AutoJoin" selected="@(Model.InputSettings.Registration.JoinMode == SystemX.Auth2.Server.Domain.Settings.JoinMode.AutoJoin ? "selected" : null)">AutoJoin (Users can self-join with verification)</option>
                        <option value="InviteOnly" selected="@(Model.InputSettings.Registration.JoinMode == SystemX.Auth2.Server.Domain.Settings.JoinMode.InviteOnly ? "selected" : null)">Invite Only (Admin invitation required)</option>
                        <option value="Closed" selected="@(Model.InputSettings.Registration.JoinMode == SystemX.Auth2.Server.Domain.Settings.JoinMode.Closed ? "selected" : null)">Closed (No new members permitted)</option>
                    </select>
                </a2-field>
            </div>
        </a2-card>

        <!-- Passwords & Security Policies -->
        <a2-card title="Password Complexity & Security">
            <div class="grid grid-cols-2 gap-4">
                <a2-field label="Minimum Password Length">
                    <a2-input name="InputSettings.Password.MinLength" type="number" value="@Model.InputSettings.Password.MinLength.ToString()" disabled="@(!Model.IsGlobalAdmin)" />
                </a2-field>

                <a2-field label="Maximum Failed Attempts (Lockout)">
                    <a2-input name="InputSettings.Lockout.MaxFailedAttempts" type="number" value="@Model.InputSettings.Lockout.MaxFailedAttempts.ToString()" disabled="@(!Model.IsGlobalAdmin)" />
                </a2-field>
            </div>

            <div class="pt-2">
                <a2-checkbox name="InputSettings.Password.RequireDigit" checked="@Model.InputSettings.Password.RequireDigit" label="Require numeric digit" disabled="@(!Model.IsGlobalAdmin)" />
                <a2-checkbox name="InputSettings.Password.RequireUpper" checked="@Model.InputSettings.Password.RequireUpper" label="Require uppercase letter" disabled="@(!Model.IsGlobalAdmin)" />
                <a2-checkbox name="InputSettings.Password.RequireLower" checked="@Model.InputSettings.Password.RequireLower" label="Require lowercase letter" disabled="@(!Model.IsGlobalAdmin)" />
            </div>
        </a2-card>

        <!-- Session & Token Lifetimes -->
        <a2-card title="Sessions & Token Lifetimes">
            <div class="grid grid-cols-2 gap-4">
                <a2-field label="Access Token Lifetime (Minutes)">
                    <a2-input name="InputSettings.Sessions.AccessTokenMinutes" type="number" value="@Model.InputSettings.Sessions.AccessTokenMinutes.ToString()" disabled="@(!Model.IsGlobalAdmin)" />
                </a2-field>

                <a2-field label="Refresh Token Lifetime (Days)">
                    <a2-input name="InputSettings.Sessions.RefreshTokenDays" type="number" value="@Model.InputSettings.Sessions.RefreshTokenDays.ToString()" disabled="@(!Model.IsGlobalAdmin)" />
                </a2-field>
            </div>

            <a2-checkbox name="InputSettings.Sessions.SingleActiveSession" checked="@Model.InputSettings.Sessions.SingleActiveSession" label="Enforce single active session" description="Revokes previous sessions when a user logs in from a new device." disabled="@(!Model.IsGlobalAdmin)" />
        </a2-card>

        <div class="pt-4 flex justify-end">
            <a2-button type="submit" variant="primary">
                Save Project Settings
            </a2-button>
        </div>
    </form>
</div>
