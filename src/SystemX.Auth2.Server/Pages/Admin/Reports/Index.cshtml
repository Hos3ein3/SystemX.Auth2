@page "/admin/p/{projectKey}/reports"
@model SystemX.Auth2.Server.Pages.Admin.Reports.IndexModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = $"Reports - {Model.CurrentProject?.Name}";
}

<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Security & Access Reports</h1>
            <p class="mt-1 text-sm text-gray-500">Generate and export aggregated usage and security metrics for @Model.CurrentProject?.Name.</p>
        </div>
        <form method="post" asp-page-handler="ExportCsv">
            <input type="hidden" name="reportType" value="@Model.ReportType" />
            <input type="hidden" name="days" value="@Model.Days" />
            <a2-button type="submit" variant="secondary">
                Export to CSV
            </a2-button>
        </form>
    </div>

    <!-- Report Selector & Range Filter -->
    <a2-card>
        <form method="get" class="flex flex-wrap items-end gap-4">
            <div class="w-full sm:w-auto">
                <label class="block text-xs font-semibold text-gray-600 uppercase tracking-wider mb-1">Select Report</label>
                <select name="reportType" data-autosubmit class="block w-full rounded-[var(--a2-radius,0.375rem)] border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 focus:outline-none focus:ring-1 focus:ring-blue-500">
                    <option value="logins_by_method" selected="@(Model.ReportType == "logins_by_method" ? "selected" : null)">Logins by Method</option>
                    <option value="failed_logins" selected="@(Model.ReportType == "failed_logins" ? "selected" : null)">Failed Logins & Lockouts</option>
                    <option value="registrations" selected="@(Model.ReportType == "registrations" ? "selected" : null)">Registrations & Removals</option>
                    <option value="admin_changes" selected="@(Model.ReportType == "admin_changes" ? "selected" : null)">Administrative Changes</option>
                    <option value="revocations" selected="@(Model.ReportType == "revocations" ? "selected" : null)">Session & Token Revocations</option>
                    <option value="dormant_users" selected="@(Model.ReportType == "dormant_users" ? "selected" : null)">Dormant Users (Inactive)</option>
                    <option value="missing_2fa" selected="@(Model.ReportType == "missing_2fa" ? "selected" : null)">Users without 2FA / Passkeys</option>
                </select>
            </div>

            <div class="w-full sm:w-auto">
                <label class="block text-xs font-semibold text-gray-600 uppercase tracking-wider mb-1">Time Range</label>
                <select name="days" data-autosubmit class="block w-full rounded-[var(--a2-radius,0.375rem)] border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 focus:outline-none focus:ring-1 focus:ring-blue-500">
                    <option value="7" selected="@(Model.Days == 7 ? "selected" : null)">Last 7 Days</option>
                    <option value="30" selected="@(Model.Days == 30 ? "selected" : null)">Last 30 Days</option>
                    <option value="90" selected="@(Model.Days == 90 ? "selected" : null)">Last 90 Days</option>
                    <option value="365" selected="@(Model.Days == 365 ? "selected" : null)">Last 365 Days</option>
                </select>
            </div>

            <a2-button type="submit" variant="primary">Generate Report</a2-button>
        </form>
    </a2-card>

    <!-- Report Table -->
    <div class="overflow-x-auto rounded-lg border border-gray-200 bg-white shadow-sm">
        <table class="min-w-full divide-y divide-gray-200 text-sm">
            <thead class="bg-gray-50">
                <tr>
                    <th scope="col" class="px-6 py-3 text-left font-semibold text-gray-700">Metric / Label</th>
                    <th scope="col" class="px-6 py-3 text-left font-semibold text-gray-700">Category</th>
                    <th scope="col" class="px-6 py-3 text-left font-semibold text-gray-700">Date / Timestamp</th>
                    <th scope="col" class="px-6 py-3 text-right font-semibold text-gray-700">Count / Value</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
                @if (Model.ReportData.Count > 0)
                {
                    @foreach (var row in Model.ReportData)
                    {
                        <tr class="hover:bg-gray-50">
                            <td class="px-6 py-3 font-medium text-gray-900">@row.Label</td>
                            <td class="px-6 py-3 text-gray-500 text-xs">@(row.Category ?? "-")</td>
                            <td class="px-6 py-3 text-gray-500 text-xs">@(row.Timestamp?.ToString("d") ?? "-")</td>
                            <td class="px-6 py-3 text-right font-mono font-semibold text-gray-900">@row.Count.ToString("N0")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="px-6 py-12 text-center text-gray-500">
                            No report data found for the selected time range.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
