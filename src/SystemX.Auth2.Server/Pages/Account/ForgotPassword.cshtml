@page
@model SystemX.Auth2.Server.Pages.Account.ForgotPasswordModel
@{
    Layout = "_LayoutAuth";
    ViewData["Title"] = "Forgot Password";
    ViewData["Subtitle"] = "Reset your account password";
}

@if (Model.Submitted)
{
    <a2-alert variant="success">If an account matching that identifier exists, an email or SMS has been sent with instructions to reset your password.</a2-alert>
    <div class="mt-4 text-center">
        <a2-link-button href="/Account/Login?ReturnUrl=@Model.ReturnUrl&ClientId=@Model.ClientId" variant="secondary">Back to Sign In</a2-link-button>
    </div>
}
else
{
    <form method="post" class="space-y-4">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ReturnUrl" />
        <input type="hidden" asp-for="ClientId" />

        <a2-field label="Email or Username" hint="Enter the email address or username associated with your account" required="true" for="Input_Login">
            <a2-input id="Input_Login" name="Input.Login" value="@Model.Input?.Login" placeholder="you@example.com" autocomplete="username" required="true" />
        </a2-field>

        <div>
            <a2-button type="submit" variant="primary" class="w-full">Send Reset Instructions</a2-button>
        </div>

        <div class="mt-4 text-center text-sm">
            <a href="/Account/Login?ReturnUrl=@Model.ReturnUrl&ClientId=@Model.ClientId" class="font-medium text-[var(--a2-color-primary,#2563eb)] hover:underline">Back to Sign In</a>
        </div>
    </form>
}
