@page "/admin/p/{projectKey}/roles"
@model SystemX.Auth2.Server.Pages.Admin.Roles.IndexModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = $"Roles - {Model.CurrentProject?.Name}";
}

<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Roles</h1>
            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Manage access roles and their permission assignments in @Model.CurrentProject?.Name.</p>
        </div>
        <a2-link-button href="/admin/p/@Model.ProjectKey/roles/create" variant="primary">
            + New Role
        </a2-link-button>
    </div>

    <!-- Search Form -->
    <form method="get" class="flex items-center gap-3">
        <a2-search name="q" value="@Model.Q" placeholder="Search roles..."></a2-search>
        <a2-button type="submit" variant="secondary">Search</a2-button>
    </form>

    <div class="overflow-x-auto rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 shadow-sm">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700 text-sm">
            <thead class="bg-gray-50 dark:bg-gray-900/60">
                <tr>
                    <th scope="col" class="px-6 py-3 text-left font-semibold text-gray-700 dark:text-gray-300">Role Name</th>
                    <th scope="col" class="px-6 py-3 text-left font-semibold text-gray-700 dark:text-gray-300">Description</th>
                    <th scope="col" class="px-6 py-3 text-left font-semibold text-gray-700 dark:text-gray-300">Scope</th>
                    <th scope="col" class="px-6 py-3 text-left font-semibold text-gray-700 dark:text-gray-300">Permissions</th>
                    <th scope="col" class="px-6 py-3 text-right font-semibold text-gray-700 dark:text-gray-300">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                @if (Model.Roles.Count > 0)
                {
                    @foreach (var r in Model.Roles)
                    {
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                            <td class="px-6 py-4 font-semibold text-gray-900 dark:text-gray-100">
                                <a href="/admin/p/@Model.ProjectKey/roles/detail?name=@r.Name" class="text-blue-600 dark:text-blue-400 hover:underline">
                                    @r.Name
                                </a>
                            </td>
                            <td class="px-6 py-4 text-gray-600 dark:text-gray-400">@(r.Description ?? "-")</td>
                            <td class="px-6 py-4">
                                @if (r.IsSystem)
                                {
                                    <a2-badge variant="neutral">System</a2-badge>
                                }
                                else if (r.IsGlobal)
                                {
                                    <a2-badge variant="info">Global</a2-badge>
                                }
                                else
                                {
                                    <a2-badge variant="success">Project</a2-badge>
                                }
                            </td>
                            <td class="px-6 py-4">
                                <span class="font-mono text-xs bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-200 px-2 py-0.5 rounded">
                                    @r.Permissions.Count permissions
                                </span>
                            </td>
                            <td class="px-6 py-4 text-right space-x-2">
                                <a href="/admin/p/@Model.ProjectKey/roles/detail?name=@r.Name" class="text-blue-600 dark:text-blue-400 hover:underline text-xs font-semibold">View</a>
                                @if (!r.IsSystem)
                                {
                                    <span class="text-gray-300 dark:text-gray-600">|</span>
                                    <button type="button" data-delete-role="@r.Name" class="text-xs text-red-600 dark:text-red-400 hover:underline">Delete</button>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="px-6 py-12 text-center text-gray-500 dark:text-gray-400">
                            No roles found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <a2-pager page="@Model.PageNumber" page-size="@Model.PageSize" total-count="@Model.TotalCount" total-pages="@Model.TotalPages"></a2-pager>
    }

    <!-- Delete Role Confirmation Modal -->
    <div id="deleteRoleModal" class="hidden fixed inset-0 z-50 overflow-y-auto" aria-labelledby="deleteRoleModalTitle" role="dialog" aria-modal="true">
        <div class="fixed inset-0 bg-gray-500/75 dark:bg-gray-900/80 transition-opacity"></div>
        <div class="flex min-h-full items-center justify-center p-4 text-center sm:p-0">
            <div class="relative transform overflow-hidden rounded-lg bg-white dark:bg-gray-800 text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-lg border border-gray-200 dark:border-gray-700">
                <div class="p-6">
                    <div class="flex items-center space-x-3 mb-4">
                        <div class="flex-shrink-0 flex items-center justify-center h-10 w-10 rounded-full bg-red-100 dark:bg-red-900/30 text-red-600 dark:text-red-400">
                            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                            </svg>
                        </div>
                        <div>
                            <h3 id="deleteRoleModalTitle" class="text-lg font-bold text-gray-900 dark:text-gray-100">Delete Role</h3>
                            <p class="text-xs text-gray-500 dark:text-gray-400">This action will permanently delete the role.</p>
                        </div>
                    </div>
                    <p class="text-sm text-gray-600 dark:text-gray-300 mb-6">
                        Are you sure you want to delete role <strong id="deleteRoleModalName" class="font-semibold text-gray-900 dark:text-white"></strong>? All user and group assignments to this role will be removed.
                    </p>
                    <div class="flex justify-end gap-3">
                        <button type="button" data-role-modal-close class="px-4 py-2 text-sm font-medium text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-md hover:bg-gray-50 dark:hover:bg-gray-600">Cancel</button>
                        <form id="deleteRoleForm" method="post" asp-page-handler="Delete">
                            <input type="hidden" name="name" id="deleteRoleInputName" value="" />
                            <button type="submit" class="px-4 py-2 text-sm font-medium text-white bg-red-600 hover:bg-red-700 rounded-md">Delete Role</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
