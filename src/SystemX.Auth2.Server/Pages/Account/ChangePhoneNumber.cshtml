@page
@model SystemX.Auth2.Server.Pages.Account.ChangePhoneNumberModel
@{
    Layout = "_LayoutAuth";
    ViewData["Title"] = Loc["change_phone.title"];
    ViewData["Subtitle"] = Loc["change_phone.subtitle"];
}

@if (Model.Changed)
{
    <div class="text-center space-y-4">
        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-emerald-100 dark:bg-emerald-900/50">
            <svg class="h-6 w-6 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
        </div>
        <h2 class="text-xl font-bold text-[var(--a2-color-text,#111827)] dark:text-gray-100">@Loc["change_phone.title"]</h2>
        <p class="text-sm text-gray-600 dark:text-gray-300">
            @Loc["change_phone.success"]
        </p>
        <div class="pt-4">
            <a2-link-button href="@(Model.SafeReturnUrl() ?? "/")" variant="primary" class="w-full">
                @Loc["common.continue"]
            </a2-link-button>
        </div>
    </div>
}
else if (Model.CodeSent)
{
    <form method="post" class="space-y-4">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ReturnUrl" />
        <input type="hidden" asp-for="ClientId" />
        <input type="hidden" asp-for="Input.NewPhoneNumber" />

        <div class="text-center space-y-2 mb-4">
            <h3 class="text-base font-semibold text-gray-900 dark:text-gray-100">@Loc["change_phone.code_sent"]</h3>
            <p class="text-xs text-gray-500 dark:text-gray-400">
                @Loc["change_phone.code_sent_desc"] <span class="font-mono font-medium text-gray-800 dark:text-gray-200">@Model.Input.NewPhoneNumber</span>
            </p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <a2-alert variant="danger">
                @Model.ErrorMessage
            </a2-alert>
        }

        <a2-field label="@Loc["change_phone.verification_code"]" required="true" for="Input_Code">
            <a2-input id="Input_Code" name="Input.Code" value="@Model.Input.Code" required="true" autocomplete="one-time-code" placeholder="123456" class="text-center tracking-widest text-lg font-mono" />
        </a2-field>

        <div class="pt-2">
            <a2-button type="submit" variant="primary" class="w-full">
                @Loc["change_phone.verify_button"]
            </a2-button>
        </div>

        <div class="flex items-center justify-between mt-4 text-xs">
            <button type="submit" formaction="@Url.Page("", "SendCode", new { ReturnUrl = Model.ReturnUrl, ClientId = Model.ClientId })" class="text-[var(--a2-color-primary,#2563eb)] hover:underline font-medium bg-transparent border-0 p-0 cursor-pointer">
                Resend Code
            </button>
            <a href="@(Model.SafeReturnUrl() ?? "/")" class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200">
                @Loc["common.cancel"]
            </a>
        </div>
    </form>
}
else
{
    <form method="post" asp-page-handler="SendCode" class="space-y-4">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ReturnUrl" />
        <input type="hidden" asp-for="ClientId" />

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <a2-alert variant="danger">
                @Model.ErrorMessage
            </a2-alert>
        }

        @if (!string.IsNullOrEmpty(Model.CurrentPhoneNumber))
        {
            <div class="p-3 rounded-lg bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-sm">
                <span class="block text-xs font-medium text-gray-500 dark:text-gray-400">@Loc["change_phone.current_phone"]</span>
                <span class="font-mono font-semibold text-gray-900 dark:text-gray-100">@Model.CurrentPhoneNumber</span>
            </div>
        }

        <a2-field label="@Loc["change_phone.new_phone"]" required="true" for="Input_NewPhoneNumber" hint="Include country code (e.g. +14155552671).">
            <a2-input id="Input_NewPhoneNumber" name="Input.NewPhoneNumber" type="tel" value="@Model.Input.NewPhoneNumber" required="true" autocomplete="tel" placeholder="+14155552671" />
        </a2-field>

        @if (Model.PasswordRequired)
        {
            <a2-field label="@Loc["change_phone.password_confirm"]" required="true" for="Input_CurrentPassword" hint="Confirm your password to authorize this request.">
                <a2-password id="Input_CurrentPassword" name="Input.CurrentPassword" required="true" autocomplete="current-password" placeholder="••••••••••••" />
            </a2-field>
        }

        <div class="pt-2">
            <a2-button type="submit" variant="primary" class="w-full">
                @Loc["change_phone.send_code"]
            </a2-button>
        </div>

        <div class="mt-4 text-center text-sm">
            <a href="@(Model.SafeReturnUrl() ?? "/")" class="font-medium text-[var(--a2-color-primary,#2563eb)] hover:underline">
                @Loc["common.back"]
            </a>
        </div>
    </form>
}
