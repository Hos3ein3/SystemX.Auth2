@page "/admin/p/{projectKey}/audit"
@model SystemX.Auth2.Server.Pages.Admin.Audit.IndexModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = $"Audit Log - {Model.CurrentProject?.Name}";
}

<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Audit Events</h1>
            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Immutable record of security and administrative actions in @Model.CurrentProject?.Name.</p>
        </div>
    </div>

    <!-- Filter Form -->
    <form method="get" class="flex flex-wrap items-center gap-3">
        <a2-search name="q" value="@Model.Q" placeholder="Search actor / target..."></a2-search>
        <input type="text" name="actionFilter" value="@Model.ActionFilter" placeholder="Action (e.g. user.created)" class="w-48 max-w-full rounded-[var(--a2-radius,0.375rem)] border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-sm text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-1 focus:ring-blue-500" />
        <input type="text" name="targetType" value="@Model.TargetType" placeholder="Target Type (e.g. user)" class="w-40 max-w-full rounded-[var(--a2-radius,0.375rem)] border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-sm text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-1 focus:ring-blue-500" />
        <a2-page-size value="@Model.PageSize"></a2-page-size>
        <a2-button type="submit" variant="secondary">Filter</a2-button>
        @if (!string.IsNullOrEmpty(Model.Q) || !string.IsNullOrEmpty(Model.ActionFilter) || !string.IsNullOrEmpty(Model.TargetType))
        {
            <a href="/admin/p/@Model.ProjectKey/audit" class="text-sm text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200 underline">Clear</a>
        }
    </form>

    <div class="overflow-x-auto rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 shadow-sm">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700 text-sm">
            <thead class="bg-gray-50 dark:bg-gray-900/60">
                <tr>
                    <th scope="col" class="px-6 py-3 text-left font-semibold text-gray-700 dark:text-gray-300">Timestamp (UTC)</th>
                    <th scope="col" class="px-6 py-3 text-left font-semibold text-gray-700 dark:text-gray-300">Action</th>
                    <th scope="col" class="px-6 py-3 text-left font-semibold text-gray-700 dark:text-gray-300">Actor</th>
                    <th scope="col" class="px-6 py-3 text-left font-semibold text-gray-700 dark:text-gray-300">Target</th>
                    <th scope="col" class="px-6 py-3 text-left font-semibold text-gray-700 dark:text-gray-300">IP Address</th>
                    <th scope="col" class="px-6 py-3 text-left font-semibold text-gray-700 dark:text-gray-300">Data</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                @if (Model.Events.Items.Count > 0)
                {
                    @foreach (var e in Model.Events.Items)
                    {
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                            <td class="px-6 py-4 text-xs text-gray-500 dark:text-gray-400 font-mono">@e.OccurredAtUtc.ToString("u")</td>
                            <td class="px-6 py-4 font-mono text-xs font-semibold text-gray-900 dark:text-gray-100">@e.Action</td>
                            <td class="px-6 py-4 text-xs font-mono text-gray-600 dark:text-gray-300">
                                @if (e.ActorUserId.HasValue)
                                {
                                    var actorName = Model.Usernames.TryGetValue(e.ActorUserId.Value, out var n) ? n : e.ActorUserId.Value.ToString()[..8];
                                    <a href="/admin/p/@Model.ProjectKey/users/detail?id=@e.ActorUserId.Value" class="text-blue-600 dark:text-blue-400 hover:underline font-semibold" title="@e.ActorUserId.Value">
                                        @actorName
                                    </a>
                                }
                                else if (!string.IsNullOrEmpty(e.ActorClientId) && Model.ApplicationLookups.TryGetValue(e.ActorClientId, out var actorApp))
                                {
                                    <a href="/admin/p/@actorApp.ProjectKey/applications/detail?id=@actorApp.Id" class="text-blue-600 dark:text-blue-400 hover:underline font-semibold" title="Client ID: @actorApp.ClientId">
                                        @actorApp.Name
                                    </a>
                                }
                                else
                                {
                                    <span>@(e.ActorClientId ?? "system")</span>
                                }
                            </td>
                            <td class="px-6 py-4 text-xs text-gray-700 dark:text-gray-300">
                                <span class="text-gray-400 dark:text-gray-500">[@(e.TargetType ?? "-")]</span>
                                @if ((string.Equals(e.TargetType, "user", StringComparison.OrdinalIgnoreCase) || string.Equals(e.TargetType, "AppUser", StringComparison.OrdinalIgnoreCase)) && Guid.TryParse(e.TargetId, out var targetGuid))
                                {
                                    var targetName = Model.Usernames.TryGetValue(targetGuid, out var tn) ? tn : e.TargetId;
                                    <a href="/admin/p/@Model.ProjectKey/users/detail?id=@targetGuid" class="text-blue-600 dark:text-blue-400 hover:underline font-semibold font-mono" title="@e.TargetId">
                                        @targetName
                                    </a>
                                }
                                else if (!string.IsNullOrEmpty(e.TargetId) && Model.ApplicationLookups.TryGetValue(e.TargetId, out var targetApp))
                                {
                                    <a href="/admin/p/@targetApp.ProjectKey/applications/detail?id=@targetApp.Id" class="text-blue-600 dark:text-blue-400 hover:underline font-semibold font-mono" title="Client ID: @targetApp.ClientId">
                                        @targetApp.Name
                                    </a>
                                }
                                else if (string.Equals(e.TargetType, "application", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrEmpty(e.TargetId) && Model.ApplicationLookups.TryGetValue(e.TargetId.ToLowerInvariant(), out var targetApp2))
                                {
                                    <a href="/admin/p/@targetApp2.ProjectKey/applications/detail?id=@targetApp2.Id" class="text-blue-600 dark:text-blue-400 hover:underline font-semibold font-mono" title="Client ID: @targetApp2.ClientId">
                                        @targetApp2.Name
                                    </a>
                                }
                                else
                                {
                                    <span class="font-mono">@(e.TargetId ?? "-")</span>
                                }
                            </td>
                            <td class="px-6 py-4 text-xs font-mono text-gray-500 dark:text-gray-400">@(e.IpAddress ?? "-")</td>
                            <td class="px-6 py-4 text-xs font-mono text-gray-500 dark:text-gray-400 max-w-xs truncate" title="@e.DataJson">
                                @(e.DataJson ?? "-")
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="px-6 py-12 text-center text-gray-500 dark:text-gray-400">
                            No audit events found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <a2-pager page="@Model.Events.Page" pageSize="@Model.Events.PageSize" totalCount="@Model.Events.TotalCount" totalPages="@Model.Events.TotalPages" />
</div>
