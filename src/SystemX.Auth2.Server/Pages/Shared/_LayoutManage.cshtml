@using SystemX.Auth2.Contracts.Constants
@using SystemX.Auth2.Server.Domain.Entities
@using SystemX.Auth2.Server.Domain.Settings
@{
    var pageModel = Model as SystemX.Auth2.Server.Pages.Auth2PageModel;
    var currentPath = ViewContext.HttpContext.Request.Path.Value ?? "";
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLowerInvariant();
    var isGlobalAdmin = User.IsInRole("GlobalAdmin") || User.IsInRole("Developer") || User.HasClaim("scope", "auth2.admin.global");
    var isProjectAdmin = User.IsInRole("ProjectAdmin");
    var project = pageModel?.Project;
    var settings = pageModel?.Settings;
    var branding = settings?.Branding;
    var brandName = pageModel?.BrandName ?? project?.Name ?? "SystemX Auth2";

    // Assets from wwwroot/projects/{projectname}/
    var env = Context.RequestServices.GetService(typeof(Microsoft.AspNetCore.Hosting.IWebHostEnvironment)) as Microsoft.AspNetCore.Hosting.IWebHostEnvironment;
    var webRoot = env?.WebRootPath ?? "wwwroot";
    var pKey = project?.ProjectKey ?? "_global";
    var logoUrl = SystemX.Auth2.Server.Infrastructure.Branding.ProjectAssetStorage.FindAssetUrl(webRoot, pKey, "logo")
        ?? (project != null ? $"/projects/{project.ProjectKey}/logo.png" : null);
    var logoDarkUrl = SystemX.Auth2.Server.Infrastructure.Branding.ProjectAssetStorage.FindAssetUrl(webRoot, pKey, "logo-dark")
        ?? (project != null ? $"/projects/{project.ProjectKey}/logo-dark.png" : null);
    var faviconUrl = SystemX.Auth2.Server.Infrastructure.Branding.ProjectAssetStorage.FindAssetUrl(webRoot, pKey, "favicon")
        ?? (project != null ? $"/projects/{project.ProjectKey}/favicon.ico" : "/favicon.ico");

    // The pages find their session by the application of the cookie: the links carry it, so they also work when the browser holds the cookies of several projects.
    var clientId = pageModel?.ClientIdForLinks ?? pageModel?.ClientId ?? User.FindFirst(Auth2Claims.ClientId)?.Value;
    string Link(string path) => string.IsNullOrEmpty(clientId) ? path : path + "?ClientId=" + Uri.EscapeDataString(clientId);
    var adminUrl = isGlobalAdmin ? "/admin" : isProjectAdmin && project is not null ? $"/admin/p/{project.ProjectKey}" : null;

    bool IsActive(string href, bool exact = false)
    {
        var trimmedPath = currentPath.TrimEnd('/');
        var trimmedHref = href.TrimEnd('/');
        if (exact) return string.Equals(trimmedPath, trimmedHref, StringComparison.OrdinalIgnoreCase);
        return trimmedPath.Equals(trimmedHref, StringComparison.OrdinalIgnoreCase) || trimmedPath.StartsWith(trimmedHref + "/", StringComparison.OrdinalIgnoreCase);
    }

    string NavClass(string href, bool exact = false) => IsActive(href, exact)
        ? "group flex items-center px-3 py-2 text-sm font-semibold rounded-[var(--a2-radius,0.375rem)] bg-[var(--a2-color-primary,#2563eb)]/10 text-[var(--a2-color-primary,#2563eb)] border-l-4 border-[var(--a2-color-primary,#2563eb)] shadow-xs transition-colors"
        : "group flex items-center px-3 py-2 text-sm font-medium rounded-[var(--a2-radius,0.375rem)] text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700/60 transition-colors";

    string DangerClass(string href) => IsActive(href)
        ? "group flex items-center px-3 py-2 text-sm font-semibold rounded-[var(--a2-radius,0.375rem)] bg-red-50 dark:bg-red-900/30 text-red-700 dark:text-red-300 border-l-4 border-red-600"
        : "group flex items-center px-3 py-2 text-sm font-medium rounded-[var(--a2-radius,0.375rem)] text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors";
}
<!DOCTYPE html>
<html lang="@currentCulture" class="h-full bg-gray-50 dark:bg-gray-900">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/css/site.css" />
    <partial name="_Branding" model="Model" />
    <script src="/js/a2.js" asp-append-version="true" defer></script>
</head>
<body class="h-full flex flex-col md:flex-row overflow-hidden antialiased bg-gray-100 dark:bg-gray-900 text-gray-900 dark:text-gray-100">
    <!-- Left sidebar (branded layout for account self-service) -->
    <div class="hidden md:flex md:flex-shrink-0">
        <div class="flex flex-col w-64 border-r border-gray-200 dark:border-gray-700 bg-[var(--a2-color-surface,#ffffff)] dark:bg-gray-800">
            <div class="h-16 flex items-center px-6 border-b border-gray-200 dark:border-gray-700 justify-between">
                <div class="flex items-center space-x-2 overflow-hidden">
                    @if (!string.IsNullOrEmpty(logoUrl))
                    {
                        <img src="@logoUrl" alt="@brandName" class="h-8 max-h-8 w-auto max-w-[130px] object-contain dark:hidden" onerror="this.style.display='none';var s=this.parentElement.querySelector('.brand-fallback');if(s)s.style.display='block';" />
                    }
                    @if (!string.IsNullOrEmpty(logoDarkUrl))
                    {
                        <img src="@logoDarkUrl" alt="@brandName" class="h-8 max-h-8 w-auto max-w-[130px] object-contain hidden dark:block" onerror="this.style.display='none';var s=this.parentElement.querySelector('.brand-fallback');if(s)s.style.display='block';" />
                    }
                    <span class="brand-fallback text-lg font-bold text-[var(--a2-color-primary,#2563eb)] tracking-tight truncate" style="@(!string.IsNullOrEmpty(logoUrl) ? "display:none;" : "")">@brandName</span>
                </div>
                <span class="text-xs font-semibold py-0.5 px-2 rounded-[var(--a2-radius,0.375rem)] bg-[var(--a2-color-secondary,#4f46e5)]/15 text-[var(--a2-color-secondary,#4f46e5)] border border-[var(--a2-color-secondary,#4f46e5)]/30">Account</span>
            </div>

            <div class="flex-1 flex flex-col overflow-y-auto px-4 py-4 space-y-6">
                <nav class="space-y-1">
                    @if (adminUrl is not null)
                    {
                        <a href="@adminUrl" class="group flex items-center px-3 py-2 text-sm font-semibold rounded-[var(--a2-radius,0.375rem)] border border-[var(--a2-color-secondary,#4f46e5)]/30 text-[var(--a2-color-secondary,#4f46e5)] hover:bg-[var(--a2-color-secondary,#4f46e5)]/10 transition-colors mb-2">
                            <svg class="mr-3 h-5 w-5 text-[var(--a2-color-secondary,#4f46e5)]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
                            Admin Console
                        </a>
                    }
                    <div class="pt-2"><span class="px-3 text-xs font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider">My account</span></div>
                    <a href="@Link("/Manage")" class="@NavClass("/Manage", exact: true)">Overview</a>
                    <a href="@Link("/Manage/Profile")" class="@NavClass("/Manage/Profile")">Profile</a>

                    <div class="pt-2"><span class="px-3 text-xs font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider">Sign-in & security</span></div>
                    <a href="@Link("/Manage/ChangeEmail")" class="@NavClass("/Manage/ChangeEmail")">Change Email</a>
                    <a href="@Link("/Manage/ChangePassword")" class="@NavClass("/Manage/ChangePassword")">Password</a>
                    <a href="@Link("/Manage/TwoFactor/Enable")" class="@NavClass("/Manage/TwoFactor")">Two-Factor Authentication</a>
                    <a href="@Link("/Manage/Passkeys")" class="@NavClass("/Manage/Passkeys")">Passkeys</a>
                    <a href="@Link("/Manage/ExternalLogins")" class="@NavClass("/Manage/ExternalLogins")">External Logins</a>
                    <a href="@Link("/Manage/Sessions")" class="@NavClass("/Manage/Sessions")">Sessions</a>

                    <div class="pt-2"><span class="px-3 text-xs font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider">Danger zone</span></div>
                    <a href="@Link("/Manage/DeleteAccount")" class="@DangerClass("/Manage/DeleteAccount")">Delete Account</a>
                </nav>
            </div>

            <div class="p-4 border-t border-gray-200 dark:border-gray-700 space-y-2">
                <div class="flex items-center justify-between">
                    <div class="flex items-center space-x-2 overflow-hidden">
                        <a2-avatar name="@User.Identity?.Name" size="xs" />
                        <span class="text-xs font-medium text-gray-700 dark:text-gray-300 truncate max-w-[110px]" title="@User.Identity?.Name">@User.Identity?.Name</span>
                    </div>
                    <a href="/Account/Logout" class="text-xs text-red-600 dark:text-red-400 hover:underline">Sign out</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Main content area -->
    <div class="flex-1 flex flex-col overflow-hidden">
        <header class="h-16 bg-[var(--a2-color-surface,#ffffff)] dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700 flex items-center justify-between px-4 md:px-6">
            <div class="flex items-center space-x-3 overflow-hidden">
                @if (adminUrl is not null)
                {
                    <a href="@adminUrl" class="text-sm font-medium text-[var(--a2-color-primary,#2563eb)] hover:underline shrink-0">Admin Console</a>
                    <span class="text-sm text-gray-400 shrink-0">/</span>
                }
                <span class="text-sm text-gray-500 dark:text-gray-400 truncate shrink-0">@brandName</span>
                <span class="text-sm text-gray-400 shrink-0">/</span>
                <span class="text-sm font-semibold text-gray-800 dark:text-gray-200 truncate">@ViewData["Title"]</span>
            </div>
            <div class="flex items-center space-x-3 shrink-0">
                <!-- Culture Selector Dropdown Pill with 文A Icon & Chevron -->
                <div class="inline-flex items-center gap-1.5">
                    <svg class="w-4 h-4 text-gray-500 dark:text-gray-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 5h7" />
                        <path d="M9 3v2c0 4.418-2.239 8-5 8" />
                        <path d="M5 9c0 2.144 2.952 3.908 6.7 4" />
                        <path d="M12 20l4-9 4 9" />
                        <path d="M13.5 17h5" />
                    </svg>
                    <div class="relative inline-flex items-center">
                        <select aria-label="Select culture / language" data-culture-select class="appearance-none text-xs font-semibold rounded-xl border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-800 dark:text-gray-100 pl-2.5 pr-7 py-1.5 focus:ring-2 focus:ring-[var(--a2-color-primary,#2563eb)] focus:outline-none transition-colors shadow-xs cursor-pointer">
                            <!option value="en" @(currentCulture == "en" ? "selected" : "")>English (EN)</!option>
                            <!option value="fa" @(currentCulture == "fa" ? "selected" : "")>فارسی (FA)</!option>
                            <!option value="nl" @(currentCulture == "nl" ? "selected" : "")>Nederlands (NL)</!option>
                            <!option value="it" @(currentCulture == "it" ? "selected" : "")>Italiano (IT)</!option>
                            <!option value="de" @(currentCulture == "de" ? "selected" : "")>Deutsch (DE)</!option>
                            <!option value="es" @(currentCulture == "es" ? "selected" : "")>Español (ES)</!option>
                            <!option value="fr" @(currentCulture == "fr" ? "selected" : "")>Français (FR)</!option>
                        </select>
                        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-2 text-gray-500 dark:text-gray-400">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                            </svg>
                        </div>
                    </div>
                </div>

                <!-- Dark Mode Toggle Button -->
                <button type="button" data-toggle-theme aria-label="Toggle dark mode" class="p-2 text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--a2-color-primary,#2563eb)] transition-colors cursor-pointer">
                    <!-- Sun icon shown when dark -->
                    <svg class="hidden dark:block w-5 h-5 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" clip-rule="evenodd" />
                    </svg>
                    <!-- Moon icon shown when light -->
                    <svg class="block dark:hidden w-5 h-5 text-gray-500" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z" />
                    </svg>
                </button>
            </div>
        </header>

        <!-- The navigation on small screens (the sidebar is hidden there) -->
        <nav class="md:hidden flex gap-1 overflow-x-auto px-3 py-2 bg-[var(--a2-color-surface,#ffffff)] dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700 text-sm">
            <a href="@Link("/Manage")" class="shrink-0 px-3 py-1.5 rounded-[var(--a2-radius,0.375rem)] @(IsActive("/Manage", true) ? "bg-[var(--a2-color-primary,#2563eb)]/10 text-[var(--a2-color-primary,#2563eb)] font-semibold" : "text-gray-700 dark:text-gray-300")">Overview</a>
            <a href="@Link("/Manage/Profile")" class="shrink-0 px-3 py-1.5 rounded-[var(--a2-radius,0.375rem)] @(IsActive("/Manage/Profile") ? "bg-[var(--a2-color-primary,#2563eb)]/10 text-[var(--a2-color-primary,#2563eb)] font-semibold" : "text-gray-700 dark:text-gray-300")">Profile</a>
            <a href="@Link("/Manage/ChangeEmail")" class="shrink-0 px-3 py-1.5 rounded-[var(--a2-radius,0.375rem)] @(IsActive("/Manage/ChangeEmail") ? "bg-[var(--a2-color-primary,#2563eb)]/10 text-[var(--a2-color-primary,#2563eb)] font-semibold" : "text-gray-700 dark:text-gray-300")">Email</a>
            <a href="@Link("/Manage/ChangePassword")" class="shrink-0 px-3 py-1.5 rounded-[var(--a2-radius,0.375rem)] @(IsActive("/Manage/ChangePassword") ? "bg-[var(--a2-color-primary,#2563eb)]/10 text-[var(--a2-color-primary,#2563eb)] font-semibold" : "text-gray-700 dark:text-gray-300")">Password</a>
            <a href="@Link("/Manage/TwoFactor/Enable")" class="shrink-0 px-3 py-1.5 rounded-[var(--a2-radius,0.375rem)] @(IsActive("/Manage/TwoFactor") ? "bg-[var(--a2-color-primary,#2563eb)]/10 text-[var(--a2-color-primary,#2563eb)] font-semibold" : "text-gray-700 dark:text-gray-300")">2FA</a>
            <a href="@Link("/Manage/Passkeys")" class="shrink-0 px-3 py-1.5 rounded-[var(--a2-radius,0.375rem)] @(IsActive("/Manage/Passkeys") ? "bg-[var(--a2-color-primary,#2563eb)]/10 text-[var(--a2-color-primary,#2563eb)] font-semibold" : "text-gray-700 dark:text-gray-300")">Passkeys</a>
            <a href="@Link("/Manage/ExternalLogins")" class="shrink-0 px-3 py-1.5 rounded-[var(--a2-radius,0.375rem)] @(IsActive("/Manage/ExternalLogins") ? "bg-[var(--a2-color-primary,#2563eb)]/10 text-[var(--a2-color-primary,#2563eb)] font-semibold" : "text-gray-700 dark:text-gray-300")">Logins</a>
            <a href="@Link("/Manage/Sessions")" class="shrink-0 px-3 py-1.5 rounded-[var(--a2-radius,0.375rem)] @(IsActive("/Manage/Sessions") ? "bg-[var(--a2-color-primary,#2563eb)]/10 text-[var(--a2-color-primary,#2563eb)] font-semibold" : "text-gray-700 dark:text-gray-300")">Sessions</a>
            <a href="@Link("/Manage/DeleteAccount")" class="shrink-0 px-3 py-1.5 rounded-[var(--a2-radius,0.375rem)] @(IsActive("/Manage/DeleteAccount") ? "bg-red-50 dark:bg-red-900/40 text-red-600 font-semibold" : "text-red-500")">Leave</a>
        </nav>

        <main class="flex-1 overflow-y-auto p-4 md:p-8 bg-gray-100 dark:bg-gray-900">
            <div class="max-w-4xl mx-auto space-y-6">
                @if (TempData["Success"] is string success)
                {
                    <a2-alert variant="success">@success</a2-alert>
                }
                @if (TempData["Error"] is string error)
                {
                    <a2-alert variant="error">@error</a2-alert>
                }
                @if (pageModel != null && !string.IsNullOrEmpty(pageModel.ErrorMessage))
                {
                    <a2-alert variant="error">@pageModel.ErrorMessage</a2-alert>
                }
                @RenderBody()
            </div>
        </main>
    </div>

    <!-- Global Page Loader Modal Overlay with Cancel Button -->
    <div id="a2GlobalLoader" class="fixed inset-0 z-50 hidden bg-gray-900/60 backdrop-blur-xs flex items-center justify-center p-4 transition-opacity duration-200" role="status" aria-live="polite">
        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-2xl border border-gray-200 dark:border-gray-700 p-6 max-w-sm w-full text-center space-y-4">
            <div class="flex justify-center">
                <svg class="animate-spin h-10 w-10 text-[var(--a2-color-primary,#2563eb)]" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
            </div>
            <div>
                <h3 class="text-base font-bold text-gray-900 dark:text-gray-100" id="a2GlobalLoaderTitle">Processing Request...</h3>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-1" id="a2GlobalLoaderMessage">Please wait while the server completes your request.</p>
            </div>
            <div class="pt-2">
                <button type="button" id="a2GlobalLoaderCancel" class="w-full inline-flex items-center justify-center px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg text-xs font-semibold text-gray-700 dark:text-gray-200 bg-white dark:bg-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600 focus:outline-none focus:ring-2 focus:ring-offset-1 focus:ring-gray-400 transition-colors shadow-xs cursor-pointer">
                    <svg class="w-3.5 h-3.5 mr-1.5 text-gray-500 dark:text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                    Cancel Operation
                </button>
            </div>
        </div>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
