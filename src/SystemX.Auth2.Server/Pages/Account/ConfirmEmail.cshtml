@page
@model SystemX.Auth2.Server.Pages.Account.ConfirmEmailModel
@{
    Layout = "_LayoutAuth";
    ViewData["Title"] = Loc["confirm_email.title"];
}

<div class="space-y-6">
    @if (Model.Confirmed)
    {
        <div class="text-center space-y-4">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-emerald-100 dark:bg-emerald-900/50">
                <svg class="h-6 w-6 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
            </div>
            <h2 class="text-xl font-bold text-[var(--a2-color-text,#111827)] dark:text-gray-100">@Loc["confirm_email.title"]</h2>
            <p class="text-sm text-[var(--a2-color-muted,#6b7280)] dark:text-gray-400">
                @Loc["confirm_email.success"]
            </p>
            <div class="pt-4">
                <a2-link-button href="@(Model.ContinueUrl ?? "/Account/Login")" variant="primary" class="w-full">
                    @Loc["common.continue"]
                </a2-link-button>
            </div>
        </div>
    }
    else
    {
        <div class="text-center">
            <h2 class="text-xl font-bold text-[var(--a2-color-text,#111827)] dark:text-gray-100">@Loc["confirm_email.title"]</h2>
            <p class="mt-1 text-sm text-[var(--a2-color-muted,#6b7280)] dark:text-gray-400">
                Enter your email address to receive a new confirmation link.
            </p>
        </div>

        @if (Model.ResendSent)
        {
            <a2-alert variant="success">
                If an account exists with this email, a new confirmation link has been sent.
            </a2-alert>
        }

        <form method="post" asp-page-handler="Resend" class="space-y-4">
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
            <a2-field label="@Loc["register.email"]" required="true">
                <a2-input name="Input.Login" type="email" value="@Model.Input.Login" required="true" placeholder="you@example.com" autocomplete="email" />
            </a2-field>

            <a2-button type="submit" variant="primary" class="w-full">
                @Loc["common.submit"]
            </a2-button>
        </form>

        <div class="text-center">
            <a href="/Account/Login?returnUrl=@Model.ReturnUrl" class="text-sm text-[var(--a2-color-primary,#2563eb)] hover:underline">
                @Loc["common.back_to_login"]
            </a>
        </div>
    }
</div>
