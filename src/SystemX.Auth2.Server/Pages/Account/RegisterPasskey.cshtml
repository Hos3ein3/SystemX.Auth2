@page
@model SystemX.Auth2.Server.Pages.Account.RegisterPasskeyModel
@{
    Layout = "_LayoutAuth";
    ViewData["Title"] = "Register Passkey";
}

<div class="space-y-6">
    <div class="text-center">
        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 mb-3">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
            </svg>
        </div>
        <h2 class="text-xl font-bold text-gray-900 dark:text-white">Register with Passkey</h2>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Create a passwordless credential bound to this device.</p>
    </div>

    <div id="passkeyRegAlert" class="hidden">
        <a2-alert variant="error" id="passkeyRegAlertText"></a2-alert>
    </div>

    <form id="passkeyRegisterForm" method="post" class="space-y-4" novalidate>
        <input type="hidden" id="passkeyRegClientId" value="@Model.ClientIdForLinks" />
        <input type="hidden" id="passkeyRegReturnUrl" value="@Model.ReturnUrl" />

        <a2-field label="Passkey Name (e.g. My MacBook TouchID)" for="passkeyNameInput">
            <a2-input id="passkeyNameInput" name="PasskeyName" placeholder="Personal Device" />
        </a2-field>

        <div class="pt-2">
            <button type="button" id="btnPasskeySignUp" class="flex w-full items-center justify-center gap-2 rounded-md border border-transparent bg-[var(--a2-color-primary,#2563eb)] px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-colors cursor-pointer">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
                </svg>
                <span>Create Passkey</span>
            </button>
        </div>
    </form>

    <div class="pt-4 border-t border-gray-200 dark:border-gray-700 text-center">
        <a href="@Model.GetLoginUrl()" class="text-sm font-medium text-[var(--a2-color-primary,#2563eb)] hover:underline">
            Back to Sign In
        </a>
    </div>
</div>
