@page "/admin/p/{projectKey}/scopes/detail"
@model SystemX.Auth2.Server.Pages.Admin.Scopes.DetailModel
@{
    Layout = "_LayoutAdmin";
    var s = Model.Scope;
    ViewData["Title"] = $"Scope: {s?.Name}";
}

<div class="max-w-4xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <div class="flex items-center space-x-2 text-sm text-gray-500">
            <a href="/admin/p/@Model.ProjectKey/scopes" class="hover:underline">Scopes</a>
            <span>/</span>
            <span class="text-gray-900 font-medium">@s?.Name</span>
        </div>
        @if (!s?.IsGlobal == true || Model.IsGlobalAdmin)
        {
            <form method="post" asp-page-handler="Delete" data-confirm="Delete this scope?">
                <a2-button type="submit" variant="danger">Delete Scope</a2-button>
            </form>
        }
    </div>

    <!-- Scope Header -->
    <div class="bg-white rounded-lg border border-gray-200 p-6 shadow-sm">
        <div class="flex items-center justify-between mb-2">
            <div>
                <span class="font-mono text-sm text-gray-500 block mb-1">Scope Name</span>
                <h1 class="text-2xl font-bold font-mono text-gray-900">@s?.Name</h1>
            </div>
            <div>
                @if (s?.IsGlobal == true)
                {
                    <a2-badge variant="info">Global Scope</a2-badge>
                }
                else
                {
                    <a2-badge variant="success">Project Scope</a2-badge>
                }
            </div>
        </div>
        <p class="text-sm text-gray-600 mt-2">@(s?.Description ?? "No description provided.")</p>
    </div>

    <!-- Edit Scope Form -->
    <a2-card title="Scope Configuration">
        <form method="post" asp-page-handler="Update" class="space-y-4">
            <a2-field label="Display name">
                <a2-input name="Input.DisplayName" value="@Model.Input.DisplayName" />
            </a2-field>

            <a2-field label="Description">
                <a2-textarea name="Input.Description" value="@Model.Input.Description" rows="3" />
            </a2-field>

            <a2-field label="Associated Resources" hint="APIs this scope is meant for. Click &times; to delete a tag, or type and press Enter to add.">
                <div class="a2-tags-field" data-tags-input="Input_Resources">
                    <input type="hidden" id="Input_Resources" name="Input.Resources" value="@Model.Input.Resources" />
                    <div class="flex flex-wrap items-center gap-2 p-2 rounded-[var(--a2-radius,0.375rem)] border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 min-h-[44px] focus-within:ring-2 focus-within:ring-blue-500 focus-within:border-blue-500">
                        <div class="a2-tags-list flex flex-wrap gap-1.5">
                            @{
                                var resources = (Model.Input.Resources ?? "").Split([' ', ',', '\r', '\n'], StringSplitOptions.RemoveEmptyEntries);
                                foreach (var res in resources)
                                {
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-medium bg-indigo-50 text-indigo-700 dark:bg-indigo-900/50 dark:text-indigo-200 border border-indigo-200 dark:border-indigo-700" data-tag="@res">
                                        <span>@res</span>
                                        <button type="button" class="text-indigo-400 hover:text-indigo-600 dark:hover:text-indigo-100 font-bold ml-0.5 cursor-pointer" data-remove-tag aria-label="Remove @res">&times;</button>
                                    </span>
                                }
                            }
                        </div>
                        <input type="text" class="a2-tags-add-input flex-1 min-w-[140px] bg-transparent text-sm text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 border-none outline-none focus:ring-0 p-1" placeholder="Type resource and press Enter..." />
                    </div>
                </div>
            </a2-field>

            <div class="pt-4 border-t border-gray-200">
                <a2-button type="submit" variant="primary">
                    Save Changes
                </a2-button>
            </div>
        </form>
    </a2-card>
</div>
