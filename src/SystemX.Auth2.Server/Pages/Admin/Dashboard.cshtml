@page "/admin/p/{projectKey}"
@model SystemX.Auth2.Server.Pages.Admin.DashboardModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = $"Dashboard - {Model.CurrentProject?.Name}";
}

<div class="space-y-8">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">@Model.CurrentProject?.Name Dashboard</h1>
            <p class="mt-1 text-sm text-gray-500">Live operational activity and access statistics for this project.</p>
        </div>
        <div class="flex items-center space-x-2">
            @if (Model.Metrics?.JobHealth is not null && Model.IsGlobalAdmin)
            {
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium @(Model.Metrics.JobHealth.IsHealthy ? "bg-green-100 text-green-800" : "bg-red-100 text-red-800")">
                    Jobs: @(Model.Metrics.JobHealth.IsHealthy ? "Healthy" : $"{Model.Metrics.JobHealth.FailedCount} Failed")
                </span>
            }
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium @(Model.CurrentProject?.IsEnabled == true ? "bg-green-100 text-green-800" : "bg-red-100 text-red-800")">
                Status: @(Model.CurrentProject?.IsEnabled == true ? "Active" : "Disabled")
            </span>
        </div>
    </div>

    <!-- Metrics Cards (24h / Total) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-4">
        <div class="bg-white rounded-lg border border-gray-200 p-4 shadow-sm">
            <span class="text-xs font-medium text-gray-500 uppercase tracking-wider">Total Users</span>
            <div class="mt-2 text-2xl font-extrabold text-gray-900">@(Model.Metrics?.TotalUsers ?? 0)</div>
            <span class="text-xs text-gray-400 mt-1 block">Registered in project</span>
        </div>

        <div class="bg-white rounded-lg border border-gray-200 p-4 shadow-sm">
            <span class="text-xs font-medium text-gray-500 uppercase tracking-wider">Active Sessions</span>
            <div class="mt-2 text-2xl font-extrabold text-blue-600">@(Model.Metrics?.ActiveSessions ?? 0)</div>
            <span class="text-xs text-gray-400 mt-1 block">Current open sessions</span>
        </div>

        <div class="bg-white rounded-lg border border-gray-200 p-4 shadow-sm">
            <span class="text-xs font-medium text-gray-500 uppercase tracking-wider">Logins (24h)</span>
            <div class="mt-2 text-2xl font-extrabold text-green-600">@(Model.Metrics?.Logins24h ?? 0)</div>
            <span class="text-xs text-gray-400 mt-1 block">7d: @(Model.Metrics?.Logins7d ?? 0)</span>
        </div>

        <div class="bg-white rounded-lg border border-gray-200 p-4 shadow-sm">
            <span class="text-xs font-medium text-gray-500 uppercase tracking-wider">Failed Logins</span>
            <div class="mt-2 text-2xl font-extrabold text-amber-600">@(Model.Metrics?.FailedLogins24h ?? 0)</div>
            <span class="text-xs text-gray-400 mt-1 block">Last 24 hours</span>
        </div>

        <div class="bg-white rounded-lg border border-gray-200 p-4 shadow-sm">
            <span class="text-xs font-medium text-gray-500 uppercase tracking-wider">Lockouts</span>
            <div class="mt-2 text-2xl font-extrabold text-red-600">@(Model.Metrics?.Lockouts24h ?? 0)</div>
            <span class="text-xs text-gray-400 mt-1 block">Last 24 hours</span>
        </div>

        <div class="bg-white rounded-lg border border-gray-200 p-4 shadow-sm">
            <span class="text-xs font-medium text-gray-500 uppercase tracking-wider">Registrations</span>
            <div class="mt-2 text-2xl font-extrabold text-purple-600">@(Model.Metrics?.Registrations24h ?? 0)</div>
            <span class="text-xs text-gray-400 mt-1 block">Last 24 hours</span>
        </div>
    </div>

    <!-- Applications & Providers Overview -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Applications -->
        <a2-card title="Applications">
            @if (Model.Metrics?.Applications.Count > 0)
            {
                <ul class="divide-y divide-gray-200">
                    @foreach (var app in Model.Metrics.Applications)
                    {
                        <li class="py-3 flex items-center justify-between">
                            <div>
                                <a href="/admin/p/@Model.ProjectKey/applications/detail?id=@app.Id" class="text-sm font-semibold text-blue-600 hover:underline">@app.Name</a>
                                <span class="text-xs text-gray-500 font-mono block">@app.ClientId</span>
                            </div>
                            <div class="flex items-center space-x-2">
                                @if (app.IsEnabled)
                                {
                                    <a2-badge variant="success">Active</a2-badge>
                                }
                                else
                                {
                                    <a2-badge variant="neutral">Disabled</a2-badge>
                                }
                            </div>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-sm text-gray-500 py-4">No applications registered for this project.</p>
            }
            <div class="mt-4 pt-3 border-t border-gray-100 flex justify-between">
                <a href="/admin/p/@Model.ProjectKey/applications" class="text-xs text-blue-600 hover:underline">View all applications &rarr;</a>
                <a href="/admin/p/@Model.ProjectKey/applications/create" class="text-xs text-blue-600 hover:underline">+ New Application</a>
            </div>
        </a2-card>

        <!-- Providers -->
        <a2-card title="External Identity Providers">
            @if (Model.Metrics?.Providers.Count > 0)
            {
                <ul class="divide-y divide-gray-200">
                    @foreach (var prov in Model.Metrics.Providers)
                    {
                        <li class="py-3 flex items-center justify-between">
                            <div>
                                <span class="text-sm font-semibold text-gray-900">@prov.Name</span>
                                <span class="text-xs text-gray-500 block">@prov.Type</span>
                            </div>
                            @if (prov.IsEnabled)
                            {
                                <a2-badge variant="success">Active</a2-badge>
                            }
                            else
                            {
                                <a2-badge variant="neutral">Disabled</a2-badge>
                            }
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-sm text-gray-500 py-4">No external providers configured.</p>
            }
            <div class="mt-4 pt-3 border-t border-gray-100 flex justify-between">
                <a href="/admin/p/@Model.ProjectKey/providers" class="text-xs text-blue-600 hover:underline">Manage providers &rarr;</a>
                <a href="/admin/p/@Model.ProjectKey/providers/create" class="text-xs text-blue-600 hover:underline">+ Add Provider</a>
            </div>
        </a2-card>
    </div>

    <!-- Recent Audit Activity -->
    <a2-card title="Recent Audit Activity">
        @if (Model.Metrics?.RecentAuditEvents.Count > 0)
        {
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200 text-sm">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-4 py-2 text-left font-semibold text-gray-700">Time (UTC)</th>
                            <th class="px-4 py-2 text-left font-semibold text-gray-700">Action</th>
                            <th class="px-4 py-2 text-left font-semibold text-gray-700">Actor</th>
                            <th class="px-4 py-2 text-left font-semibold text-gray-700">Target</th>
                            <th class="px-4 py-2 text-left font-semibold text-gray-700">IP Address</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200">
                        @foreach (var evt in Model.Metrics.RecentAuditEvents)
                        {
                            <tr class="hover:bg-gray-50">
                                <td class="px-4 py-2 text-gray-500 text-xs">@evt.OccurredAtUtc.ToString("g")</td>
                                <td class="px-4 py-2 font-mono text-xs font-semibold text-gray-800">@evt.Action</td>
                                <td class="px-4 py-2 text-gray-600">@(evt.ActorUserId?.ToString()[..8] ?? "system")</td>
                                <td class="px-4 py-2 text-gray-600">@(evt.TargetId ?? evt.TargetType ?? "-")</td>
                                <td class="px-4 py-2 text-gray-500 font-mono text-xs">@(evt.IpAddress ?? "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="mt-4 pt-3 border-t border-gray-100">
                <a href="/admin/p/@Model.ProjectKey/audit" class="text-xs text-blue-600 hover:underline">View all audit events &rarr;</a>
            </div>
        }
        else
        {
            <p class="text-sm text-gray-500 py-4">No recent activity recorded.</p>
        }
    </a2-card>
</div>
