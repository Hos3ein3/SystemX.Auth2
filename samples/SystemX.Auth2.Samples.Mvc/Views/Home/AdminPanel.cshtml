@{
    ViewData["Title"] = "Admin Panel";
}

<div class="space-y-6 max-w-4xl mx-auto">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
        <div class="border-b pb-4 mb-4">
            <span class="inline-block bg-purple-100 text-purple-800 text-xs px-2.5 py-1 rounded font-semibold mb-2">Restricted Area</span>
            <h1 class="text-2xl font-bold text-gray-900">Admin Panel</h1>
            <p class="text-sm text-gray-500">
                Protected by <code class="font-mono bg-purple-50 text-purple-700 px-1.5 py-0.5 rounded text-xs">[Auth2Role("Admin")]</code>
            </p>
        </div>

        <div class="bg-purple-50 border border-purple-200 rounded-lg p-4 text-purple-900 text-sm">
            <p class="font-semibold mb-1">Administrative Privileges Verified</p>
            <p>You have successfully authorized into the administrator area using your <strong>Admin</strong> role grant.</p>
        </div>
    </div>
</div>
