@page "/admin/p/{projectKey}/users"
@model SystemX.Auth2.Server.Pages.Admin.Users.IndexModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = $"Users - {Model.CurrentProject?.Name}";
}

<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Users</h1>
            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Manage user identities and memberships in @Model.CurrentProject?.Name.</p>
        </div>
        <a2-link-button href="/admin/p/@Model.ProjectKey/users/create" variant="primary">
            + New User
        </a2-link-button>
    </div>

    <!-- Filter and Search Bar -->
    <form method="get" class="flex flex-wrap items-center gap-3">
        <a2-search name="q" value="@Model.Q" placeholder="Search email, username, name..."></a2-search>
        
        <select name="lockedOut" data-autosubmit class="rounded-[var(--a2-radius,0.375rem)] border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-sm text-gray-700 dark:text-gray-200 focus:outline-none focus:ring-1 focus:ring-blue-500">
            <option value="">All Statuses</option>
            <option value="false" selected="@(Model.LockedOut == false ? "selected" : null)">Active</option>
            <option value="true" selected="@(Model.LockedOut == true ? "selected" : null)">Locked Out</option>
        </select>

        <a2-page-size value="@Model.PageSize"></a2-page-size>
        <a2-button type="submit" variant="secondary">Filter</a2-button>
    </form>

    <form method="post" id="usersTableForm">
        <!-- Bulk Actions Bar -->
        <div class="bg-gray-50 dark:bg-gray-800/80 p-2.5 rounded-t-lg border border-b-0 border-gray-200 dark:border-gray-700 flex items-center justify-between">
            <div class="flex items-center space-x-2">
                <span class="text-xs text-gray-500 dark:text-gray-400 font-medium">Bulk Actions:</span>
                <button type="submit" asp-page-handler="BulkAction" name="bulkAction" value="lock" class="text-xs px-2.5 py-1 bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded hover:bg-gray-100 dark:hover:bg-gray-600 font-medium text-gray-700 dark:text-gray-200">Lock</button>
                <button type="submit" asp-page-handler="BulkAction" name="bulkAction" value="unlock" class="text-xs px-2.5 py-1 bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded hover:bg-gray-100 dark:hover:bg-gray-600 font-medium text-gray-700 dark:text-gray-200">Unlock</button>
                <button type="submit" asp-page-handler="BulkAction" name="bulkAction" value="revoke_sessions" class="text-xs px-2.5 py-1 bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded hover:bg-gray-100 dark:hover:bg-gray-600 font-medium text-amber-700 dark:text-amber-400">Revoke Sessions</button>
            </div>
            <span class="text-xs text-gray-500 dark:text-gray-400">Showing @Model.Users.Items.Count items</span>
        </div>

        <div class="overflow-x-auto rounded-b-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 shadow-sm">
            <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700 text-sm">
                <thead class="bg-gray-50 dark:bg-gray-900/60">
                    <tr>
                        <th scope="col" class="w-10 px-4 py-3 text-left">
                            <input type="checkbox" data-select-all=".user-select-cb" class="rounded border-gray-300 dark:border-gray-600 dark:bg-gray-700 text-blue-600 focus:ring-blue-500" />
                        </th>
                        <th scope="col" class="px-4 py-3 text-left font-semibold text-gray-700 dark:text-gray-300">
                            <a2-sort-header field="email" label="Email" currentSort="@Model.Sort" descending="@Model.Desc"></a2-sort-header>
                        </th>
                        <th scope="col" class="px-4 py-3 text-left font-semibold text-gray-700 dark:text-gray-300">
                            <a2-sort-header field="username" label="Username" currentSort="@Model.Sort" descending="@Model.Desc"></a2-sort-header>
                        </th>
                        <th scope="col" class="px-4 py-3 text-left font-semibold text-gray-700 dark:text-gray-300">Name</th>
                        <th scope="col" class="px-4 py-3 text-left font-semibold text-gray-700 dark:text-gray-300">Status</th>
                        <th scope="col" class="px-4 py-3 text-left font-semibold text-gray-700 dark:text-gray-300">2FA</th>
                        <th scope="col" class="px-4 py-3 text-left font-semibold text-gray-700 dark:text-gray-300">
                            <a2-sort-header field="createdAt" label="Created" currentSort="@Model.Sort" descending="@Model.Desc"></a2-sort-header>
                        </th>
                        <th scope="col" class="px-4 py-3 text-right font-semibold text-gray-700 dark:text-gray-300">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                    @if (Model.Users.Items.Count > 0)
                    {
                        @foreach (var u in Model.Users.Items)
                        {
                            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                                <td class="px-4 py-3">
                                    <input type="checkbox" name="selectedIds" value="@u.Id" class="user-select-cb rounded border-gray-300 dark:border-gray-600 dark:bg-gray-700 text-blue-600 focus:ring-blue-500" />
                                </td>
                                <td class="px-4 py-3 font-medium text-gray-900 dark:text-gray-100">
                                    <a href="/admin/p/@Model.ProjectKey/users/detail?id=@u.Id" class="text-blue-600 dark:text-blue-400 hover:underline">
                                        @(u.Email ?? "(No email)")
                                    </a>
                                </td>
                                <td class="px-4 py-3 text-gray-600 dark:text-gray-400 font-mono text-xs">@(u.UserName ?? "-")</td>
                                <td class="px-4 py-3 text-gray-700 dark:text-gray-300">@($"{u.FirstName} {u.LastName}".Trim())</td>
                                <td class="px-4 py-3">
                                    @if (u.IsLockedOut)
                                    {
                                        <a2-badge variant="danger">Locked</a2-badge>
                                    }
                                    else if (!u.IsActive)
                                    {
                                        <a2-badge variant="neutral">Disabled</a2-badge>
                                    }
                                    else
                                    {
                                        <a2-badge variant="success">Active</a2-badge>
                                    }
                                </td>
                                <td class="px-4 py-3">
                                    @if (u.TwoFactorEnabled)
                                    {
                                        <a2-badge variant="success">Enabled</a2-badge>
                                    }
                                    else
                                    {
                                        <span class="text-xs text-gray-400 dark:text-gray-500">Off</span>
                                    }
                                </td>
                                <td class="px-4 py-3 text-gray-500 dark:text-gray-400 text-xs">@u.CreatedAtUtc.ToString("d")</td>
                                <td class="px-4 py-3 text-right space-x-2">
                                    <a href="/admin/p/@Model.ProjectKey/users/detail?id=@u.Id" class="text-blue-600 dark:text-blue-400 hover:underline text-xs font-semibold">View</a>
                                    <span class="text-gray-300 dark:text-gray-600">|</span>
                                    @if (u.IsLockedOut)
                                    {
                                        <button type="submit" asp-page-handler="Unlock" asp-route-id="@u.Id" class="text-xs text-green-600 dark:text-green-400 hover:underline">Unlock</button>
                                    }
                                    else
                                    {
                                        <button type="button" data-lock-modal-open data-user-id="@u.Id" data-user-name="@(u.UserName ?? u.Email)" class="text-xs text-amber-600 dark:text-amber-400 hover:underline">Lock</button>
                                    }
                                    <span class="text-gray-300 dark:text-gray-600">|</span>
                                    <button type="submit" asp-page-handler="Remove" asp-route-id="@u.Id" data-confirm="Remove user from project?" class="text-xs text-red-600 dark:text-red-400 hover:underline">Remove</button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="px-6 py-12 text-center text-gray-500 dark:text-gray-400">
                                No users found in this project.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </form>

    <a2-pager page="@Model.Users.Page" pageSize="@Model.Users.PageSize" totalCount="@Model.Users.TotalCount" totalPages="@Model.Users.TotalPages" />
</div>

<!-- Lockout Modal with Custom DateTime Picker -->
<div id="lockModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4">
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-xl max-w-md w-full p-6 space-y-4 border border-gray-200 dark:border-gray-700">
        <h3 class="text-lg font-bold text-gray-900 dark:text-gray-100">Lock User Account</h3>
        <p class="text-sm text-gray-500 dark:text-gray-400">Lock out <span id="lockTargetName" class="font-semibold text-gray-800 dark:text-gray-200"></span> from logging in.</p>
        <form method="post" asp-page-handler="Lock">
            <input type="hidden" name="id" id="lockUserId" value="" />
            <div class="space-y-3">
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300">Lockout Duration</label>
                <div class="grid grid-cols-2 gap-2 text-xs">
                    <button type="button" data-lock-duration="30" class="px-2.5 py-1.5 border border-gray-300 dark:border-gray-600 rounded bg-gray-50 dark:bg-gray-700 hover:bg-gray-100 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-200">30 Minutes</button>
                    <button type="button" data-lock-duration="120" class="px-2.5 py-1.5 border border-gray-300 dark:border-gray-600 rounded bg-gray-50 dark:bg-gray-700 hover:bg-gray-100 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-200">2 Hours</button>
                    <button type="button" data-lock-duration="1440" class="px-2.5 py-1.5 border border-gray-300 dark:border-gray-600 rounded bg-gray-50 dark:bg-gray-700 hover:bg-gray-100 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-200">24 Hours</button>
                    <button type="button" data-lock-duration="10080" class="px-2.5 py-1.5 border border-gray-300 dark:border-gray-600 rounded bg-gray-50 dark:bg-gray-700 hover:bg-gray-100 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-200">7 Days</button>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1">Custom Date & Time (UTC/Local)</label>
                    <input type="datetime-local" id="lockUntilInput" name="untilUtc" class="block w-full rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-sm text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-1 focus:ring-blue-500" />
                    <span class="text-xs text-gray-400 dark:text-gray-500 mt-1 block">Leave blank for permanent / indefinite lockout.</span>
                </div>
            </div>
            <div class="mt-5 flex justify-end space-x-3">
                <button type="button" data-lock-modal-close class="px-4 py-2 text-sm border border-gray-300 dark:border-gray-600 rounded-md hover:bg-gray-50 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300">Cancel</button>
                <button type="submit" class="px-4 py-2 text-sm bg-amber-600 hover:bg-amber-700 text-white font-medium rounded-md">Lock User</button>
            </div>
        </form>
    </div>
</div>
