@{
    ViewData["Title"] = "Home";
    bool isAuth = ViewBag.IsAuthenticated ?? false;
    string? userName = ViewBag.UserName as string;
    var roles = ViewBag.Roles as IReadOnlyList<string> ?? [];
    var permissions = ViewBag.Permissions as IReadOnlyList<string> ?? [];
}

<div class="space-y-8">
    <div class="bg-gradient-to-r from-indigo-500 to-purple-600 rounded-2xl p-8 text-white shadow-lg">
        <h1 class="text-4xl font-extrabold tracking-tight mb-2">SystemX.Auth2 MVC Sample</h1>
        <p class="text-indigo-100 text-lg max-w-2xl">
            A comprehensive sample application demonstrating authentication, role &amp; permission authorization, step-up TOTP verification, and API controllers using the <code class="bg-white/20 px-1.5 py-0.5 rounded font-mono text-white">SystemX.Auth2.Client</code> package.
        </p>

        <div class="mt-6 flex flex-wrap gap-4 items-center">
            @if (isAuth)
            {
                <span class="bg-green-500/20 text-green-200 border border-green-400/30 px-3 py-1.5 rounded-lg text-sm font-medium">
                    Signed in as <strong>@userName</strong>
                </span>
                <a asp-controller="Home" asp-action="Dashboard" class="bg-white text-indigo-700 font-semibold px-4 py-2 rounded-lg hover:bg-gray-100 transition shadow">
                    Go to Dashboard &rarr;
                </a>
                <a asp-controller="Home" asp-action="Showcase" class="bg-white/10 text-white border border-white/30 hover:bg-white/20 font-semibold px-4 py-2 rounded-lg transition shadow">
                    Rules Showcase &rarr;
                </a>
                <a asp-controller="Home" asp-action="Inspect" class="bg-white/10 text-white border border-white/30 hover:bg-white/20 font-semibold px-4 py-2 rounded-lg transition shadow">
                    Inspect Token Claims &rarr;
                </a>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="bg-white text-indigo-700 font-semibold px-5 py-2.5 rounded-lg hover:bg-gray-100 transition shadow">
                    Sign In with Auth2 Server
                </a>
                <a asp-controller="Home" asp-action="Showcase" class="bg-white/10 text-white border border-white/30 hover:bg-white/20 font-semibold px-4 py-2 rounded-lg transition shadow">
                    View Rules Showcase &rarr;
                </a>
            }
        </div>
    </div>

    <!-- Main Navigation & API Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Core MVC Controllers Section -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
            <div class="flex items-center gap-2 mb-4">
                <span class="text-2xl">🖥️</span>
                <div>
                    <h2 class="text-xl font-bold text-gray-900">Core MVC Pages</h2>
                    <p class="text-gray-500 text-xs">Standard pages, dashboards, and inspection tools</p>
                </div>
            </div>
            <ul class="space-y-3">
                <li class="flex items-center justify-between p-3 bg-gray-50 rounded-lg border border-gray-100 hover:bg-gray-100/60 transition">
                    <div>
                        <span class="font-medium text-gray-800">Home/Index</span>
                        <span class="ml-2 text-xs bg-gray-200 text-gray-700 px-2 py-0.5 rounded font-mono">[AllowAnonymous]</span>
                        <p class="text-xs text-gray-500 mt-0.5">Public home landing page</p>
                    </div>
                    <a asp-controller="Home" asp-action="Index" class="text-indigo-600 hover:text-indigo-800 text-sm font-semibold">View</a>
                </li>
                <li class="flex items-center justify-between p-3 bg-gray-50 rounded-lg border border-gray-100 hover:bg-gray-100/60 transition">
                    <div>
                        <span class="font-medium text-gray-800">Home/Dashboard</span>
                        <span class="ml-2 text-xs bg-blue-100 text-blue-800 px-2 py-0.5 rounded font-mono">[Authorize]</span>
                        <p class="text-xs text-gray-500 mt-0.5">Authenticated user dashboard</p>
                    </div>
                    <a asp-controller="Home" asp-action="Dashboard" class="text-indigo-600 hover:text-indigo-800 text-sm font-semibold">Visit</a>
                </li>
                <li class="flex items-center justify-between p-3 bg-gray-50 rounded-lg border border-gray-100 hover:bg-gray-100/60 transition">
                    <div>
                        <span class="font-medium text-gray-800">Home/Orders</span>
                        <span class="ml-2 text-xs bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded font-mono">[Auth2Permission("orders.read")]</span>
                        <p class="text-xs text-gray-500 mt-0.5">Orders view requiring read permission</p>
                    </div>
                    <a asp-controller="Home" asp-action="Orders" class="text-indigo-600 hover:text-indigo-800 text-sm font-semibold">Visit</a>
                </li>
                <li class="flex items-center justify-between p-3 bg-gray-50 rounded-lg border border-gray-100 hover:bg-gray-100/60 transition">
                    <div>
                        <span class="font-medium text-gray-800">Home/AdminPanel</span>
                        <span class="ml-2 text-xs bg-purple-100 text-purple-800 px-2 py-0.5 rounded font-mono">[Auth2Role("Admin")]</span>
                        <p class="text-xs text-gray-500 mt-0.5">Administration panel for Admin role</p>
                    </div>
                    <a asp-controller="Home" asp-action="AdminPanel" class="text-indigo-600 hover:text-indigo-800 text-sm font-semibold">Visit</a>
                </li>
                <li class="flex items-center justify-between p-3 bg-gray-50 rounded-lg border border-gray-100 hover:bg-gray-100/60 transition">
                    <div>
                        <span class="font-medium text-gray-800">Home/Showcase</span>
                        <span class="ml-2 text-xs bg-gray-200 text-gray-700 px-2 py-0.5 rounded font-mono">[AllowAnonymous]</span>
                        <p class="text-xs text-gray-500 mt-0.5">Full authorization rules matrix and demo users table</p>
                    </div>
                    <a asp-controller="Home" asp-action="Showcase" class="text-indigo-600 hover:text-indigo-800 text-sm font-semibold">Visit</a>
                </li>
                <li class="flex items-center justify-between p-3 bg-gray-50 rounded-lg border border-gray-100 hover:bg-gray-100/60 transition">
                    <div>
                        <span class="font-medium text-gray-800">Home/Inspect</span>
                        <span class="ml-2 text-xs bg-blue-100 text-blue-800 px-2 py-0.5 rounded font-mono">[Authorize]</span>
                        <p class="text-xs text-gray-500 mt-0.5">In-code evaluation of roles, permissions, scopes &amp; token audiences</p>
                    </div>
                    <a asp-controller="Home" asp-action="Inspect" class="text-indigo-600 hover:text-indigo-800 text-sm font-semibold">Visit</a>
                </li>
                <li class="flex items-center justify-between p-3 bg-gray-50 rounded-lg border border-gray-100 hover:bg-gray-100/60 transition">
                    <div>
                        <span class="font-medium text-gray-800">Home/AfterLoginRegisterRedirect</span>
                        <span class="ml-2 text-xs bg-blue-100 text-blue-800 px-2 py-0.5 rounded font-mono">[Auth2Authorize]</span>
                        <p class="text-xs text-gray-500 mt-0.5">Post-login callback inspecting IAuth2ApiClientService.GetMeAsync</p>
                    </div>
                    <a asp-controller="Home" asp-action="AfterLoginRegisterRedirect" class="text-indigo-600 hover:text-indigo-800 text-sm font-semibold">Visit</a>
                </li>
                <li class="flex items-center justify-between p-3 bg-gray-50 rounded-lg border border-gray-100 hover:bg-gray-100/60 transition">
                    <div>
                        <span class="font-medium text-gray-800">Account/Profile</span>
                        <span class="ml-2 text-xs bg-blue-100 text-blue-800 px-2 py-0.5 rounded font-mono">[Authorize]</span>
                        <p class="text-xs text-gray-500 mt-0.5">User profile with session details and claims</p>
                    </div>
                    <a asp-controller="Account" asp-action="Profile" class="text-indigo-600 hover:text-indigo-800 text-sm font-semibold">Visit</a>
                </li>
            </ul>
        </div>

        <!-- API Controllers Section -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
            <div class="flex items-center gap-2 mb-4">
                <span class="text-2xl">⚡</span>
                <div>
                    <h2 class="text-xl font-bold text-gray-900">API Controllers</h2>
                    <p class="text-gray-500 text-xs">REST endpoints with JWT Bearer / Cookie auth and Auth2 attributes</p>
                </div>
            </div>
            <ul class="space-y-3">
                <li class="flex items-center justify-between p-3 bg-gray-50 rounded-lg border border-gray-100 hover:bg-gray-100/60 transition">
                    <div>
                        <span class="font-mono text-xs font-semibold text-gray-800">GET /api/auth/status</span>
                        <span class="ml-2 text-xs bg-gray-200 text-gray-700 px-2 py-0.5 rounded">Anonymous</span>
                        <p class="text-xs text-gray-500 mt-0.5">Client health &amp; authentication status check</p>
                    </div>
                    <a href="/api/auth/status" target="_blank" class="text-indigo-600 hover:text-indigo-800 text-sm font-semibold">Open JSON</a>
                </li>
                <li class="flex items-center justify-between p-3 bg-gray-50 rounded-lg border border-gray-100 hover:bg-gray-100/60 transition">
                    <div>
                        <span class="font-mono text-xs font-semibold text-gray-800">GET /api/auth/me</span>
                        <span class="ml-2 text-xs bg-blue-100 text-blue-800 px-2 py-0.5 rounded font-mono">[Auth2Authorize]</span>
                        <p class="text-xs text-gray-500 mt-0.5">Returns authenticated user metadata and token details</p>
                    </div>
                    <a href="/api/auth/me" target="_blank" class="text-indigo-600 hover:text-indigo-800 text-sm font-semibold">Open JSON</a>
                </li>
                <li class="flex items-center justify-between p-3 bg-gray-50 rounded-lg border border-gray-100 hover:bg-gray-100/60 transition">
                    <div>
                        <span class="font-mono text-xs font-semibold text-gray-800">GET /api/data/public</span>
                        <span class="ml-2 text-xs bg-gray-200 text-gray-700 px-2 py-0.5 rounded">Anonymous</span>
                        <p class="text-xs text-gray-500 mt-0.5">Publicly accessible sample data</p>
                    </div>
                    <a href="/api/data/public" target="_blank" class="text-indigo-600 hover:text-indigo-800 text-sm font-semibold">Open JSON</a>
                </li>
                <li class="flex items-center justify-between p-3 bg-gray-50 rounded-lg border border-gray-100 hover:bg-gray-100/60 transition">
                    <div>
                        <span class="font-mono text-xs font-semibold text-gray-800">GET /api/data/orders</span>
                        <span class="ml-2 text-xs bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded font-mono">perm: orders.read</span>
                        <p class="text-xs text-gray-500 mt-0.5">Orders data endpoint requiring orders.read</p>
                    </div>
                    <a href="/api/data/orders" target="_blank" class="text-indigo-600 hover:text-indigo-800 text-sm font-semibold">Open JSON</a>
                </li>
                <li class="flex items-center justify-between p-3 bg-gray-50 rounded-lg border border-gray-100 hover:bg-gray-100/60 transition">
                    <div>
                        <span class="font-mono text-xs font-semibold text-gray-800">GET /api/data/admin-only</span>
                        <span class="ml-2 text-xs bg-purple-100 text-purple-800 px-2 py-0.5 rounded font-mono">role: Admin</span>
                        <p class="text-xs text-gray-500 mt-0.5">Administrative endpoint restricted to Admin role</p>
                    </div>
                    <a href="/api/data/admin-only" target="_blank" class="text-indigo-600 hover:text-indigo-800 text-sm font-semibold">Open JSON</a>
                </li>
            </ul>
        </div>
    </div>

    <!-- Section Header: Rules Showcase Actions -->
    <div class="border-t border-gray-200 pt-6">
        <div class="flex items-center justify-between mb-2">
            <div>
                <h2 class="text-2xl font-bold text-gray-900">Authorization Rules &amp; Actions</h2>
                <p class="text-gray-600 text-sm">
                    Each action in <code class="font-mono bg-gray-100 px-1 rounded text-xs">HomeController</code> showcases a distinct authorization attribute or flow in the <code class="font-mono bg-gray-100 px-1 rounded text-xs">SystemX.Auth2.Client</code> package.
                </p>
            </div>
            <a asp-controller="Home" asp-action="Showcase" class="text-sm font-semibold text-indigo-600 hover:text-indigo-800 hidden sm:inline-block">
                View Full Rules Matrix &rarr;
            </a>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Step-Up Authentication & TOTP -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
            <div class="flex items-center gap-2 mb-4">
                <span class="text-2xl">🔐</span>
                <div>
                    <h3 class="text-lg font-bold text-gray-900">Step-Up Auth &amp; TOTP</h3>
                    <p class="text-gray-500 text-xs">Hosted UI step-up and direct authenticator verification</p>
                </div>
            </div>
            <ul class="space-y-3">
                <li class="flex items-center justify-between p-3 bg-gray-50 rounded-lg border border-gray-100 hover:bg-gray-100/60 transition">
                    <div class="pr-2">
                        <div class="flex items-center gap-2 flex-wrap">
                            <span class="font-medium text-gray-800 text-sm">Home/SecureArea</span>
                            <span class="text-xs bg-amber-100 text-amber-800 px-2 py-0.5 rounded font-mono">[Auth2Totp]</span>
                        </div>
                        <p class="text-xs text-gray-500 mt-0.5">Hosted UI step-up: redirects to Auth2 Server to verify authenticator code, then returns with proof in session</p>
                    </div>
                    <a asp-controller="Home" asp-action="SecureArea" class="text-indigo-600 hover:text-indigo-800 text-sm font-semibold shrink-0">Visit</a>
                </li>
                <li class="flex items-center justify-between p-3 bg-gray-50 rounded-lg border border-gray-100 hover:bg-gray-100/60 transition">
                    <div class="pr-2">
                        <div class="flex items-center gap-2 flex-wrap">
                            <span class="font-medium text-gray-800 text-sm">Home/TransferForm</span>
                            <span class="text-xs bg-amber-100 text-amber-800 px-2 py-0.5 rounded font-mono">[Auth2Totp] on POST</span>
                        </div>
                        <p class="text-xs text-gray-500 mt-0.5">Transfer form posting to <code class="font-mono text-xs">Transfer</code>: triggers step-up verification flow before executing the sensitive transfer</p>
                    </div>
                    <a asp-controller="Home" asp-action="TransferForm" class="text-indigo-600 hover:text-indigo-800 text-sm font-semibold shrink-0">Visit</a>
                </li>
                <li class="flex items-center justify-between p-3 bg-gray-50 rounded-lg border border-gray-100 hover:bg-gray-100/60 transition">
                    <div class="pr-2">
                        <div class="flex items-center gap-2 flex-wrap">
                            <span class="font-medium text-gray-800 text-sm">Home/TotpForm</span>
                            <span class="text-xs bg-amber-100 text-amber-800 px-2 py-0.5 rounded font-mono">TotpAction / Optional</span>
                        </div>
                        <p class="text-xs text-gray-500 mt-0.5">Direct form sending TOTP code to <code class="font-mono text-xs">TotpAction</code> ([Auth2Totp]) or <code class="font-mono text-xs">OptionalTotpAction</code> ([Auth2OptionalTotp])</p>
                    </div>
                    <a asp-controller="Home" asp-action="TotpForm" class="text-indigo-600 hover:text-indigo-800 text-sm font-semibold shrink-0">Visit</a>
                </li>
            </ul>
        </div>

        <!-- Permissions Rules -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
            <div class="flex items-center gap-2 mb-4">
                <span class="text-2xl">🛡️</span>
                <div>
                    <h3 class="text-lg font-bold text-gray-900">Permissions Rules</h3>
                    <p class="text-gray-500 text-xs">Single, multiple (any/all), origin constraints, and audit logging</p>
                </div>
            </div>
            <ul class="space-y-3">
                <li class="flex items-center justify-between p-3 bg-gray-50 rounded-lg border border-gray-100 hover:bg-gray-100/60 transition">
                    <div class="pr-2">
                        <div class="flex items-center gap-2 flex-wrap">
                            <span class="font-medium text-gray-800 text-sm">Home/OrdersWrite</span>
                            <span class="text-xs bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded font-mono">orders.write</span>
                        </div>
                        <p class="text-xs text-gray-500 mt-0.5">Single permission requirement: granted directly, via role, or via group</p>
                    </div>
                    <a asp-controller="Home" asp-action="OrdersWrite" class="text-indigo-600 hover:text-indigo-800 text-sm font-semibold shrink-0">Visit</a>
                </li>
                <li class="flex items-center justify-between p-3 bg-gray-50 rounded-lg border border-gray-100 hover:bg-gray-100/60 transition">
                    <div class="pr-2">
                        <div class="flex items-center gap-2 flex-wrap">
                            <span class="font-medium text-gray-800 text-sm">Home/OrdersWriteOrDelete</span>
                            <span class="text-xs bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded font-mono">write OR delete</span>
                        </div>
                        <p class="text-xs text-gray-500 mt-0.5">Multiple keys in attribute: ANY permission match is sufficient</p>
                    </div>
                    <a asp-controller="Home" asp-action="OrdersWriteOrDelete" class="text-indigo-600 hover:text-indigo-800 text-sm font-semibold shrink-0">Visit</a>
                </li>
                <li class="flex items-center justify-between p-3 bg-gray-50 rounded-lg border border-gray-100 hover:bg-gray-100/60 transition">
                    <div class="pr-2">
                        <div class="flex items-center gap-2 flex-wrap">
                            <span class="font-medium text-gray-800 text-sm">Home/OrdersFullControl</span>
                            <span class="text-xs bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded font-mono">read AND write AND delete</span>
                        </div>
                        <p class="text-xs text-gray-500 mt-0.5">ALL permissions required: first parameter set to true</p>
                    </div>
                    <a asp-controller="Home" asp-action="OrdersFullControl" class="text-indigo-600 hover:text-indigo-800 text-sm font-semibold shrink-0">Visit</a>
                </li>
                <li class="flex items-center justify-between p-3 bg-gray-50 rounded-lg border border-gray-100 hover:bg-gray-100/60 transition">
                    <div class="pr-2">
                        <div class="flex items-center gap-2 flex-wrap">
                            <span class="font-medium text-gray-800 text-sm">Home/OrdersThroughARole</span>
                            <span class="text-xs bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded font-mono">[Auth2OnlyRolePermission]</span>
                        </div>
                        <p class="text-xs text-gray-500 mt-0.5">Permission must come from a role, not a direct assignment or group grant</p>
                    </div>
                    <a asp-controller="Home" asp-action="OrdersThroughARole" class="text-indigo-600 hover:text-indigo-800 text-sm font-semibold shrink-0">Visit</a>
                </li>
                <li class="flex items-center justify-between p-3 bg-gray-50 rounded-lg border border-gray-100 hover:bg-gray-100/60 transition">
                    <div class="pr-2">
                        <div class="flex items-center gap-2 flex-wrap">
                            <span class="font-medium text-gray-800 text-sm">Home/OrdersGrantedToYou</span>
                            <span class="text-xs bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded font-mono">[Auth2OnlyUserPermission]</span>
                        </div>
                        <p class="text-xs text-gray-500 mt-0.5">Permission must be directly granted to user, not inherited from role/group</p>
                    </div>
                    <a asp-controller="Home" asp-action="OrdersGrantedToYou" class="text-indigo-600 hover:text-indigo-800 text-sm font-semibold shrink-0">Visit</a>
                </li>
                <li class="flex items-center justify-between p-3 bg-gray-50 rounded-lg border border-gray-100 hover:bg-gray-100/60 transition">
                    <div class="pr-2">
                        <div class="flex items-center gap-2 flex-wrap">
                            <span class="font-medium text-gray-800 text-sm">Home/OrdersExport</span>
                            <span class="text-xs bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded font-mono">[Auth2Audit("orders.export")]</span>
                        </div>
                        <p class="text-xs text-gray-500 mt-0.5">Audited action: every attempt (allowed or denied) is logged to IAuth2AuditSink</p>
                    </div>
                    <a asp-controller="Home" asp-action="OrdersExport" class="text-indigo-600 hover:text-indigo-800 text-sm font-semibold shrink-0">Visit</a>
                </li>
            </ul>
        </div>

        <!-- Roles & Groups Rules -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
            <div class="flex items-center gap-2 mb-4">
                <span class="text-2xl">👥</span>
                <div>
                    <h3 class="text-lg font-bold text-gray-900">Roles &amp; Groups</h3>
                    <p class="text-gray-500 text-xs">Role assignments and group membership matching</p>
                </div>
            </div>
            <ul class="space-y-3">
                <li class="flex items-center justify-between p-3 bg-gray-50 rounded-lg border border-gray-100 hover:bg-gray-100/60 transition">
                    <div class="pr-2">
                        <div class="flex items-center gap-2 flex-wrap">
                            <span class="font-medium text-gray-800 text-sm">Home/ManagersArea</span>
                            <span class="text-xs bg-purple-100 text-purple-800 px-2 py-0.5 rounded font-mono">Manager OR Admin</span>
                        </div>
                        <p class="text-xs text-gray-500 mt-0.5">Multiple roles (ANY): user has either Manager or Admin role</p>
                    </div>
                    <a asp-controller="Home" asp-action="ManagersArea" class="text-indigo-600 hover:text-indigo-800 text-sm font-semibold shrink-0">Visit</a>
                </li>
                <li class="flex items-center justify-between p-3 bg-gray-50 rounded-lg border border-gray-100 hover:bg-gray-100/60 transition">
                    <div class="pr-2">
                        <div class="flex items-center gap-2 flex-wrap">
                            <span class="font-medium text-gray-800 text-sm">Home/AdminAndManager</span>
                            <span class="text-xs bg-purple-100 text-purple-800 px-2 py-0.5 rounded font-mono">Admin AND Manager</span>
                        </div>
                        <p class="text-xs text-gray-500 mt-0.5">Multiple roles (ALL): user must hold both roles (refused for all demo users)</p>
                    </div>
                    <a asp-controller="Home" asp-action="AdminAndManager" class="text-indigo-600 hover:text-indigo-800 text-sm font-semibold shrink-0">Visit</a>
                </li>
                <li class="flex items-center justify-between p-3 bg-gray-50 rounded-lg border border-gray-100 hover:bg-gray-100/60 transition">
                    <div class="pr-2">
                        <div class="flex items-center gap-2 flex-wrap">
                            <span class="font-medium text-gray-800 text-sm">Home/FinanceTeam</span>
                            <span class="text-xs bg-teal-100 text-teal-800 px-2 py-0.5 rounded font-mono">group: finance</span>
                        </div>
                        <p class="text-xs text-gray-500 mt-0.5">Single group membership requirement: member of the finance group</p>
                    </div>
                    <a asp-controller="Home" asp-action="FinanceTeam" class="text-indigo-600 hover:text-indigo-800 text-sm font-semibold shrink-0">Visit</a>
                </li>
                <li class="flex items-center justify-between p-3 bg-gray-50 rounded-lg border border-gray-100 hover:bg-gray-100/60 transition">
                    <div class="pr-2">
                        <div class="flex items-center gap-2 flex-wrap">
                            <span class="font-medium text-gray-800 text-sm">Home/FinanceRegions</span>
                            <span class="text-xs bg-teal-100 text-teal-800 px-2 py-0.5 rounded font-mono">finance-eu OR finance-us</span>
                        </div>
                        <p class="text-xs text-gray-500 mt-0.5">Multiple groups (ANY): member of finance-eu or finance-us</p>
                    </div>
                    <a asp-controller="Home" asp-action="FinanceRegions" class="text-indigo-600 hover:text-indigo-800 text-sm font-semibold shrink-0">Visit</a>
                </li>
                <li class="flex items-center justify-between p-3 bg-gray-50 rounded-lg border border-gray-100 hover:bg-gray-100/60 transition">
                    <div class="pr-2">
                        <div class="flex items-center gap-2 flex-wrap">
