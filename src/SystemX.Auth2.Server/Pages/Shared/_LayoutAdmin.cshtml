@{
    var projectKey = ViewContext.RouteData.Values["projectKey"]?.ToString() ?? Model?.ProjectKey ?? "_global";
    var isGlobalAdmin = User.IsInRole("GlobalAdmin") || User.IsInRole("Developer") || User.HasClaim("scope", "auth2.admin.global");
}
<!DOCTYPE html>
<html lang="en" class="h-full bg-gray-50">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Auth2 Admin Console</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        :root {
            --a2-color-primary: #1e40af;
            --a2-color-primary-text: #ffffff;
            --a2-radius: 0.375rem;
        }
    </style>
</head>
<body class="h-full flex overflow-hidden antialiased bg-gray-100 text-gray-900">
    <!-- Left Sidebar -->
    <div class="hidden md:flex md:flex-shrink-0">
        <div class="flex flex-col w-64 border-r border-gray-200 bg-white">
            <div class="h-16 flex items-center px-6 border-b border-gray-200 justify-between">
                <span class="text-lg font-bold text-blue-700 tracking-tight">Auth2 Admin</span>
                <span class="text-xs bg-blue-100 text-blue-800 font-mono py-0.5 px-2 rounded">v2</span>
            </div>
            
            <div class="flex-1 flex flex-col overflow-y-auto px-4 py-4 space-y-6">
                <!-- Current Project Context -->
                <div class="bg-gray-50 rounded-lg p-3 border border-gray-200">
                    <span class="block text-xs uppercase font-semibold text-gray-500 tracking-wider">Project</span>
                    <span class="block text-sm font-bold text-gray-900 truncate">@projectKey</span>
                </div>

                <!-- Navigation -->
                <nav class="space-y-1">
                    <a href="/" class="group flex items-center px-3 py-2 text-sm font-semibold rounded-md hover:bg-blue-100 text-blue-700 bg-blue-50 mb-2 border border-blue-200">
                        <svg class="mr-3 h-5 w-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
                        Developer Dashboard
                    </a>
                    <a href="/admin/p/@projectKey" class="group flex items-center px-3 py-2 text-sm font-medium rounded-md hover:bg-gray-100 text-gray-700">
                        <svg class="mr-3 h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
                        Dashboard
                    </a>
                    <a href="/admin/p/@projectKey/users" class="group flex items-center px-3 py-2 text-sm font-medium rounded-md hover:bg-gray-100 text-gray-700">
                        <svg class="mr-3 h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                        Users
                    </a>
                    <a href="/admin/p/@projectKey/roles" class="group flex items-center px-3 py-2 text-sm font-medium rounded-md hover:bg-gray-100 text-gray-700">
                        <svg class="mr-3 h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                        Roles
                    </a>
                    <a href="/admin/p/@projectKey/permissions" class="group flex items-center px-3 py-2 text-sm font-medium rounded-md hover:bg-gray-100 text-gray-700">
                        <svg class="mr-3 h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path></svg>
                        Permissions
                    </a>
                    <a href="/admin/p/@projectKey/groups" class="group flex items-center px-3 py-2 text-sm font-medium rounded-md hover:bg-gray-100 text-gray-700">
                        <svg class="mr-3 h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                        Groups
                    </a>
                    <a href="/admin/p/@projectKey/applications" class="group flex items-center px-3 py-2 text-sm font-medium rounded-md hover:bg-gray-100 text-gray-700">
                        <svg class="mr-3 h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
                        Applications
                    </a>
                    <a href="/admin/p/@projectKey/scopes" class="group flex items-center px-3 py-2 text-sm font-medium rounded-md hover:bg-gray-100 text-gray-700">
                        <svg class="mr-3 h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path></svg>
                        Scopes
                    </a>
                    <a href="/admin/p/@projectKey/authorizations" class="group flex items-center px-3 py-2 text-sm font-medium rounded-md hover:bg-gray-100 text-gray-700">
                        <svg class="mr-3 h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path></svg>
                        Authorizations
                    </a>
                    <a href="/admin/p/@projectKey/providers" class="group flex items-center px-3 py-2 text-sm font-medium rounded-md hover:bg-gray-100 text-gray-700">
                        <svg class="mr-3 h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                        External Providers
                    </a>
                    <a href="/admin/p/@projectKey/sessions" class="group flex items-center px-3 py-2 text-sm font-medium rounded-md hover:bg-gray-100 text-gray-700">
                        <svg class="mr-3 h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        Sessions
                    </a>
                    <a href="/admin/p/@projectKey/audit" class="group flex items-center px-3 py-2 text-sm font-medium rounded-md hover:bg-gray-100 text-gray-700">
                        <svg class="mr-3 h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path></svg>
                        Audit Events
                    </a>
                    <a href="/admin/p/@projectKey/reports" class="group flex items-center px-3 py-2 text-sm font-medium rounded-md hover:bg-gray-100 text-gray-700">
                        <svg class="mr-3 h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
                        Reports
                    </a>
                    <div class="pt-2">
                        <span class="px-3 text-xs font-semibold text-gray-400 uppercase tracking-wider">Settings</span>
                        <div class="mt-1 space-y-1">
                            <a href="/admin/p/@projectKey/settings" class="group flex items-center px-3 py-1.5 text-sm font-medium rounded-md hover:bg-gray-100 text-gray-600">Configuration</a>
                            <a href="/admin/p/@projectKey/ui" class="group flex items-center px-3 py-1.5 text-sm font-medium rounded-md hover:bg-gray-100 text-gray-600">UI & Login Page</a>
                            <a href="/admin/p/@projectKey/branding" class="group flex items-center px-3 py-1.5 text-sm font-medium rounded-md hover:bg-gray-100 text-gray-600">Branding</a>
                            <a href="/admin/p/@projectKey/email-templates" class="group flex items-center px-3 py-1.5 text-sm font-medium rounded-md hover:bg-gray-100 text-gray-600">Email Templates</a>
                        </div>
                    </div>
                </nav>

                @if (isGlobalAdmin)
                {
                    <div class="pt-4 border-t border-gray-200">
                        <span class="px-3 text-xs font-semibold text-purple-600 uppercase tracking-wider">Global Admin</span>
                        <div class="mt-2 space-y-1">
                            <a href="/admin/projects" class="group flex items-center px-3 py-2 text-sm font-medium rounded-md hover:bg-purple-50 text-purple-900">Projects</a>
                            <a href="/admin/keys" class="group flex items-center px-3 py-2 text-sm font-medium rounded-md hover:bg-purple-50 text-purple-900">Signing Keys</a>
                            <a href="/admin/jobs" class="group flex items-center px-3 py-2 text-sm font-medium rounded-md hover:bg-purple-50 text-purple-900">Maintenance Jobs</a>
                            <a href="/admin/settings" class="group flex items-center px-3 py-2 text-sm font-medium rounded-md hover:bg-purple-50 text-purple-900">Global Settings</a>
                        </div>
                    </div>
                }
            </div>

            <div class="p-4 border-t border-gray-200 flex items-center justify-between">
                <span class="text-xs text-gray-500 truncate max-w-[140px]">@User.Identity?.Name</span>
                <a href="/Account/Logout" class="text-xs text-red-600 hover:underline">Sign out</a>
            </div>
        </div>
    </div>

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col overflow-hidden">
        <header class="h-16 bg-white border-b border-gray-200 flex items-center justify-between px-6">
            <div class="flex items-center space-x-4">
                @if (isGlobalAdmin)
                {
                    <a href="/admin" class="text-sm font-medium text-blue-600 hover:underline flex items-center">
                        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path></svg>
                        Switch Project
                    </a>
                }
                <span class="text-sm text-gray-400">/</span>
                <span class="text-sm font-semibold text-gray-800">@ViewData["Title"]</span>
            </div>
        </header>

        <main class="flex-1 overflow-y-auto p-6 md:p-8">
            <div class="max-w-7xl mx-auto">
                @if (TempData["Success"] is string success)
                {
                    <a2-alert variant="success">@success</a2-alert>
                }
                @if (TempData["Error"] is string error)
                {
                    <a2-alert variant="error">@error</a2-alert>
                }
                @RenderBody()
            </div>
        </main>
    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
