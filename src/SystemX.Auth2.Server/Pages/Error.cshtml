@page "/Error"
@model SystemX.Auth2.Server.Pages.ErrorModel
@{
    Layout = "_LayoutAuth";
    ViewData["Title"] = "System Error";
}

<div class="text-center space-y-5">
    <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-red-100 dark:bg-red-950/40 text-red-600 dark:text-red-400">
        <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
    </div>

    <div>
        <span class="text-xs font-semibold text-red-600 dark:text-red-400 uppercase tracking-widest">Error 500</span>
        <h2 class="mt-1 text-2xl font-bold text-gray-900 dark:text-gray-100">An Error Occurred</h2>
        <p class="mt-2 text-sm text-gray-500 dark:text-gray-400 leading-relaxed">
            An unexpected error occurred while processing your request. Our technical team has been notified.
        </p>
    </div>

    @if (!string.IsNullOrEmpty(Model.RequestId))
    {
        <div class="rounded-md bg-gray-50 dark:bg-gray-900/60 border border-gray-200 dark:border-gray-700/80 p-2.5 font-mono text-xs text-gray-600 dark:text-gray-400 select-all">
            <span class="text-gray-400 dark:text-gray-500 mr-1">Trace ID:</span>@Model.RequestId
        </div>
    }

    <div class="pt-3 flex flex-col sm:flex-row gap-3 justify-center">
        <a2-link-button href="javascript:location.reload()" variant="primary">
            Try Again
        </a2-link-button>
        <a2-link-button href="/" variant="secondary">
            Return to Home
        </a2-link-button>
    </div>
</div>
