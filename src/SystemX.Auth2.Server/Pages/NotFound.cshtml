@page "/NotFound"
@model SystemX.Auth2.Server.Pages.NotFoundModel
@{
    Layout = "_LayoutAuth";
    ViewData["Title"] = "Page Not Found";
}

<div class="text-center space-y-5">
    <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-amber-100 dark:bg-amber-900/40 text-amber-600 dark:text-amber-400">
        <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
    </div>

    <div>
        <span class="text-xs font-semibold text-amber-600 dark:text-amber-400 uppercase tracking-widest">Error 404</span>
        <h2 class="mt-1 text-2xl font-bold text-gray-900 dark:text-gray-100">Page Not Found</h2>
        <p class="mt-2 text-sm text-gray-500 dark:text-gray-400 leading-relaxed">
            The page you are looking for does not exist, has been moved, or an invalid address was provided.
        </p>
    </div>

    <div class="pt-4 flex flex-col sm:flex-row gap-3 justify-center">
        @if (Model.ProjectFound)
        {
            <a2-link-button href="@Model.GetLoginUrl()" variant="primary">
                Back to Sign In
            </a2-link-button>
        }
        <a2-link-button href="/" variant="secondary">
            Return to Home
        </a2-link-button>
    </div>
</div>
