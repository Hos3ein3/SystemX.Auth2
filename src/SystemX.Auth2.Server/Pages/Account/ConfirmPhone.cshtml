@page
@model SystemX.Auth2.Server.Pages.Account.ConfirmPhoneModel
@{
    Layout = "_LayoutAuth";
    ViewData["Title"] = Loc["confirm_phone.title"];
}

<div class="space-y-6">
    @if (Model.Confirmed)
    {
        <div class="text-center space-y-4">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-emerald-100 dark:bg-emerald-900/50">
                <svg class="h-6 w-6 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
            </div>
            <h2 class="text-xl font-bold text-[var(--a2-color-text,#111827)] dark:text-gray-100">@Loc["confirm_phone.title"]</h2>
            <p class="text-sm text-[var(--a2-color-muted,#6b7280)] dark:text-gray-400">
                @Loc["confirm_phone.success"]
            </p>
            <div class="pt-4">
                <a2-link-button href="@(Model.ContinueUrl ?? "/Account/Login")" variant="primary" class="w-full">
                    @Loc["common.continue"]
                </a2-link-button>
            </div>
        </div>
    }
    else if (Model.CodeSent)
    {
        <div class="text-center">
            <h2 class="text-xl font-bold text-[var(--a2-color-text,#111827)] dark:text-gray-100">@Loc["change_phone.code_sent"]</h2>
            <p class="mt-1 text-sm text-[var(--a2-color-muted,#6b7280)] dark:text-gray-400">
                @Loc["change_phone.code_sent_desc"] <span class="font-mono text-gray-800 dark:text-gray-200">@Model.Input.Login</span>
            </p>
        </div>

        <form method="post" class="space-y-4">
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
            <input type="hidden" name="Input.Login" value="@Model.Input.Login" />

            <a2-field label="@Loc["change_phone.verification_code"]" required="true">
                <a2-input name="Input.Code" type="text" value="@Model.Input.Code" required="true" placeholder="123456" autocomplete="one-time-code" class="text-center tracking-widest text-lg font-mono" />
            </a2-field>

            <a2-button type="submit" variant="primary" class="w-full">
                @Loc["change_phone.verify_button"]
            </a2-button>
        </form>

        <form method="post" asp-page-handler="Send" class="text-center pt-2">
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
            <input type="hidden" name="Input.Login" value="@Model.Input.Login" />
            <button type="submit" class="text-sm text-[var(--a2-color-primary,#2563eb)] hover:underline focus:outline-none bg-transparent border-0 cursor-pointer">
                Resend Code
            </button>
        </form>
    }
    else
    {
        <div class="text-center">
            <h2 class="text-xl font-bold text-[var(--a2-color-text,#111827)] dark:text-gray-100">@Loc["confirm_phone.title"]</h2>
            <p class="mt-1 text-sm text-[var(--a2-color-muted,#6b7280)] dark:text-gray-400">
                Enter your phone number to receive a verification code.
            </p>
        </div>

        <form method="post" asp-page-handler="Send" class="space-y-4">
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
            <a2-field label="@Loc["register.phone"]" required="true">
                <a2-input name="Input.Login" type="tel" value="@Model.Input.Login" required="true" placeholder="+1234567890" autocomplete="tel" />
            </a2-field>

            <a2-button type="submit" variant="primary" class="w-full">
                @Loc["change_phone.send_code"]
            </a2-button>
        </form>

        <div class="text-center">
            <a href="/Account/Login?returnUrl=@Model.ReturnUrl" class="text-sm text-[var(--a2-color-primary,#2563eb)] hover:underline">
                @Loc["common.back_to_login"]
            </a>
        </div>
    }
</div>
